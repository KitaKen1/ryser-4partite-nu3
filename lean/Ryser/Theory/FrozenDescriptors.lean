/-- A structural insertion sort exposed to the kernel across module boundaries. -/
def insertRowCode (x : ℕ) : List ℕ → List ℕ
  | [] => [x]
  | y :: ys => if x ≤ y then x :: y :: ys else y :: insertRowCode x ys

def sortRowCodes : List ℕ → List ℕ
  | [] => []
  | x :: xs => insertRowCode x (sortRowCodes xs)

def swapSameWord (xs : List ℕ) : List ℕ :=
  sortRowCodes (xs.map (fun x => 8 * (x % 8) + x / 8))

def swapOppositeWord (x : OppositeWord) : OppositeWord := ⟨x.center, x.right, x.left⟩

