def frozenTemplate (t : Fin 232) (k : Fin 7) (i : Fin 4) : ℕ :=
  if i < 2 then k.val else
    let cd := (frozenTemplateLabels[t.val]!).getD k.val (0, 0)
    if i = 2 then cd.1 else cd.2

@[simp] theorem frozenTemplate_base_zero (t : Fin 232) (k : Fin 7) :
    frozenTemplate t k 0 = k.val := rfl
@[simp] theorem frozenTemplate_base_one (t : Fin 232) (k : Fin 7) :
    frozenTemplate t k 1 = k.val := rfl

end Ryser.Theory
