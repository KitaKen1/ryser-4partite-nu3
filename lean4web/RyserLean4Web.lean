/-! ## `Ryser.Theory.DescriptorCheck` (source sha256 3fa32850c61b…) -/
section
namespace Ryser.Theory
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- All computations in this module are reduced by Lean's kernel. -/
theorem sameWords_count : sameWords.length = 298 := by rw [sameWords_eq_table]; decide
theorem oppositeWords_count : oppositeWords.length = 160 := by rw [oppositeWords_eq_table]; decide
theorem frozenSameWords_count : frozenSameWords.length = 149 := by decide
theorem frozenOppositeWords_count : frozenOppositeWords.length = 83 := by decide

private theorem sameWords_checked :
    sameWords.all (fun xs => decide (xs ∈ frozenSameWords ∨ swapSameWord xs ∈ frozenSameWords)) = true := by
  rw [sameWords_eq_table]
  have heq : sameWordTable = sameDescriptorChunk0 ++ sameDescriptorChunk1 ++ sameDescriptorChunk2 ++ sameDescriptorChunk3 ++ sameDescriptorChunk4 ++ sameDescriptorChunk5 ++ sameDescriptorChunk6 ++ sameDescriptorChunk7 ++ sameDescriptorChunk8 ++ sameDescriptorChunk9 ++ sameDescriptorChunk10 ++ sameDescriptorChunk11 ++ sameDescriptorChunk12 ++ sameDescriptorChunk13 ++ sameDescriptorChunk14 := rfl
  rw [heq]
  simp only [List.all_append, sameDescriptorChunk0_checked, sameDescriptorChunk1_checked, sameDescriptorChunk2_checked, sameDescriptorChunk3_checked, sameDescriptorChunk4_checked, sameDescriptorChunk5_checked, sameDescriptorChunk6_checked, sameDescriptorChunk7_checked, sameDescriptorChunk8_checked, sameDescriptorChunk9_checked, sameDescriptorChunk10_checked, sameDescriptorChunk11_checked, sameDescriptorChunk12_checked, sameDescriptorChunk13_checked, sameDescriptorChunk14_checked, Bool.and_self]

private theorem oppositeWords_checked :
    oppositeWords.all (fun xs => decide (xs ∈ frozenOppositeWords ∨
      swapOppositeWord xs ∈ frozenOppositeWords)) = true := by
  rw [oppositeWords_eq_table]
  have heq : oppositeWordTable = oppositeDescriptorChunk0 ++ oppositeDescriptorChunk1 ++ oppositeDescriptorChunk2 ++ oppositeDescriptorChunk3 ++ oppositeDescriptorChunk4 ++ oppositeDescriptorChunk5 ++ oppositeDescriptorChunk6 ++ oppositeDescriptorChunk7 := rfl
  rw [heq]
  simp only [List.all_append, oppositeDescriptorChunk0_checked, oppositeDescriptorChunk1_checked, oppositeDescriptorChunk2_checked, oppositeDescriptorChunk3_checked, oppositeDescriptorChunk4_checked, oppositeDescriptorChunk5_checked, oppositeDescriptorChunk6_checked, oppositeDescriptorChunk7_checked, Bool.and_self]

/-- Every weight-seven same-side descriptor is a frozen row, up to exchanging centres. -/
theorem frozenSameWords_complete (xs : List ℕ)
    (hweight : (xs.map rowWeight).sum = 7)
    (hpositive : ∀ x ∈ xs, 0 < rowWeight x)
    (hsorted : xs.Pairwise (· ≤ ·)) :
    xs ∈ frozenSameWords ∨ swapSameWord xs ∈ frozenSameWords := by
  have h := List.all_eq_true.mp sameWords_checked xs
    (sameWords_complete xs hweight hpositive hsorted)
  exact of_decide_eq_true h

/-- Every weight-seven opposite descriptor with two nonempty arms is a frozen row,
up to exchanging the two complementary parts. -/
theorem frozenOppositeWords_complete (q : ℕ) (a b : List ℕ)
    (hweight : q + a.sum + b.sum = 7)
    (ha : a ≠ []) (hb : b ≠ [])
    (hap : ∀ x ∈ a, 0 < x) (hbp : ∀ x ∈ b, 0 < x)
    (has : a.Pairwise (· ≤ ·)) (hbs : b.Pairwise (· ≤ ·)) :
    OppositeWord.mk q a b ∈ frozenOppositeWords ∨
      OppositeWord.mk q b a ∈ frozenOppositeWords := by
  have h := List.all_eq_true.mp oppositeWords_checked _
    (oppositeWords_complete q a b hweight ha hb hap hbp has hbs)
  exact of_decide_eq_true h

end Ryser.Theory
end

/-! ## `Ryser.Theory.CatalogCoverage` (source sha256 a8ae44ca8632…) -/
section
namespace Ryser.Theory
universe u

/-- Exhaustive coverage of the concrete 232 frozen seven-anchor rows. This is
coverage, not uniqueness: several producer rows represent the same isomorphism
class. All four parts share one permutation of the seven whole anchors. -/
theorem frozenTemplate_coverage (a : Fin 7 → Edge (fun _ : Fin 4 => ℕ))
    (hbase : ∀ k l, k ≠ l → a k 0 ≠ a l 0 ∧ a k 1 ≠ a l 1)
    (hshape : SevenLabelShape a) :
    ∃ (t : Fin 232) (σ : Equiv.Perm (Fin 4)) (π : Equiv.Perm (Fin 7)),
      ∀ i k l, a (π k) (σ i) = a (π l) (σ i) ↔ frozenTemplate t k i = frozenTemplate t l i := by
  rcases hshape with hs | hs | hs
  · obtain ⟨c, c', hc⟩ := hs
    obtain ⟨t, π, hp⟩ := sameShape_matches_frozen a hbase c c' hc
    exact ⟨t, labelPermutation false, π, hp⟩
  · obtain ⟨d, d', hd⟩ := hs
    have hbase' : ∀ k l, k ≠ l →
        swapAnchorLabels true a k 0 ≠ swapAnchorLabels true a l 0 ∧
        swapAnchorLabels true a k 1 ≠ swapAnchorLabels true a l 1 := by
      exact hbase
    obtain ⟨t, π, hp⟩ := sameShape_matches_frozen (swapAnchorLabels true a) hbase' d d' hd
    exact ⟨t, labelPermutation true, π, hp⟩
  · obtain ⟨c, d, hc, hl, hr⟩ := hs
    exact oppositeShape_matches_frozen a hbase c d hc hl hr

/-- A strict anchor bound computed from the exact row. It imposes no restriction
on the ambient hypergraph or on labels outside these seven anchors. -/
def frozenTemplateBounds (t : Fin 232) (i : Fin 4) : ℕ :=
  (Finset.univ.sup (fun k : Fin 7 => frozenTemplate t k i)) + 1

theorem frozenTemplate_bounded (t : Fin 232) (k : Fin 7) (i : Fin 4) :
    frozenTemplate t k i < frozenTemplateBounds t i := by
  exact Nat.lt_succ_of_le (Finset.le_sup (f := fun j : Fin 7 => frozenTemplate t j i) (Finset.mem_univ k))

/-- The normalization obligation is discharged. The remaining input is the
actual unbounded-extension five-cover theorem for each of the 232 frozen rows. -/
theorem frozenCatalog_natStrongP2
    (certificates : ∀ (t : Fin 232) (H : Finset (Edge (fun _ : Fin 4 => ℕ))),
      MatchingAtMost H 2 → (∀ k, frozenTemplate t k ∈ H) → CoverAtMost H 5) : NatStrongP2 :=
  natStrongP2_of_shape_catalog frozenTemplate frozenTemplateBounds
    frozenTemplate_bounded frozenTemplate_coverage certificates

/-- Conditional final assembly. It is not the unconditional Ryser theorem until
all the row cover certificates have been supplied. -/
theorem frozenCatalog_ryserThroughThree
    (certificates : ∀ (t : Fin 232) (H : Finset (Edge (fun _ : Fin 4 => ℕ))),
      MatchingAtMost H 2 → (∀ k, frozenTemplate t k ∈ H) → CoverAtMost H 5) : RyserThroughThree.{u} :=
  natStrongP2_implies_ryserThroughThree (frozenCatalog_natStrongP2 certificates)

end Ryser.Theory
end

/-! ## `Ryser.CNF` (source sha256 1ba60d95fa2c…) -/
section
namespace Ryser.CNF

structure Literal (n : ℕ) where
  var : Fin n
  positive : Bool
  deriving DecidableEq, Repr

abbrev Clause (n : ℕ) := List (Literal n)
abbrev Formula (n : ℕ) := List (Clause n)
abbrev Assignment (n : ℕ) := Fin n → Bool
abbrev Partial (n : ℕ) := Fin n → Option Bool

def Literal.Holds {n} (a : Assignment n) (l : Literal n) : Prop :=
  a l.var = l.positive

def Satisfies {n} (a : Assignment n) (formula : Formula n) : Prop :=
  ∀ c ∈ formula, ∃ l ∈ c, l.Holds a

def Extends {n} (a : Assignment n) (s : Partial n) : Prop :=
  ∀ v b, s v = some b → a v = b

def set {n} (s : Partial n) (v : Fin n) (b : Bool) : Partial n :=
  fun w => if w = v then some b else s w

def literalFalse {n} (s : Partial n) (l : Literal n) : Bool :=
  match s l.var with
  | none => false
  | some b => b != l.positive

def hasConflict {n} (formula : Formula n) (s : Partial n) : Bool :=
  formula.any (fun c => c.all (literalFalse s))

inductive Refutation (n : ℕ) where
  | leaf
  | split (var : Fin n) (yes no : Refutation n)
  deriving Repr

/-- A deliberately small, structurally recursive kernel-checkable checker. -/
def check {n} (formula : Formula n) (s : Partial n) : Refutation n → Bool
  | .leaf => hasConflict formula s
  | .split v yes no => check formula (set s v true) yes && check formula (set s v false) no

theorem literalFalse_sound {n} {a : Assignment n} {s : Partial n} {l : Literal n}
    (hext : Extends a s) (h : literalFalse s l = true) : ¬ l.Holds a := by
  unfold literalFalse at h
  cases hs : s l.var with
  | none => simp [hs] at h
  | some b =>
    have hab := hext l.var b hs
    simp only [hs, bne_iff_ne] at h
    intro holds
    exact h (hab.symm.trans holds)

theorem hasConflict_sound {n} {a : Assignment n} {s : Partial n} {formula : Formula n}
    (hext : Extends a s) (h : hasConflict formula s = true) : ¬ Satisfies a formula := by
  intro sat
  obtain ⟨c, hc, hfalse⟩ := List.any_eq_true.mp h
  obtain ⟨l, hl, holds⟩ := sat c hc
  exact literalFalse_sound hext (List.all_eq_true.mp hfalse l hl) holds

theorem extends_set {n} {a : Assignment n} {s : Partial n} (h : Extends a s)
    (v : Fin n) : Extends a (set s v (a v)) := by
  intro w b hb
  by_cases hw : w = v
  · subst w
    simpa [set] using hb
  · exact h w b (by simpa [set, hw] using hb)

theorem check_sound {n} (proof : Refutation n) {formula : Formula n}
    {s : Partial n} (accepted : check formula s proof = true) :
    ∀ a, Extends a s → ¬ Satisfies a formula := by
  induction proof generalizing s with
  | leaf =>
    intro a hext
    exact hasConflict_sound hext accepted
  | split v yes no hy hn =>
    intro a hext sat
    have parts : check formula (set s v true) yes = true ∧
        check formula (set s v false) no = true := by simpa [check] using accepted
    obtain ⟨cy, cn⟩ := parts
    cases hv : a v with
    | false => exact hn cn a (by simpa [hv] using extends_set hext v) sat
    | true => exact hy cy a (by simpa [hv] using extends_set hext v) sat

def tinyFormula : Formula 1 := [[⟨0, true⟩], [⟨0, false⟩]]
def tinyProof : Refutation 1 := .split 0 .leaf .leaf

theorem tiny_accepted : check tinyFormula (fun _ => none) tinyProof = true := by decide

theorem tiny_unsatisfiable : ∀ a, ¬ Satisfies a tinyFormula := by
  intro a
  exact check_sound tinyProof tiny_accepted a (by intro v b h; cases h)

end Ryser.CNF
end

/-! ## `Ryser.FiniteBox` (source sha256 664b5989cfe8…) -/
section
namespace Ryser.FiniteBox
abbrev NatEdge := Edge (fun _ : Fin 4 => ℕ)
abbrev Bounds := Fin 4 → ℕ
abbrev Code (b : Bounds) := Fin (b 0 + 1) × Fin (b 1 + 1) × Fin (b 2 + 1) × Fin (b 3 + 1)
variable {b : Bounds}
def coord (c : Code b) (i : Fin 4) : ℕ :=
  if i = 0 then c.1.val else if i = 1 then c.2.1.val else
    if i = 2 then c.2.2.1.val else c.2.2.2.val
def meets (c d : Code b) : Bool :=
  decide (c.1 = d.1 ∨ c.2.1 = d.2.1 ∨ c.2.2.1 = d.2.2.1 ∨ c.2.2.2 = d.2.2.2)
def hits (C : List (Fin 4 × ℕ)) (c : Code b) : Bool :=
  C.any (fun v => decide (coord c v.1 = v.2))
def pairCondition (pairs : List (Code b × Code b)) (c : Code b) : Bool :=
  pairs.all (fun p => meets c p.1 || meets c p.2)

def encode (b : Bounds) (e : NatEdge) : (Code b) :=
  (⟨min (e 0) (b 0), by omega⟩, ⟨min (e 1) (b 1), by omega⟩,
   ⟨min (e 2) (b 2), by omega⟩, ⟨min (e 3) (b 3), by omega⟩)

theorem encode_coord (e : NatEdge) (i : Fin 4) :
    coord (encode b e) i = min (e i) (b i) := by
  fin_cases i <;> rfl

theorem encode_coord_small (e : NatEdge) (i : Fin 4) (v : ℕ) (hv : v < b i) :
    coord (encode b e) i = v ↔ e i = v := by
  rw [encode_coord]
  constructor
  · intro h
    by_cases he : e i ≤ b i
    · simpa [Nat.min_eq_left he] using h
    · have hc : b i ≤ e i := Nat.le_of_lt (Nat.lt_of_not_ge he)
      rw [Nat.min_eq_right hc] at h
      exact False.elim ((Nat.ne_of_lt hv) h.symm)
  · intro h
    rw [h, Nat.min_eq_left (Nat.le_of_lt hv)]

theorem meets_iff (c d : (Code b)) : meets c d = true ↔ EdgeMeets (coord c) (coord d) := by
  simp only [meets, decide_eq_true_eq]
  constructor
  · intro h
    rcases h with h | h | h | h
    · exact ⟨0, by simpa [coord] using congrArg Fin.val h⟩
    · exact ⟨1, by simpa [coord] using congrArg Fin.val h⟩
    · exact ⟨2, by simpa [coord] using congrArg Fin.val h⟩
    · exact ⟨3, by simpa [coord] using congrArg Fin.val h⟩
  · rintro ⟨i, hi⟩
    fin_cases i
    · exact Or.inl (Fin.ext (by simpa [coord] using hi))
    · exact Or.inr (Or.inl (Fin.ext (by simpa [coord] using hi)))
    · exact Or.inr (Or.inr (Or.inl (Fin.ext (by simpa [coord] using hi))))
    · exact Or.inr (Or.inr (Or.inr (Fin.ext (by simpa [coord] using hi))))

theorem meets_false_disjoint {c d : (Code b)} (h : meets c d = false) :
    EdgeDisjoint (coord c) (coord d) := by
  apply not_edgeMeets_iff.mp
  intro he
  have ht := (meets_iff c d).mpr he
  simp [h] at ht

theorem encoded_disjoint_lifts {e f : NatEdge} (h : meets (encode b e) (encode b f) = false) :
    EdgeDisjoint e f := by
  intro i hi
  apply meets_false_disjoint h i
  simp only [encode_coord, hi]

def actualCover (C : List (Fin 4 × ℕ)) : Finset (Vertex (fun _ : Fin 4 => ℕ)) :=
  (C.map (fun v => Sigma.mk v.1 v.2)).toFinset

theorem cover_hit_lifts {C : List (Fin 4 × ℕ)}
    (bounded : ∀ v ∈ C, v.2 < b v.1) (e : NatEdge) (h : hits C (encode b e) = true) :
    ∃ i, Sigma.mk i (e i) ∈ actualCover C := by
  obtain ⟨v,hv,heq⟩ := List.any_eq_true.mp h
  have he : e v.1 = v.2 := (encode_coord_small e v.1 v.2 (bounded v hv)).mp
    (of_decide_eq_true heq)
  refine ⟨v.1, ?_⟩
  rw [he]
  exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨v,hv,rfl⟩)

theorem exists_avoiding {H : Finset NatEdge} (notCover : ¬ CoverAtMost H 5)
    {C : List (Fin 4 × ℕ)} (bounded : ∀ v ∈ C, v.2 < b v.1)
    (size : (actualCover C).card ≤ 5) : ∃ e ∈ H, hits C (encode b e) = false := by
  classical
  by_contra h
  apply notCover
  refine ⟨actualCover C,size,?_⟩
  intro e he
  apply cover_hit_lifts bounded e
  cases hh : hits C (encode b e) with
  | false => exact False.elim (h ⟨e,he,hh⟩)
  | true => rfl

def Occurs (H : Finset NatEdge) (c : (Code b)) : Prop := ∃ e ∈ H, encode b e = c

theorem negative_occurs {H : Finset NatEdge} (h3 : NoThreeMatching H) {a q c : (Code b)}
    (hab : meets a q = false) (hac : meets a c = false) (hbc : meets q c = false) :
    ¬ Occurs H a ∨ ¬ Occurs H q ∨ ¬ Occurs H c := by
  classical
  by_contra h
  simp only [not_or, not_not] at h
  obtain ⟨⟨e,he,ea⟩,⟨f,hf,fb⟩,⟨g,hg,gc⟩⟩ := h
  exact h3 e he f hf g hg
    (encoded_disjoint_lifts (b := b) (by simpa [ea,fb] using hab))
    (encoded_disjoint_lifts (b := b) (by simpa [ea,gc] using hac))
    (encoded_disjoint_lifts (b := b) (by simpa [fb,gc] using hbc))

theorem encode_meets_bounded (e : NatEdge) {a : (Code b)} (bounded : ∀ i, coord a i < b i) :
    meets (encode b e) a = true ↔ EdgeMeets e (coord a) := by
  rw [meets_iff]
  unfold EdgeMeets
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, (encode_coord_small e i _ (bounded i)).mp hi⟩
  · rintro ⟨i, hi⟩
    exact ⟨i, (encode_coord_small e i _ (bounded i)).mpr hi⟩

theorem pair_condition_real {H : Finset NatEdge} (h3 : NoThreeMatching H)
    (anchors : List (Code b)) (hF : ∀ a ∈ anchors, coord a ∈ H)
    (bounded : ∀ a ∈ anchors, ∀ i, coord a i < b i)
    (pairs : List ((Code b) × (Code b)))
    (valid : ∀ p ∈ pairs, p.1 ∈ anchors ∧ p.2 ∈ anchors ∧ meets p.1 p.2 = false)
    {e : NatEdge} (he : e ∈ H) : pairCondition pairs (encode b e) = true := by
  apply List.all_eq_true.mpr
  intro p hp
  obtain ⟨ha,hb,hab⟩ := valid p hp
  by_cases hea : meets (encode b e) p.1 = true
  · simp [hea]
  by_cases heb : meets (encode b e) p.2 = true
  · simp [heb]
  have nea : ¬ EdgeMeets e (coord p.1) := fun h => hea ((encode_meets_bounded e (bounded p.1 ha)).mpr h)
  have neb : ¬ EdgeMeets e (coord p.2) := fun h => heb ((encode_meets_bounded e (bounded p.2 hb)).mpr h)
  exact False.elim (h3 e he (coord p.1) (hF p.1 ha) (coord p.2) (hF p.2 hb)
    (not_edgeMeets_iff.mp nea) (not_edgeMeets_iff.mp neb) (meets_false_disjoint hab))

noncomputable def assignment {n : ℕ} (H : Finset NatEdge) (selected : Fin n → (Code b)) :
    CNF.Assignment n := by
  classical
  exact fun i => decide (Occurs H (selected i))

theorem positive_clause {n} {H : Finset NatEdge} {selected : Fin n → (Code b)}
    {ids : List (Fin n)} (h : ∃ i ∈ ids, Occurs H (selected i)) :
    ∃ l ∈ ids.map (fun i => (⟨i,true⟩ : CNF.Literal n)), l.Holds (assignment H selected) := by
  classical
  obtain ⟨i,hi,ho⟩ := h
  refine ⟨⟨i,true⟩,List.mem_map.mpr ⟨i,hi,rfl⟩,?_⟩
  simpa [CNF.Literal.Holds,assignment] using ho

theorem positive_geometry_sound {H : Finset NatEdge} (h3 : NoThreeMatching H)
    (notCover : ¬ CoverAtMost H 5) (anchors : List (Code b)) (hF : ∀ a ∈ anchors, coord a ∈ H)
    (bounded : ∀ a ∈ anchors, ∀ i, coord a i < b i)
    {C : List (Fin 4 × ℕ)} (Cbound : ∀ v ∈ C, v.2 < b v.1)
    (Csize : (actualCover C).card ≤ 5) (pairs : List ((Code b) × (Code b)))
    (valid : ∀ p ∈ pairs, p.1 ∈ anchors ∧ p.2 ∈ anchors ∧ meets p.1 p.2 = false)
    (targets : List (Code b))
    (geometry : ∀ c : (Code b), hits C c = false → pairCondition pairs c = true → c ∈ targets) :
    ∃ c ∈ targets, Occurs H c := by
  obtain ⟨e,he,ha⟩ := exists_avoiding notCover Cbound Csize
  exact ⟨encode b e,geometry _ ha (pair_condition_real h3 anchors hF bounded pairs valid he),e,he,rfl⟩

theorem mapped_occurs {n} {H : Finset NatEdge} {selected : Fin n → (Code b)}
    {ids : List (Fin n)} (h : ∃ c ∈ ids.map selected, Occurs H c) :
    ∃ i ∈ ids, Occurs H (selected i) := by
  obtain ⟨c,hc,ho⟩ := h
  obtain ⟨i,hi,hic⟩ := List.mem_map.mp hc
  exact ⟨i,hi,hic.symm ▸ ho⟩

theorem negative_clause {n} {H : Finset NatEdge} (h3 : NoThreeMatching H)
    {selected : Fin n → (Code b)} {i j k : Fin n}
    (hij : meets (selected i) (selected j) = false)
    (hik : meets (selected i) (selected k) = false)
    (hjk : meets (selected j) (selected k) = false) :
    ∃ l ∈ ([⟨i,false⟩,⟨j,false⟩,⟨k,false⟩] : CNF.Clause n),
      l.Holds (assignment H selected) := by
  classical
  have h := negative_occurs h3 hij hik hjk
  simpa [CNF.Literal.Holds,assignment] using h

def rememberedDisjoint (c d : (Code b)) : Bool :=
  decide (∀ i, coord c i < b i → coord c i ≠ coord d i)

def potential (anchors : List (Code b)) (c d : (Code b)) : Bool :=
  rememberedDisjoint c d && anchors.all (fun a => meets c a || meets d a)

theorem checked_row_sound (anchors row remaining : List (Code b))
    (h : row.all (fun c => remaining.all (fun d => !(potential anchors c d))) = true) :
    ∀ c ∈ row, ∀ d ∈ remaining, potential anchors c d = false := by
  intro c hc d hd
  have hh := List.all_eq_true.mp (List.all_eq_true.mp h c hc) d hd
  cases hp : potential anchors c d <;> simp_all

theorem join_checked_rows (anchors remaining left right : List (Code b))
    (hl : ∀ c ∈ left, ∀ d ∈ remaining, potential anchors c d = false)
    (hr : ∀ c ∈ right, ∀ d ∈ remaining, potential anchors c d = false) :
    ∀ c ∈ left ++ right, ∀ d ∈ remaining, potential anchors c d = false := by
  intro c hc d hd
  rcases List.mem_append.mp hc with hc | hc
  · exact hl c hc d hd
  · exact hr c hc d hd

theorem real_pair_potential {H : Finset NatEdge} (h3 : NoThreeMatching H)
    (anchors : List (Code b)) (hF : ∀ a ∈ anchors, coord a ∈ H)
    (bounded : ∀ a ∈ anchors, ∀ i, coord a i < b i)
    {e f : NatEdge} (he : e ∈ H) (hf : f ∈ H) (hef : EdgeDisjoint e f) :
    potential anchors (encode b e) (encode b f) = true := by
  simp only [potential, Bool.and_eq_true_iff]
  constructor
  · simp only [rememberedDisjoint,decide_eq_true_eq]
    intro i hi heq
    have hec := (encode_coord_small e i _ hi).mp rfl
    have hfc := (encode_coord_small f i _ hi).mp heq.symm
    exact hef i (hec.trans hfc.symm)
  · apply List.all_eq_true.mpr
    intro a ha
    by_cases hea : meets (encode b e) a = true
    · simp [hea]
    by_cases hfa : meets (encode b f) a = true
    · simp [hfa]
    have nea : ¬ EdgeMeets e (coord a) := fun h => hea ((encode_meets_bounded e (bounded a ha)).mpr h)
    have nfa : ¬ EdgeMeets f (coord a) := fun h => hfa ((encode_meets_bounded f (bounded a ha)).mpr h)
    exact False.elim (h3 e he f hf (coord a) (hF a ha) hef
      (not_edgeMeets_iff.mp nea) (not_edgeMeets_iff.mp nfa))

theorem residual_positive_sound {H : Finset NatEdge} (h3 : NoThreeMatching H)
    (notCover : ¬ CoverAtMost H 5)
    (anchors : List (Code b)) (hF : ∀ a ∈ anchors, coord a ∈ H)
    (bounded : ∀ a ∈ anchors, ∀ i, coord a i < b i)
    (S : List (Fin 4 × ℕ)) (Sbound : ∀ v ∈ S, v.2 < b v.1)
    (Ssize : (actualCover S).card ≤ 2)
    (pairs : List ((Code b) × (Code b)))
    (valid : ∀ p ∈ pairs, p.1 ∈ anchors ∧ p.2 ∈ anchors ∧ meets p.1 p.2 = false)
    (targets remaining : List (Code b))
    (classify : ∀ c : (Code b), hits S c = false → pairCondition pairs c = true →
      c ∉ targets → c ∈ remaining)
    (check : ∀ c ∈ remaining, ∀ d ∈ remaining, potential anchors c d = false) :
    ∃ c ∈ targets, Occurs H c := by
  classical
  by_contra hno
  let K := H.filter (fun e => ¬ ∃ i, Sigma.mk i (e i) ∈ actualCover S)
  have hK : Theory.Intersecting K := by
    intro e he f hf
    obtain ⟨heH,heS⟩ := Finset.mem_filter.mp he
    obtain ⟨hfH,hfS⟩ := Finset.mem_filter.mp hf
    have memR : ∀ g ∈ H, (¬ ∃ i, Sigma.mk i (g i) ∈ actualCover S) → encode b g ∈ remaining := by
      intro g hg hgS
      apply classify
      · cases hh : hits S (encode b g) with
        | false => rfl
        | true => exact False.elim (hgS (cover_hit_lifts Sbound g hh))
      · exact pair_condition_real h3 anchors hF bounded pairs valid hg
      · intro ht
        exact hno ⟨encode b g,ht,g,hg,rfl⟩
    by_contra hmeet
    have hpot := real_pair_potential h3 anchors hF bounded heH hfH (not_edgeMeets_iff.mp hmeet)
    have hchecked := check (encode b e) (memR e heH heS) (encode b f) (memR f hfH hfS)
    simp [hpot] at hchecked
  obtain ⟨C,hC,coverC⟩ := Theory.intersecting_cover_three K hK
  apply notCover
  refine ⟨actualCover S ∪ C, (Finset.card_union_le _ _).trans (by omega), ?_⟩
  intro e he
  by_cases heS : ∃ i, Sigma.mk i (e i) ∈ actualCover S
  · obtain ⟨i,hi⟩ := heS
    exact ⟨i,Finset.mem_union_left C hi⟩
  · obtain ⟨i,hi⟩ := coverC e (Finset.mem_filter.mpr ⟨he,heS⟩)
    exact ⟨i,Finset.mem_union_right (actualCover S) hi⟩


end Ryser.FiniteBox
end

/-! ## `Ryser.ResidualCoordinates` (source sha256 86236d644786…) -/
section
namespace Ryser.ResidualCoordinates
open FiniteBox

def Hits (e a : NatEdge) : Prop :=
  e 0 = a 0 ∨ e 1 = a 1 ∨ e 2 = a 2 ∨ e 3 = a 3

theorem not_two_values (x a b : ℕ) (h : a ≠ b) : x ≠ a ∨ x ≠ b := by omega
theorem disjoint_values (x y a : ℕ) (h : x ≠ y) : x ≠ a ∨ y ≠ a := by omega

theorem hits_iff (e a : NatEdge) : Hits e a ↔ EdgeMeets e a := by
  constructor
  · rintro (h | h | h | h)
    · exact ⟨0,h⟩
    · exact ⟨1,h⟩
    · exact ⟨2,h⟩
    · exact ⟨3,h⟩
  · rintro ⟨i,hi⟩
    fin_cases i <;> simp_all [Hits]

theorem one_hits_pair {H : Finset NatEdge} (h3 : NoThreeMatching H)
    {e a b : NatEdge} (he : e ∈ H) (ha : a ∈ H) (hb : b ∈ H)
    (hab : EdgeDisjoint a b) : Hits e a ∨ Hits e b := by
  classical
  by_contra hn
  simp only [not_or] at hn
  exact h3 e he a ha b hb
    (not_edgeMeets_iff.mp (fun h => hn.1 ((hits_iff e a).mpr h)))
    (not_edgeMeets_iff.mp (fun h => hn.2 ((hits_iff e b).mpr h))) hab

theorem two_hit_anchor {H : Finset NatEdge} (h3 : NoThreeMatching H)
    {e f a : NatEdge} (he : e ∈ H) (hf : f ∈ H) (ha : a ∈ H)
    (hef : EdgeDisjoint e f) : Hits e a ∨ Hits f a := by
  classical
  by_contra hn
  simp only [not_or] at hn
  exact h3 e he f hf a ha hef
    (not_edgeMeets_iff.mp (fun h => hn.1 ((hits_iff e a).mpr h)))
    (not_edgeMeets_iff.mp (fun h => hn.2 ((hits_iff f a).mpr h)))

/-- A coordinate proof that two deleted vertices leave no disjoint pair gives
an actual five-cover, using the already proved intersecting three-cover. -/
theorem cover_of_two_deleted (H : Finset NatEdge) (p q : Fin 4 × ℕ)
    (checked : ∀ e ∈ H, ∀ f ∈ H,
      e p.1 ≠ p.2 → e q.1 ≠ q.2 → f p.1 ≠ p.2 → f q.1 ≠ q.2 →
      EdgeDisjoint e f → False) : CoverAtMost H 5 := by
  classical
  let K := H.filter (fun e => e p.1 ≠ p.2 ∧ e q.1 ≠ q.2)
  have hi : Theory.Intersecting K := by
    intro e he f hf
    obtain ⟨heH,heP,heQ⟩ := Finset.mem_filter.mp he
    obtain ⟨hfH,hfP,hfQ⟩ := Finset.mem_filter.mp hf
    by_contra hn
    exact checked e heH f hfH heP heQ hfP hfQ (not_edgeMeets_iff.mp hn)
  obtain ⟨C,hC,hcov⟩ := Theory.intersecting_cover_three K hi
  let S : Finset (Vertex (fun _ : Fin 4 => ℕ)) := {⟨p.1,p.2⟩,⟨q.1,q.2⟩}
  have hS : S.card ≤ 2 := Finset.card_le_two
  refine ⟨S ∪ C, (Finset.card_union_le _ _).trans (by omega), ?_⟩
  intro e he
  by_cases hp : e p.1 = p.2
  · exact ⟨p.1,Finset.mem_union_left C (by simp [S,hp])⟩
  by_cases hq : e q.1 = q.2
  · exact ⟨q.1,Finset.mem_union_left C (by simp [S,hq])⟩
  obtain ⟨i,hi⟩ := hcov e (Finset.mem_filter.mpr ⟨he,hp,hq⟩)
  exact ⟨i,Finset.mem_union_right S hi⟩

end Ryser.ResidualCoordinates
end

/-! ## `Ryser.Fast.Box` (source sha256 4cf0cc0d66b2…) -/
section
/-!
# Bitmask encoding of a finite trace box

A `Code` is a four-part trace.  For a sentinel code `s` the box consists of the
codes `x` with `x.p ≤ s.p` in every part; the value `s.p` stands for "a vertex
outside the known labels `0, …, s.p - 1`".  Codes are numbered in mixed radix
by `idx`, and sets of codes are natural numbers used as bitmasks.  The lemma
`vmask_spec` identifies the bits of `vmask s p v` with the codes whose part `p`
equals `v`; every later check is built from these masks with `|||`, `&&&`, `^^^`,
which the kernel evaluates with GMP acceleration.
-/

set_option maxRecDepth 8192
namespace Ryser.Fast
open FiniteBox

structure Code where
  a : ℕ
  b : ℕ
  c : ℕ
  d : ℕ
  deriving DecidableEq, Repr

namespace Code

def get (x : Code) (i : Fin 4) : ℕ :=
  if i.val = 0 then x.a else if i.val = 1 then x.b else if i.val = 2 then x.c else x.d

def toEdge (x : Code) : NatEdge := fun i => x.get i

@[simp] theorem get_zero (x : Code) : x.get 0 = x.a := rfl
@[simp] theorem get_one (x : Code) : x.get 1 = x.b := rfl
@[simp] theorem get_two (x : Code) : x.get 2 = x.c := rfl
@[simp] theorem get_three (x : Code) : x.get 3 = x.d := rfl

theorem ext_get {x y : Code} (h : ∀ i, x.get i = y.get i) : x = y := by
  have h0 := h 0; have h1 := h 1; have h2 := h 2; have h3 := h 3
  simp only [get_zero, get_one, get_two, get_three] at h0 h1 h2 h3
  cases x; cases y; simp_all

end Code

/-- `x` lies in the box with sentinel `s`. -/
def InBox (s x : Code) : Prop := x.a ≤ s.a ∧ x.b ≤ s.b ∧ x.c ≤ s.c ∧ x.d ≤ s.d

def inBox (s x : Code) : Bool := x.a ≤ s.a && x.b ≤ s.b && x.c ≤ s.c && x.d ≤ s.d

theorem inBox_iff (s x : Code) : inBox s x = true ↔ InBox s x := by
  simp [inBox, InBox, and_assoc]

/-- Every coordinate of `x` is a known label (strictly below the sentinel). -/
def known (s x : Code) : Bool := x.a < s.a && x.b < s.b && x.c < s.c && x.d < s.d

def idx (s x : Code) : ℕ := ((x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c) * (s.d + 1) + x.d

def size (s : Code) : ℕ := (s.a + 1) * (s.b + 1) * (s.c + 1) * (s.d + 1)

theorem digit_lt {a A b B : ℕ} (ha : a < A) (hb : b < B) : a * B + b < A * B := by
  calc a * B + b < a * B + B := by omega
    _ = (a + 1) * B := by grind
    _ ≤ A * B := Nat.mul_le_mul_right _ ha

theorem idx_lt {s x : Code} (hx : InBox s x) : idx s x < size s := by
  obtain ⟨ha, hb, hc, hd⟩ := hx
  unfold idx size
  exact digit_lt (digit_lt (digit_lt (by omega) (by omega)) (by omega)) (by omega)

theorem mixed_unique {n P x P' x' : ℕ} (hx : x < n) (hx' : x' < n)
    (h : P * n + x = P' * n + x') : P = P' ∧ x = x' := by
  have hn : 0 < n := by omega
  have m1 : (P * n + x) % n = x := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right]; exact Nat.mod_eq_of_lt hx
  have m2 : (P' * n + x') % n = x' := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right]; exact Nat.mod_eq_of_lt hx'
  have hxx : x = x' := by rw [← m1, ← m2, h]
  subst hxx
  exact ⟨Nat.eq_of_mul_eq_mul_right hn (by omega), rfl⟩

theorem idx_injective {s x y : Code} (hx : InBox s x) (hy : InBox s y)
    (h : idx s x = idx s y) : x = y := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  obtain ⟨ya, yb, yc, yd⟩ := hy
  unfold idx at h
  obtain ⟨h1, hd⟩ := mixed_unique (by omega) (by omega) h
  obtain ⟨h2, hc⟩ := mixed_unique (by omega) (by omega) h1
  obtain ⟨ha, hb⟩ := mixed_unique (by omega) (by omega) h2
  cases x; cases y; simp_all

/-! ## Repeated blocks and layer masks -/

/-- `rep blk stride m` is the union of `blk` shifted by `j * stride` for `j < m`. -/
def rep (blk stride : ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => rep blk stride m ||| (blk <<< (m * stride))

theorem rep_spec (blk stride : ℕ) (m i : ℕ) :
    (rep blk stride m).testBit i = true ↔
      ∃ j, j < m ∧ j * stride ≤ i ∧ blk.testBit (i - j * stride) = true := by
  induction m with
  | zero => simp [rep]
  | succ m ih =>
    simp only [rep, Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_eq_true, Bool.and_eq_true,
      decide_eq_true_eq, ih]
    constructor
    · rintro (⟨j, hj, h1, h2⟩ | ⟨h1, h2⟩)
      · exact ⟨j, by omega, h1, h2⟩
      · exact ⟨m, by omega, h1, h2⟩
    · rintro ⟨j, hj, h1, h2⟩
      by_cases hjm : j < m
      · exact Or.inl ⟨j, hjm, h1, h2⟩
      · have : j = m := by omega
        subst this
        exact Or.inr ⟨h1, h2⟩

/-- Codes whose current part equals `v`, for a part with `n` values, `I` codes
inside each value block and `O` outer blocks. -/
def layer (n I O v : ℕ) : ℕ := rep (2 ^ I - 1) (n * I) O <<< (v * I)

theorem interval_unique {I k k' i : ℕ} (h1 : k * I ≤ i) (h2 : i < (k + 1) * I)
    (h1' : k' * I ≤ i) (h2' : i < (k' + 1) * I) : k = k' := by
  rw [← Nat.div_eq_of_lt_le h1 h2, ← Nat.div_eq_of_lt_le h1' h2']

theorem layer_spec {n I O P x Q v : ℕ} (hP : P < O) (hx : x < n) (hQ : Q < I) (hv : v < n) :
    (layer n I O v).testBit ((P * n + x) * I + Q) = decide (x = v) := by
  unfold layer
  rw [Nat.testBit_shiftLeft]
  by_cases hxv : x = v
  · subst hxv
    simp only [decide_true, Bool.and_eq_true, decide_eq_true_eq]
    refine ⟨?_, ?_⟩
    · have : x * I ≤ (P * n + x) * I := Nat.mul_le_mul_right _ (by omega)
      omega
    · rw [rep_spec]
      refine ⟨P, hP, ?_, ?_⟩
      · have e : (P * n + x) * I + Q - x * I = P * (n * I) + Q := by
          have : (P * n + x) * I = P * (n * I) + x * I := by grind
          omega
        rw [e]; omega
      · have e : (P * n + x) * I + Q - x * I - P * (n * I) = Q := by
          have : (P * n + x) * I = P * (n * I) + x * I := by grind
          omega
        rw [e, Nat.testBit_two_pow_sub_one]; simpa using hQ
  · simp only [hxv, decide_false, Bool.and_eq_false_iff, decide_eq_false_iff_not, Nat.not_le]
    by_cases hle : v * I ≤ (P * n + x) * I + Q
    · right
      cases hb : (rep (2 ^ I - 1) (n * I) O).testBit ((P * n + x) * I + Q - v * I) with
      | false => rfl
      | true =>
        exfalso
        obtain ⟨j, -, hj1, hj2⟩ := (rep_spec _ _ _ _).mp hb
        rw [Nat.testBit_two_pow_sub_one, decide_eq_true_eq] at hj2
        have hI : 0 < I := by omega
        -- both `j*n + v` and `P*n + x` index the same block of length I
        have k1 : (j * n + v) * I ≤ (P * n + x) * I + Q := by
          have : (j * n + v) * I = j * (n * I) + v * I := by grind
          omega
        have k2 : (P * n + x) * I + Q < (j * n + v + 1) * I := by
          have : (j * n + v + 1) * I = j * (n * I) + v * I + I := by grind
          omega
        have k3 : (P * n + x) * I ≤ (P * n + x) * I + Q := by omega
        have k4 : (P * n + x) * I + Q < (P * n + x + 1) * I := by
          have : (P * n + x + 1) * I = (P * n + x) * I + I := by grind
          omega
        have := interval_unique k1 k2 k3 k4
        exact hxv (mixed_unique hv hx this).2.symm
    · left; omega

/-- Masks of the box codes whose part 0/1/2/3 equals `v`. -/
def mask0 (s : Code) (v : ℕ) : ℕ := layer (s.a + 1) ((s.b + 1) * ((s.c + 1) * (s.d + 1))) 1 v
def mask1 (s : Code) (v : ℕ) : ℕ := layer (s.b + 1) ((s.c + 1) * (s.d + 1)) (s.a + 1) v
def mask2 (s : Code) (v : ℕ) : ℕ := layer (s.c + 1) (s.d + 1) ((s.a + 1) * (s.b + 1)) v
def mask3 (s : Code) (v : ℕ) : ℕ := layer (s.d + 1) 1 ((s.a + 1) * (s.b + 1) * (s.c + 1)) v

theorem mask0_spec {s x : Code} (hx : InBox s x) {v : ℕ} (hv : v ≤ s.a) :
    (mask0 s v).testBit (idx s x) = decide (x.a = v) := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have e : idx s x = (0 * (s.a + 1) + x.a) * ((s.b + 1) * ((s.c + 1) * (s.d + 1))) +
      ((x.b * (s.c + 1) + x.c) * (s.d + 1) + x.d) := by unfold idx; grind
  have hQ : (x.b * (s.c + 1) + x.c) * (s.d + 1) + x.d < (s.b + 1) * ((s.c + 1) * (s.d + 1)) := by
    have h1 : x.b * (s.c + 1) + x.c < (s.b + 1) * (s.c + 1) := digit_lt (by omega) (by omega)
    have h2 := digit_lt h1 (show x.d < s.d + 1 by omega)
    rw [← Nat.mul_assoc]; exact h2
  rw [mask0, e]
  exact layer_spec (by omega) (by omega) hQ (by omega)

theorem mask1_spec {s x : Code} (hx : InBox s x) {v : ℕ} (hv : v ≤ s.b) :
    (mask1 s v).testBit (idx s x) = decide (x.b = v) := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have e : idx s x = (x.a * (s.b + 1) + x.b) * ((s.c + 1) * (s.d + 1)) +
      (x.c * (s.d + 1) + x.d) := by unfold idx; grind
  have hQ : x.c * (s.d + 1) + x.d < (s.c + 1) * (s.d + 1) := digit_lt (by omega) (by omega)
  rw [mask1, e]
  exact layer_spec (by omega) (by omega) hQ (by omega)

theorem mask2_spec {s x : Code} (hx : InBox s x) {v : ℕ} (hv : v ≤ s.c) :
    (mask2 s v).testBit (idx s x) = decide (x.c = v) := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have e : idx s x = ((x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c) * (s.d + 1) + x.d := rfl
  have hP : x.a * (s.b + 1) + x.b < (s.a + 1) * (s.b + 1) := digit_lt (by omega) (by omega)
  rw [mask2, e]
  exact layer_spec hP (by omega) (by omega) (by omega)

theorem mask3_spec {s x : Code} (hx : InBox s x) {v : ℕ} (hv : v ≤ s.d) :
    (mask3 s v).testBit (idx s x) = decide (x.d = v) := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have e : idx s x = (((x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c) * (s.d + 1) + x.d) * 1 + 0 := by
    unfold idx; grind
  have hP : (x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c < (s.a + 1) * (s.b + 1) * (s.c + 1) := by
    have h1 : x.a * (s.b + 1) + x.b < (s.a + 1) * (s.b + 1) := digit_lt (by omega) (by omega)
    exact digit_lt h1 (by omega)
  rw [mask3, e]
  exact layer_spec hP (by omega) (by omega) (by omega)

/-- Mask of the box codes whose part `p` equals `v`. -/
def vmask (s : Code) (p : Fin 4) (v : ℕ) : ℕ :=
  match p with
  | ⟨0, _⟩ => mask0 s v
  | ⟨1, _⟩ => mask1 s v
  | ⟨2, _⟩ => mask2 s v
  | ⟨_ + 3, _⟩ => mask3 s v

theorem vmask_spec {s x : Code} (hx : InBox s x) (p : Fin 4) {v : ℕ} (hv : v ≤ s.get p) :
    (vmask s p v).testBit (idx s x) = decide (x.get p = v) := by
  match p with
  | ⟨0, _⟩ => exact mask0_spec hx hv
  | ⟨1, _⟩ => exact mask1_spec hx hv
  | ⟨2, _⟩ => exact mask2_spec hx hv
  | ⟨3, _⟩ => exact mask3_spec hx hv

/-- Box codes meeting the code `a` in some part (`a` must lie in the box). -/
def meetMask (s a : Code) : ℕ :=
  vmask s 0 a.a ||| vmask s 1 a.b ||| vmask s 2 a.c ||| vmask s 3 a.d

def meets (x y : Code) : Bool :=
  decide (x.a = y.a) || decide (x.b = y.b) || decide (x.c = y.c) || decide (x.d = y.d)

theorem meetMask_spec {s x a : Code} (hx : InBox s x) (ha : InBox s a) :
    (meetMask s a).testBit (idx s x) = meets x a := by
  obtain ⟨aa, ab, ac, ad⟩ := ha
  simp only [meetMask, Nat.testBit_or, meets]
  rw [vmask_spec hx 0 (by simpa using aa), vmask_spec hx 1 (by simpa using ab),
    vmask_spec hx 2 (by simpa using ac), vmask_spec hx 3 (by simpa using ad)]
  rfl

/-- Union of `vmask` over a list of vertices `(part, value)`. -/
def hitMask (s : Code) : List (Fin 4 × ℕ) → ℕ
  | [] => 0
  | q :: rest => vmask s q.1 q.2 ||| hitMask s rest

def hits (C : List (Fin 4 × ℕ)) (x : Code) : Bool := C.any fun q => decide (x.get q.1 = q.2)

theorem hitMask_spec {s x : Code} (hx : InBox s x) (C : List (Fin 4 × ℕ))
    (hC : ∀ q ∈ C, q.2 ≤ s.get q.1) : (hitMask s C).testBit (idx s x) = hits C x := by
  induction C with
  | nil => simp [hitMask, hits]
  | cons q rest ih =>
    simp only [hitMask, Nat.testBit_or, hits, List.any_cons]
    rw [vmask_spec hx q.1 (hC q (by simp)), ih (fun r hr => hC r (by simp [hr]))]
    rfl

/-- Set difference of bitmasks. -/
def diff (x y : ℕ) : ℕ := x ^^^ (x &&& y)

@[simp] theorem testBit_diff (x y i : ℕ) : (diff x y).testBit i = (x.testBit i && !y.testBit i) := by
  simp only [diff, Nat.testBit_xor, Nat.testBit_and]
  cases x.testBit i <;> cases y.testBit i <;> rfl

/-! ## Encoding actual edges -/

/-- The trace of an actual edge: labels at or above the sentinel collapse to it. -/
def enc (s : Code) (g : NatEdge) : Code := ⟨min (g 0) s.a, min (g 1) s.b, min (g 2) s.c, min (g 3) s.d⟩

theorem enc_inBox (s : Code) (g : NatEdge) : InBox s (enc s g) := by
  simp only [InBox, enc]
  exact ⟨Nat.min_le_right _ _, Nat.min_le_right _ _, Nat.min_le_right _ _, Nat.min_le_right _ _⟩

theorem enc_get (s : Code) (g : NatEdge) (i : Fin 4) : (enc s g).get i = min (g i) (s.get i) := by
  match i with
  | ⟨0, _⟩ => rfl
  | ⟨1, _⟩ => rfl
  | ⟨2, _⟩ => rfl
  | ⟨3, _⟩ => rfl

theorem enc_get_known {s : Code} (g : NatEdge) {i : Fin 4} {v : ℕ} (hv : v < s.get i) :
    (enc s g).get i = v ↔ g i = v := by
  rw [enc_get]
  have key : ∀ y v w : ℕ, v < w → (min y w = v ↔ y = v) := by
    intro y v w h
    by_cases hle : y ≤ w
    · rw [Nat.min_eq_left hle]
    · rw [Nat.min_eq_right (by omega)]; constructor <;> intro h' <;> omega
  exact key (g i) v (s.get i) hv

theorem toEdge_get (x : Code) (i : Fin 4) : x.toEdge i = x.get i := rfl

/-- A code all of whose labels are known is its own trace. -/
theorem enc_toEdge {s x : Code} (hx : known s x = true) : enc s x.toEdge = x := by
  simp only [known, Bool.and_eq_true, decide_eq_true_eq] at hx
  obtain ⟨⟨⟨ha, hb⟩, hc⟩, hd⟩ := hx
  obtain ⟨a, b, c, d⟩ := x
  show (⟨min a s.a, min b s.b, min c s.c, min d s.d⟩ : Code) = ⟨a, b, c, d⟩
  simp only at ha hb hc hd
  simp only [Code.mk.injEq]
  exact ⟨Nat.min_eq_left (by omega), Nat.min_eq_left (by omega), Nat.min_eq_left (by omega),
    Nat.min_eq_left (by omega)⟩

theorem known_inBox {s x : Code} (hx : known s x = true) : InBox s x := by
  simp only [known, Bool.and_eq_true, decide_eq_true_eq] at hx
  simp only [InBox]; omega

theorem known_get {s x : Code} (hx : known s x = true) (i : Fin 4) : x.get i < s.get i := by
  simp only [known, Bool.and_eq_true, decide_eq_true_eq] at hx
  match i with
  | ⟨0, _⟩ => exact hx.1.1.1
  | ⟨1, _⟩ => exact hx.1.1.2
  | ⟨2, _⟩ => exact hx.1.2
  | ⟨3, _⟩ => exact hx.2

theorem meets_iff (x y : Code) : meets x y = true ↔ ∃ i, x.get i = y.get i := by
  simp only [meets, Bool.or_eq_true, decide_eq_true_eq]
  constructor
  · rintro (((h | h) | h) | h)
    · exact ⟨0, h⟩
    · exact ⟨1, h⟩
    · exact ⟨2, h⟩
    · exact ⟨3, h⟩
  · rintro ⟨i, h⟩
    match i with
    | ⟨0, _⟩ => exact Or.inl (Or.inl (Or.inl h))
    | ⟨1, _⟩ => exact Or.inl (Or.inl (Or.inr h))
    | ⟨2, _⟩ => exact Or.inl (Or.inr h)
    | ⟨3, _⟩ => exact Or.inr h

/-- Meeting a known code is detected by the trace. -/
theorem meets_enc_iff {s a : Code} (ha : known s a = true) (g : NatEdge) :
    meets (enc s g) a = true ↔ EdgeMeets g a.toEdge := by
  rw [meets_iff]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, by rw [toEdge_get]; exact (enc_get_known g (known_get ha i)).mp hi⟩
  · rintro ⟨i, hi⟩
    rw [toEdge_get] at hi
    exact ⟨i, (enc_get_known g (known_get ha i)).mpr hi⟩

/-- Codes that differ in every part come from disjoint actual edges. -/
theorem disjoint_of_enc {s : Code} {g h : NatEdge}
    (hd : meets (enc s g) (enc s h) = false) : EdgeDisjoint g h := by
  intro i hi
  have : (enc s g).get i = (enc s h).get i := by rw [enc_get, enc_get, hi]
  have hm : meets (enc s g) (enc s h) = true := (meets_iff _ _).mpr ⟨i, this⟩
  rw [hd] at hm; exact Bool.false_ne_true hm

end Ryser.Fast
end

/-! ## `Ryser.CoverWitness` (source sha256 1be59cdf6aa5…) -/
section
namespace Ryser.CoverWitness
open FiniteBox

theorem actualCover_card_le (C : List (Fin 4 × ℕ)) : (actualCover C).card ≤ C.length := by
  simpa only [actualCover,List.length_map] using List.toFinset_card_le (C.map (fun v => (Sigma.mk v.1 v.2 : Vertex (fun _ : Fin 4 => ℕ))))

theorem exists_outside (H : Finset NatEdge) (notCover : ¬ CoverAtMost H 5)
    (C : List (Fin 4 × ℕ)) (size : C.length ≤ 5) :
    ∃ e ∈ H, ∀ v ∈ C, e v.1 ≠ v.2 := by
  classical
  by_contra hn
  apply notCover
  refine ⟨actualCover C, (actualCover_card_le C).trans size, ?_⟩
  intro e he
  have hit : ∃ v ∈ C, e v.1 = v.2 := by
    by_contra hno
    apply hn
    refine ⟨e,he,?_⟩
    intro v hv eqv
    exact hno ⟨v,hv,eqv⟩
  obtain ⟨v,hv,heq⟩ := hit
  refine ⟨v.1,?_⟩
  rw [heq]
  exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨v,hv,rfl⟩)
end Ryser.CoverWitness
end

/-! ## `Ryser.Fast.Nine` (source sha256 62b2ea9980a4…) -/
section
/-!
# A kernel-evaluated certificate checker for anchored families

`check s F cert = true` proves: every finite natural-labelled `K` with
`MatchingAtMost K 2` that contains the anchor edges `F` has `CoverAtMost K 5`
(`check_sound`).  Nothing about `K` outside `F` is bounded.

The certificate is a refutation tree over the variables "some edge of `K` has
trace `x`", one for each code `x` of the trace box with sentinel `s`.  Each leaf
names a clause together with the reason it holds in every counterexample:
an anchor occurs; some admissible trace avoids a five-vertex set (no five-cover);
three pairwise disjoint traces cannot all occur (no three-matching); or a
residual clause, justified by the intersecting three-cover theorem.
All sets of traces are bitmasks, so each check is a few GMP operations.
-/

set_option maxRecDepth 8192
namespace Ryser.Fast
open FiniteBox

/-! ## Admissible traces -/

def disjointPairs (F : List Code) : List (Code × Code) :=
  F.flatMap fun a => (F.filter fun b => !meets a b).map fun b => (a, b)

def full (s : Code) : ℕ := 2 ^ size s - 1

def andAll (s : Code) : List ℕ → ℕ
  | [] => full s
  | m :: ms => m &&& andAll s ms

theorem andAll_spec {s x : Code} (hx : InBox s x) (ms : List ℕ) :
    (andAll s ms).testBit (idx s x) = true ↔ ∀ m ∈ ms, m.testBit (idx s x) = true := by
  induction ms with
  | nil =>
    simp only [andAll, full, Nat.testBit_two_pow_sub_one, decide_eq_true_eq, List.not_mem_nil,
      IsEmpty.forall_iff, implies_true, iff_true]
    exact idx_lt hx
  | cons m ms ih => simp [andAll, Nat.testBit_and, ih]

/-- Traces meeting both members' union of every disjoint anchor pair. -/
def admMask (s : Code) (F : List Code) : ℕ :=
  andAll s ((disjointPairs F).map fun q => meetMask s q.1 ||| meetMask s q.2)

theorem mem_disjointPairs {F : List Code} {q : Code × Code} (h : q ∈ disjointPairs F) :
    q.1 ∈ F ∧ q.2 ∈ F ∧ meets q.1 q.2 = false := by
  simp only [disjointPairs, List.mem_flatMap, List.mem_map, List.mem_filter,
    Bool.not_eq_true'] at h
  obtain ⟨a, ha, b, ⟨hb, hab⟩, rfl⟩ := h
  exact ⟨ha, hb, hab⟩

theorem edgeDisjoint_of_meets_false {a b : Code} (h : meets a b = false) :
    EdgeDisjoint a.toEdge b.toEdge := by
  intro i hi
  have hm : meets a b = true := (meets_iff a b).mpr ⟨i, hi⟩
  rw [h] at hm; exact Bool.false_ne_true hm

/-- Hypotheses shared by all soundness lemmas: an actual counterexample `K`. -/
structure Setting (s : Code) (F : List Code) (K : Finset NatEdge) : Prop where
  noThree : NoThreeMatching K
  known : ∀ a ∈ F, Fast.known s a = true
  mem : ∀ a ∈ F, a.toEdge ∈ K

theorem Setting.meets_enc {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    {a : Code} (ha : a ∈ F) (g : NatEdge) : meets (enc s g) a = true ↔ EdgeMeets g a.toEdge :=
  meets_enc_iff (hS.known a ha) g

theorem adm_enc {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    {g : NatEdge} (hg : g ∈ K) : (admMask s F).testBit (idx s (enc s g)) = true := by
  rw [admMask, andAll_spec (enc_inBox s g)]
  intro m hm
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hm
  obtain ⟨h1, h2, h12⟩ := mem_disjointPairs hq
  have hi := ResidualCoordinates.one_hits_pair hS.noThree hg (hS.mem _ h1) (hS.mem _ h2)
    (edgeDisjoint_of_meets_false h12)
  rw [Nat.testBit_or, meetMask_spec (enc_inBox s g) (known_inBox (hS.known _ h1)),
    meetMask_spec (enc_inBox s g) (known_inBox (hS.known _ h2)), Bool.or_eq_true,
    hS.meets_enc h1, hS.meets_enc h2, ← ResidualCoordinates.hits_iff,
    ← ResidualCoordinates.hits_iff]
  exact hi

/-! ## The occurrence assignment -/

/-- Bit `i` is "some edge of `K` has the trace with index `i`". -/
def Occ (s : Code) (K : Finset NatEdge) (i : ℕ) : Prop := ∃ g ∈ K, idx s (enc s g) = i

theorem occ_anchor {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    {a : Code} (ha : a ∈ F) : Occ s K (idx s a) :=
  ⟨a.toEdge, hS.mem a ha, by rw [enc_toEdge (hS.known a ha)]⟩

/-- A known vertex of the box. -/
def vertexOK (s : Code) (q : Fin 4 × ℕ) : Bool := decide (q.2 < s.get q.1)

theorem avoid_enc {s : Code} {C : List (Fin 4 × ℕ)} (hC : C.all (vertexOK s) = true)
    {g : NatEdge} (hg : ∀ q ∈ C, g q.1 ≠ q.2) : (hitMask s C).testBit (idx s (enc s g)) = false := by
  have hC' : ∀ q ∈ C, q.2 < s.get q.1 := by
    intro q hq; simpa [vertexOK] using List.all_eq_true.mp hC q hq
  rw [hitMask_spec (enc_inBox s g) C (fun q hq => Nat.le_of_lt (hC' q hq))]
  simp only [hits, List.any_eq_false, decide_eq_true_eq]
  intro q hq heq
  exact hg q hq ((enc_get_known g (hC' q hq)).mp heq)

/-- Positive clause: some admissible trace avoiding the at most five vertices `C` occurs. -/
theorem cover_clause {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    (notCover : ¬ CoverAtMost K 5) {C : List (Fin 4 × ℕ)} (hlen : C.length ≤ 5)
    (hC : C.all (vertexOK s) = true) :
    ∃ i, (diff (admMask s F) (hitMask s C)).testBit i = true ∧ Occ s K i := by
  obtain ⟨g, hg, hout⟩ := CoverWitness.exists_outside K notCover C hlen
  refine ⟨idx s (enc s g), ?_, g, hg, rfl⟩
  rw [testBit_diff, adm_enc hS hg, avoid_enc hC hout]
  rfl

/-- Negative clause: three pairwise disjoint traces do not all occur. -/
theorem neg_clause {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    {x y z : Code} (hx : InBox s x) (hy : InBox s y) (hz : InBox s z)
    (hxy : meets x y = false) (hxz : meets x z = false) (hyz : meets y z = false)
    (ox : Occ s K (idx s x)) (oy : Occ s K (idx s y)) (oz : Occ s K (idx s z)) : False := by
  obtain ⟨g1, h1, e1⟩ := ox
  obtain ⟨g2, h2, e2⟩ := oy
  obtain ⟨g3, h3, e3⟩ := oz
  have q1 := idx_injective (enc_inBox s g1) hx e1
  have q2 := idx_injective (enc_inBox s g2) hy e2
  have q3 := idx_injective (enc_inBox s g3) hz e3
  subst q1 q2 q3
  exact hS.noThree g1 h1 g2 h2 g3 h3 (disjoint_of_enc hxy) (disjoint_of_enc hxz)
    (disjoint_of_enc hyz)

/-! ## Residual clauses -/

/-- Traces that could be a disjoint partner of `x` inside a residual: they differ
from `x` in every known label and meet every anchor `x` misses. -/
def avoidKnown (s x : Code) : ℕ :=
  diff (diff (diff (diff (full s)
    (if x.a < s.a then vmask s 0 x.a else 0))
    (if x.b < s.b then vmask s 1 x.b else 0))
    (if x.c < s.c then vmask s 2 x.c else 0))
    (if x.d < s.d then vmask s 3 x.d else 0)

def partnerMask (s : Code) (F : List Code) (x : Code) : ℕ :=
  avoidKnown s x &&& andAll s ((F.filter fun a => !meets x a).map fun a => meetMask s a)

/-- Decoding a box index (inverse of `idx`). -/
def decode (s : Code) (i : ℕ) : Code :=
  ⟨i / (s.d + 1) / (s.c + 1) / (s.b + 1), i / (s.d + 1) / (s.c + 1) % (s.b + 1),
    i / (s.d + 1) % (s.c + 1), i % (s.d + 1)⟩

theorem decode_idx {s x : Code} (hx : InBox s x) : decode s (idx s x) = x := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have k1 : idx s x / (s.d + 1) = (x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c := by
    unfold idx; rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt (by omega)]
    omega
  have k2 : idx s x % (s.d + 1) = x.d := by
    unfold idx; rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)]
  have k3 : ((x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c) / (s.c + 1) = x.a * (s.b + 1) + x.b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt (by omega)]; omega
  have k4 : ((x.a * (s.b + 1) + x.b) * (s.c + 1) + x.c) % (s.c + 1) = x.c := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)]
  have k5 : (x.a * (s.b + 1) + x.b) / (s.b + 1) = x.a := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt (by omega)]; omega
  have k6 : (x.a * (s.b + 1) + x.b) % (s.b + 1) = x.b := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)]
  unfold decode
  rw [k1, k2, k3, k4, k5, k6]

theorem avoidKnown_spec {s x y : Code} (hx : InBox s x) (hy : InBox s y) :
    (avoidKnown s x).testBit (idx s y) = true ↔ ∀ i, x.get i < s.get i → y.get i ≠ x.get i := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have hfull : (full s).testBit (idx s y) = true := by
    rw [full, Nat.testBit_two_pow_sub_one, decide_eq_true_eq]; exact idx_lt hy
  simp only [avoidKnown, testBit_diff, hfull, Bool.true_and, Bool.and_eq_true, Bool.not_eq_true']
  have t0 : (if x.a < s.a then vmask s 0 x.a else 0).testBit (idx s y) = decide (x.a < s.a ∧ y.a = x.a) := by
    split <;> rename_i h
    · rw [vmask_spec hy 0 (by simpa using xa)]; by_cases h2 : y.a = x.a <;> simp [h, h2]
    · simp [h]
  have t1 : (if x.b < s.b then vmask s 1 x.b else 0).testBit (idx s y) = decide (x.b < s.b ∧ y.b = x.b) := by
    split <;> rename_i h
    · rw [vmask_spec hy 1 (by simpa using xb)]; by_cases h2 : y.b = x.b <;> simp [h, h2]
    · simp [h]
  have t2 : (if x.c < s.c then vmask s 2 x.c else 0).testBit (idx s y) = decide (x.c < s.c ∧ y.c = x.c) := by
    split <;> rename_i h
    · rw [vmask_spec hy 2 (by simpa using xc)]; by_cases h2 : y.c = x.c <;> simp [h, h2]
    · simp [h]
  have t3 : (if x.d < s.d then vmask s 3 x.d else 0).testBit (idx s y) = decide (x.d < s.d ∧ y.d = x.d) := by
    split <;> rename_i h
    · rw [vmask_spec hy 3 (by simpa using xd)]; by_cases h2 : y.d = x.d <;> simp [h, h2]
    · simp [h]
  rw [t0, t1, t2, t3]
  simp only [decide_eq_false_iff_not, not_and]
  constructor
  · rintro ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ i
    match i with
    | ⟨0, _⟩ => exact h0
    | ⟨1, _⟩ => exact h1
    | ⟨2, _⟩ => exact h2
    | ⟨3, _⟩ => exact h3
  · intro h
    exact ⟨⟨⟨h 0, h 1⟩, h 2⟩, h 3⟩

structure Residual where
  S : List (Fin 4 × ℕ)
  W : ℕ

def residualRest (s : Code) (adm : ℕ) (r : Residual) : ℕ := diff (diff adm (hitMask s r.S)) r.W

def partnerFree (s : Code) (F : List Code) (R : ℕ) (i : ℕ) : Bool :=
  !R.testBit i || (partnerMask s F (decode s i) &&& R == 0)

def residualOK (s : Code) (F : List Code) (adm : ℕ) (r : Residual) : Bool :=
  decide (r.S.length ≤ 2) && r.S.all (vertexOK s) &&
    (List.range (size s)).all (partnerFree s F (residualRest s adm r))

theorem residual_clause {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    (notCover : ¬ CoverAtMost K 5) {r : Residual} (hr : residualOK s F (admMask s F) r = true) :
    ∃ i, r.W.testBit i = true ∧ Occ s K i := by
  classical
  simp only [residualOK, Bool.and_eq_true, decide_eq_true_eq] at hr
  obtain ⟨⟨hlen, hS2⟩, hall⟩ := hr
  by_contra hno
  simp only [not_exists, not_and] at hno
  -- every edge of K avoiding S has its trace in the remaining set
  have inR : ∀ g ∈ K, (∀ q ∈ r.S, g q.1 ≠ q.2) →
      (residualRest s (admMask s F) r).testBit (idx s (enc s g)) = true := by
    intro g hg hgS
    have hw : r.W.testBit (idx s (enc s g)) = false := by
      cases hb : r.W.testBit (idx s (enc s g)) with
      | false => rfl
      | true => exact absurd ⟨g, hg, rfl⟩ (hno _ hb)
    simp only [residualRest, testBit_diff, adm_enc hS hg, avoid_enc hS2 hgS, hw]
    rfl
  -- the edges avoiding S form an intersecting family
  let K' := K.filter fun g => ∀ q ∈ r.S, g q.1 ≠ q.2
  have hK' : Theory.Intersecting K' := by
    intro e he f hf
    obtain ⟨heK, heS⟩ := Finset.mem_filter.mp he
    obtain ⟨hfK, hfS⟩ := Finset.mem_filter.mp hf
    by_contra hmeet
    have hef : EdgeDisjoint e f := not_edgeMeets_iff.mp hmeet
    have rx := inR e heK heS
    have ry := inR f hfK hfS
    have hcheck := List.all_eq_true.mp hall (idx s (enc s e))
      (List.mem_range.mpr (idx_lt (enc_inBox s e)))
    simp only [partnerFree, decode_idx (enc_inBox s e), rx, Bool.not_true, Bool.false_or,
      beq_iff_eq] at hcheck
    have hbit := congrArg (fun m => m.testBit (idx s (enc s f))) hcheck
    simp only [Nat.testBit_and, Nat.zero_testBit, ry, Bool.and_true, partnerMask,
      Bool.and_eq_false_iff] at hbit
    rcases hbit with hb | hb
    · -- the known labels of the two traces differ
      have hnot : ¬ ∀ i, (enc s e).get i < s.get i → (enc s f).get i ≠ (enc s e).get i := by
        intro h
        rw [(avoidKnown_spec (enc_inBox s e) (enc_inBox s f)).mpr h] at hb
        exact absurd hb (by decide)
      apply hnot
      intro i hi heq
      have he' : e i = (enc s e).get i := (enc_get_known e hi).mp rfl
      have hf' : f i = (enc s e).get i := (enc_get_known f hi).mp heq
      exact hef i (he'.trans hf'.symm)
    · -- every anchor missed by `e` is met by `f`
      have hall' : ∀ m ∈ ((F.filter fun a => !meets (enc s e) a).map fun a => meetMask s a),
          m.testBit (idx s (enc s f)) = true := by
        intro m hm
        obtain ⟨a, haF, rfl⟩ := List.mem_map.mp hm
        obtain ⟨haF, hna⟩ := List.mem_filter.mp haF
        simp only [Bool.not_eq_true'] at hna
        rw [meetMask_spec (enc_inBox s f) (known_inBox (hS.known a haF))]
        have hh := ResidualCoordinates.two_hit_anchor hS.noThree heK hfK (hS.mem a haF) hef
        rw [ResidualCoordinates.hits_iff, ResidualCoordinates.hits_iff, ← hS.meets_enc haF,
          ← hS.meets_enc haF, hna] at hh
        simpa using hh
      rw [(andAll_spec (enc_inBox s f) _).mpr hall'] at hb
      exact absurd hb (by decide)
  obtain ⟨C, hC, hcov⟩ := Theory.intersecting_cover_three K' hK'
  apply notCover
  refine ⟨actualCover r.S ∪ C, (Finset.card_union_le _ _).trans ?_, ?_⟩
  · have := CoverWitness.actualCover_card_le r.S
    omega
  · intro g hg
    by_cases hgS : ∀ q ∈ r.S, g q.1 ≠ q.2
    · obtain ⟨i, hi⟩ := hcov g (Finset.mem_filter.mpr ⟨hg, hgS⟩)
      exact ⟨i, Finset.mem_union_right _ hi⟩
    · simp only [not_forall, not_not] at hgS
      obtain ⟨q, hq, heq⟩ := hgS
      refine ⟨q.1, Finset.mem_union_left _ ?_⟩
      rw [heq]
      exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨q, hq, rfl⟩)

/-! ## Refutation trees -/

inductive Leaf where
  | anchor (a : Code)
  | cover (C : List (Fin 4 × ℕ))
  | neg (x y z : Code)
  | residual (k : ℕ)

inductive Tree where
  | leaf (l : Leaf)
  | split (v : ℕ) (yes no : Tree)

/-- A leaf closes the branch: its clause is false under the partial assignment
`T` (indices assumed to occur) / `Fm` (indices assumed not to occur). -/
def leafOK (s : Code) (F : List Code) (adm : ℕ) (R : List Residual) (T Fm : ℕ) : Leaf → Bool
  | .anchor a => F.any (fun b => decide (b = a)) && Fm.testBit (idx s a)
  | .cover C => decide (C.length ≤ 5) && C.all (vertexOK s) && (diff (diff adm (hitMask s C)) Fm == 0)
  | .neg x y z => inBox s x && inBox s y && inBox s z && !meets x y && !meets x z && !meets y z &&
      T.testBit (idx s x) && T.testBit (idx s y) && T.testBit (idx s z)
  | .residual k => match R[k]? with
      | some r => diff r.W Fm == 0
      | none => false

def checkTree (s : Code) (F : List Code) (adm : ℕ) (R : List Residual) : ℕ → ℕ → Tree → Bool
  | T, Fm, .leaf l => leafOK s F adm R T Fm l
  | T, Fm, .split v y n =>
      checkTree s F adm R (T ||| 2 ^ v) Fm y && checkTree s F adm R T (Fm ||| 2 ^ v) n

structure Cert where
  residuals : List Residual
  tree : Tree

def check (s : Code) (F : List Code) (c : Cert) : Bool :=
  F.all (known s) && c.residuals.all (residualOK s F (admMask s F)) &&
    checkTree s F (admMask s F) c.residuals 0 0 c.tree

theorem leafOK_false {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    (notCover : ¬ CoverAtMost K 5) {R : List Residual}
    (hR : ∀ r ∈ R, residualOK s F (admMask s F) r = true) {T Fm : ℕ}
    (hT : ∀ i, T.testBit i = true → Occ s K i) (hFm : ∀ i, Fm.testBit i = true → ¬ Occ s K i)
    (l : Leaf) (h : leafOK s F (admMask s F) R T Fm l = true) : False := by
  cases l with
  | anchor a =>
    simp only [leafOK, Bool.and_eq_true, List.any_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨b, hb, rfl⟩, hfa⟩ := h
    exact hFm _ hfa (occ_anchor hS hb)
  | cover C =>
    simp only [leafOK, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    obtain ⟨⟨hlen, hC⟩, hz⟩ := h
    obtain ⟨i, hi, oi⟩ := cover_clause hS notCover hlen hC
    have hbit := congrArg (fun m => m.testBit i) hz
    simp only [testBit_diff, hi, Bool.true_and, Nat.zero_testBit, Bool.not_eq_false'] at hbit
    exact hFm i hbit oi
  | neg x y z =>
    simp only [leafOK, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨⟨⟨⟨⟨⟨⟨⟨hx, hy⟩, hz⟩, hxy⟩, hxz⟩, hyz⟩, tx⟩, ty⟩, tz⟩ := h
    exact neg_clause hS ((inBox_iff s x).mp hx) ((inBox_iff s y).mp hy) ((inBox_iff s z).mp hz)
      hxy hxz hyz (hT _ tx) (hT _ ty) (hT _ tz)
  | residual k =>
    simp only [leafOK] at h
    split at h
    · rename_i r hr
      simp only [beq_iff_eq] at h
      obtain ⟨i, hi, oi⟩ := residual_clause hS notCover (hR r (List.mem_of_getElem? hr))
      have hbit := congrArg (fun m => m.testBit i) h
      simp only [testBit_diff, hi, Bool.true_and, Nat.zero_testBit, Bool.not_eq_false'] at hbit
      exact hFm i hbit oi
    · exact Bool.false_ne_true h

theorem checkTree_sound {s : Code} {F : List Code} {K : Finset NatEdge} (hS : Setting s F K)
    (notCover : ¬ CoverAtMost K 5) {R : List Residual}
    (hR : ∀ r ∈ R, residualOK s F (admMask s F) r = true) (t : Tree) :
    ∀ T Fm, (∀ i, T.testBit i = true → Occ s K i) → (∀ i, Fm.testBit i = true → ¬ Occ s K i) →
      checkTree s F (admMask s F) R T Fm t = true → False := by
  induction t with
  | leaf l =>
    intro T Fm hT hFm h
    exact leafOK_false hS notCover hR hT hFm l h
  | split v y n ihy ihn =>
    intro T Fm hT hFm h
    simp only [checkTree, Bool.and_eq_true] at h
    by_cases hv : Occ s K v
    · refine ihy (T ||| 2 ^ v) Fm ?_ hFm h.1
      intro i hi
      rw [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
      rcases hi with hi | rfl
      · exact hT i hi
      · exact hv
    · refine ihn T (Fm ||| 2 ^ v) hT ?_ h.2
      intro i hi
      rw [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
      rcases hi with hi | rfl
      · exact hFm i hi
      · exact hv

/-- **Soundness.** An accepted certificate gives a five-cover of every finite
natural-labelled `K` with matching number at most two containing the anchors. -/
theorem check_sound {s : Code} {F : List Code} {c : Cert} (h : check s F c = true)
    (K : Finset NatEdge) (hm : MatchingAtMost K 2) (hK : ∀ a ∈ F, a.toEdge ∈ K) :
    CoverAtMost K 5 := by
  classical
  simp only [check, Bool.and_eq_true] at h
  obtain ⟨⟨hknown, hres⟩, htree⟩ := h
  have hS : Setting s F K :=
    ⟨matchingAtMost_two_noThree hm, fun a ha => List.all_eq_true.mp hknown a ha, hK⟩
  by_contra notCover
  exact checkTree_sound hS notCover (fun r hr => List.all_eq_true.mp hres r hr) c.tree 0 0
    (by simp) (by simp) htree


end Ryser.Fast
end

/-! ## `Ryser.ResidualWitness` (source sha256 182a7ef1da20…) -/
section
namespace Ryser.ResidualWitness
open FiniteBox

theorem exists_pair_outside (H : Finset NatEdge) (notCover : ¬ CoverAtMost H 5)
    (p q : Fin 4 × ℕ) :
    ∃ e ∈ H, ∃ f ∈ H, e p.1 ≠ p.2 ∧ e q.1 ≠ q.2 ∧
      f p.1 ≠ p.2 ∧ f q.1 ≠ q.2 ∧ EdgeDisjoint e f := by
  classical
  by_contra hn
  apply notCover
  apply ResidualCoordinates.cover_of_two_deleted H p q
  intro e he f hf heP heQ hfP hfQ hef
  exact hn ⟨e,he,f,hf,heP,heQ,hfP,hfQ,hef⟩
end Ryser.ResidualWitness
end

/-! ## `Ryser.Theory.CaseIsomorphism` (source sha256 073f291f1d13…) -/
section
namespace Ryser.Theory
universe u

/-- Transfer an unbounded actual-hypergraph theorem between lists of coded
anchors. `select` sends each representative index to its source index. For a
nine-anchor isomorphism it is the supplied anchor permutation. Surjectivity is
unnecessary: additional source anchors and additional vertices of H are kept.
The representative's coordinate bounds constrain only its anchors, never H. -/
theorem cover_of_list_anchor_pattern {V : Fin 4 → Type u}
    {H : Finset (Edge V)} {α β : Type*} {n c : ℕ}
    (source : List α) (sourceCoord : α → Edge V)
    (representative : List β) (representativeCoord : β → Edge (fun _ : Fin 4 => ℕ))
    (select : Fin representative.length → Fin source.length)
    (σ : Equiv.Perm (Fin 4))
    (pattern : ∀ (i : Fin 4) (k l : Fin representative.length),
      sourceCoord (source.get (select k)) (σ i) = sourceCoord (source.get (select l)) (σ i) ↔
        representativeCoord (representative.get k) i = representativeCoord (representative.get l) i)
    (B : Fin 4 → ℕ)
    (bounded : ∀ x ∈ representative, ∀ i, representativeCoord x i < B i)
    (hsource : ∀ x ∈ source, sourceCoord x ∈ H)
    (hmatch : MatchingAtMost H n)
    (representativeCover : ∀ K : Finset (Edge (fun _ : Fin 4 => ℕ)),
      MatchingAtMost K n → (∀ x ∈ representative, representativeCoord x ∈ K) →
        CoverAtMost K c) : CoverAtMost H c := by
  apply cover_of_permuted_anchor_pattern
    (fun k => sourceCoord (source.get (select k)))
    (fun k => hsource _ (List.get_mem _ _))
    (fun k => representativeCoord (representative.get k)) σ (Equiv.refl _) pattern B
    (fun k i => bounded _ (List.get_mem _ _) i) hmatch
  intro K hm hk
  apply representativeCover K hm
  intro x hx
  obtain ⟨k, rfl⟩ := List.mem_iff_get.mp hx
  exact hk k

end Ryser.Theory
end

/-! ## `Ryser.Fast.Row` (source sha256 644063c08396…) -/
section
/-!
# Seven anchors, a two-vertex label cover, and every residual pair

For a frozen row with anchors `A` and a two-vertex set `{p, q}`, assume `H` has no
five-cover.  Then `H` minus `{p, q}` is not intersecting (otherwise the intersecting
three-cover theorem plus `{p, q}` covers `H`), so it has two disjoint edges `e, f`.
Relabel the whole of `H` so that labels below the anchor bound `b` are kept, the
outside labels of `e` become `b` and those of `f` become `b` or `b + 1`
(`cover_of_pair`; the relabelling is injective on the support of `H`).
The normalised pair then lies in a finite box, and `row_sound` checks with
bitmasks that every admissible normalised pair is listed together with an
accepted `Fast.check` certificate for the nine anchors `A ++ [e', f']`.
-/

set_option maxRecDepth 8192
namespace Ryser.Fast
open FiniteBox

/-! ## Gap-free relabelling of a residual pair -/

/-- Labels `< b` stay; `e`'s outside label becomes `b`; any other label (used for `f`)
becomes `b` if `e` is inside and `b + 1` otherwise. -/
def lab (b e x : ℕ) : ℕ := if x < b then x else if x = e then b else if e < b then b else b + 1

theorem lab_le (b e x : ℕ) : lab b e x ≤ b + 1 := by
  unfold lab; split_ifs <;> omega

theorem lab_small {b e x : ℕ} (hx : x < b) : lab b e x = x := by simp [lab, hx]

theorem lab_eq_small {b e x v : ℕ} (hv : v < b) : lab b e x = v ↔ x = v := by
  unfold lab; split_ifs <;> omega

theorem lab_e_le (b e : ℕ) : lab b e e ≤ b := by
  unfold lab; split_ifs <;> omega

theorem lab_inj {b e f x y : ℕ} (_hef : e ≠ f) (hx : x < b ∨ x = e ∨ x = f)
    (hy : y < b ∨ y = e ∨ y = f) (h : lab b e x = lab b e y) : x = y := by
  unfold lab at h; split_ifs at h <;> omega

theorem lab_f_gap {b e f : ℕ} (he : e < b) : lab b e f ≠ b + 1 := by
  unfold lab; split_ifs <;> omega

def normEdge (b : Code) (e g : NatEdge) : NatEdge := fun i => lab (b.get i) (e i) (g i)

def ofEdge (g : NatEdge) : Code := ⟨g 0, g 1, g 2, g 3⟩

theorem ofEdge_get (g : NatEdge) (i : Fin 4) : (ofEdge g).get i = g i := by
  match i with
  | ⟨0, _⟩ => rfl
  | ⟨1, _⟩ => rfl
  | ⟨2, _⟩ => rfl
  | ⟨3, _⟩ => rfl

theorem ofEdge_toEdge (g : NatEdge) : (ofEdge g).toEdge = g := by
  funext i; exact ofEdge_get g i

/-- Transfer a cover theorem for the normalised pair back to the whole of `H`. -/
theorem cover_of_pair (b : Code) (A : List NatEdge) (hA : ∀ a ∈ A, ∀ i, a i < b.get i)
    (H : Finset NatEdge) (hm : MatchingAtMost H 2) (hAH : ∀ a ∈ A, a ∈ H)
    (e f : NatEdge) (he : e ∈ H) (hf : f ∈ H) (hef : EdgeDisjoint e f)
    (cover : ∀ K : Finset NatEdge, MatchingAtMost K 2 → (∀ a ∈ A, a ∈ K) →
      normEdge b e e ∈ K → normEdge b e f ∈ K → CoverAtMost K 5) : CoverAtMost H 5 := by
  classical
  let source := A ++ [e, f]
  have supported (x : NatEdge) (hx : x ∈ source) (i : Fin 4) :
      x i < b.get i ∨ x i = e i ∨ x i = f i := by
    rcases List.mem_append.mp hx with ha | hx
    · exact Or.inl (hA x ha i)
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
  have normA (a : NatEdge) (ha : a ∈ A) : normEdge b e a = a := by
    funext i; exact lab_small (hA a ha i)
  apply Theory.cover_of_list_anchor_pattern source id source (normEdge b e)
    (fun k => k) (Equiv.refl _) ?_ (fun i => b.get i + 2) ?_ ?_ hm ?_
  · intro i k l
    simp only [id, Equiv.refl_apply]
    constructor
    · intro h; simp only [normEdge]; rw [h]
    · intro h
      exact lab_inj (hef i) (supported _ (List.get_mem source k) i)
        (supported _ (List.get_mem source l) i) h
  · intro x _ i
    have := lab_le (b.get i) (e i) (x i)
    simp only [normEdge]; omega
  · intro x hx
    rcases List.mem_append.mp hx with ha | hx
    · exact hAH x ha
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact he
      · exact hf
  · intro K hK hsource
    apply cover K hK
    · intro a ha
      have h := hsource a (List.mem_append_left _ ha)
      rwa [normA a ha] at h
    · exact hsource e (List.mem_append_right _ (by simp))
    · exact hsource f (List.mem_append_right _ (by simp))

/-! ## The finite row check -/

structure Member where
  f : Code
  s : Code
  cert : Cert

structure Group where
  e : Code
  members : List Member

def bumped (b : Code) : Code := ⟨b.a + 1, b.b + 1, b.c + 1, b.d + 1⟩

/-- Normalised `e` candidates (box with sentinel `b`): admissible and avoiding `S`. -/
def eMask (b : Code) (A : List Code) (S : List (Fin 4 × ℕ)) : ℕ :=
  diff (admMask b A) (hitMask b S)

/-- Parts where `e` is inside: there `f` cannot take the second fresh label. -/
def gapVertices (b e : Code) : List (Fin 4 × ℕ) :=
  (if e.a < b.a then [(0, b.a + 1)] else []) ++ (if e.b < b.b then [(1, b.b + 1)] else []) ++
  (if e.c < b.c then [(2, b.c + 1)] else []) ++ (if e.d < b.d then [(3, b.d + 1)] else [])

def eVertices (e : Code) : List (Fin 4 × ℕ) := [(0, e.a), (1, e.b), (2, e.c), (3, e.d)]

/-- Normalised `f` partners of `e` (box with sentinel `b + 1`). -/
def fMask (b : Code) (A : List Code) (S : List (Fin 4 × ℕ)) (e : Code) : ℕ :=
  diff (diff (diff (admMask (bumped b) A) (hitMask (bumped b) S))
      (hitMask (bumped b) (eVertices e))) (hitMask (bumped b) (gapVertices b e))
    &&& andAll (bumped b) ((A.filter fun a => !meets e a).map fun a => meetMask (bumped b) a)

def keysMask (b : Code) : List Group → ℕ
  | [] => 0
  | g :: gs => 2 ^ idx b g.e ||| keysMask b gs

def membersMask (t : Code) : List Member → ℕ
  | [] => 0
  | m :: ms => 2 ^ idx t m.f ||| membersMask t ms

def groupOK (b : Code) (A : List Code) (S : List (Fin 4 × ℕ)) (g : Group) : Bool :=
  inBox b g.e && (diff (fMask b A S g.e) (membersMask (bumped b) g.members) == 0) &&
    g.members.all fun m => inBox (bumped b) m.f && check m.s (A ++ [g.e, m.f]) m.cert

def keysOK (b : Code) (A : List Code) (S : List (Fin 4 × ℕ)) (groups : List Group) : Bool :=
  diff (eMask b A S) (keysMask b groups) == 0

theorem keysMask_spec {b : Code} {i : ℕ} :
    ∀ gs : List Group, (keysMask b gs).testBit i = true → ∃ g ∈ gs, idx b g.e = i
  | [], h => by simp [keysMask] at h
  | g :: gs, h => by
    simp only [keysMask, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true,
      decide_eq_true_eq] at h
    rcases h with h | h
    · exact ⟨g, by simp, h⟩
    · obtain ⟨g', hg', e'⟩ := keysMask_spec gs h
      exact ⟨g', by simp [hg'], e'⟩

theorem membersMask_spec {t : Code} {i : ℕ} :
    ∀ ms : List Member, (membersMask t ms).testBit i = true → ∃ m ∈ ms, idx t m.f = i
  | [], h => by simp [membersMask] at h
  | m :: ms, h => by
    simp only [membersMask, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true,
      decide_eq_true_eq] at h
    rcases h with h | h
    · exact ⟨m, by simp, h⟩
    · obtain ⟨m', hm', e'⟩ := membersMask_spec ms h
      exact ⟨m', by simp [hm'], e'⟩

/-! ## Facts about the normalised pair -/

section
variable {b : Code} {e f : NatEdge}

theorem norm_get (g : NatEdge) (i : Fin 4) :
    (ofEdge (normEdge b e g)).get i = lab (b.get i) (e i) (g i) := by
  rw [ofEdge_get]; rfl

theorem norm_eq_small (g : NatEdge) {i : Fin 4} {v : ℕ} (hv : v < b.get i) :
    (ofEdge (normEdge b e g)).get i = v ↔ g i = v := by
  rw [norm_get]; exact lab_eq_small hv

theorem normE_inBox : InBox b (ofEdge (normEdge b e e)) := by
  have h := fun i => (norm_get (b := b) (e := e) e i).trans_le (lab_e_le _ _)
  exact ⟨by simpa using h 0, by simpa using h 1, by simpa using h 2, by simpa using h 3⟩

theorem norm_inBumped (g : NatEdge) : InBox (bumped b) (ofEdge (normEdge b e g)) := by
  have h := fun i => (norm_get (b := b) (e := e) g i).trans_le (lab_le _ _ _)
  exact ⟨by simpa [bumped] using h 0, by simpa [bumped] using h 1, by simpa [bumped] using h 2,
    by simpa [bumped] using h 3⟩

/-- Meeting a known anchor is unchanged by normalisation. -/
theorem meets_norm {a : Code} (ha : known b a = true) (g : NatEdge) :
    meets (ofEdge (normEdge b e g)) a = true ↔ EdgeMeets g a.toEdge := by
  rw [meets_iff]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, by rw [toEdge_get]; exact (norm_eq_small g (known_get ha i)).mp hi⟩
  · rintro ⟨i, hi⟩
    rw [toEdge_get] at hi
    exact ⟨i, (norm_eq_small g (known_get ha i)).mpr hi⟩

/-- Known anchors of `b` stay known (and inside) for the bumped box. -/
theorem known_bumped {a : Code} (ha : known b a = true) : known (bumped b) a = true := by
  simp only [known, Bool.and_eq_true, decide_eq_true_eq] at ha
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := ha
  have e1 : a.a < (bumped b).a := by show a.a < b.a + 1; omega
  have e2 : a.b < (bumped b).b := by show a.b < b.b + 1; omega
  have e3 : a.c < (bumped b).c := by show a.c < b.c + 1; omega
  have e4 : a.d < (bumped b).d := by show a.d < b.d + 1; omega
  simp only [known, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨⟨e1, e2⟩, e3⟩, e4⟩

end

theorem row_sound (b : Code) (A : List Code) (p q : Fin 4 × ℕ) (groups : List Group)
    (hA : A.all (known b) = true) (hp : vertexOK b p = true) (hq : vertexOK b q = true)
    (hkeys : keysOK b A [p, q] groups = true)
    (hgroups : ∀ g ∈ groups, groupOK b A [p, q] g = true)
    (H : Finset NatEdge) (hm : MatchingAtMost H 2) (hAH : ∀ a ∈ A, a.toEdge ∈ H) :
    CoverAtMost H 5 := by
  classical
  have hAk : ∀ a ∈ A, known b a = true := fun a ha => List.all_eq_true.mp hA a ha
  have hp' : p.2 < b.get p.1 := by simpa [vertexOK] using hp
  have hq' : q.2 < b.get q.1 := by simpa [vertexOK] using hq
  have h3 := matchingAtMost_two_noThree hm
  by_contra hn
  obtain ⟨e, he, f, hf, hep, heq, hfp, hfq, hef⟩ := ResidualWitness.exists_pair_outside H hn p q
  apply hn
  apply cover_of_pair b (A.map Code.toEdge) ?_ H hm ?_ e f he hf hef
  rotate_left
  · intro a ha i
    obtain ⟨a', ha', rfl⟩ := List.mem_map.mp ha
    rw [toEdge_get]; exact known_get (hAk a' ha') i
  · intro a ha
    obtain ⟨a', ha', rfl⟩ := List.mem_map.mp ha
    exact hAH a' ha'
  intro K hK hAK he' hf'
  set e' := ofEdge (normEdge b e e) with he'def
  set f' := ofEdge (normEdge b e f) with hf'def
  have eIn : InBox b e' := normE_inBox
  have fIn : InBox (bumped b) f' := norm_inBumped f
  -- both normalised edges meet every disjoint anchor pair
  have admE : ∀ (t : Code) (g : NatEdge), g ∈ H → InBox t (ofEdge (normEdge b e g)) →
      (∀ a ∈ A, known t a = true) →
      (admMask t A).testBit (idx t (ofEdge (normEdge b e g))) = true := by
    intro t g hg hgt htk
    rw [admMask, andAll_spec hgt]
    intro m hm'
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hm'
    obtain ⟨h1, h2, h12⟩ := mem_disjointPairs hr
    have hi := ResidualCoordinates.one_hits_pair h3 hg (hAH _ h1) (hAH _ h2)
      (edgeDisjoint_of_meets_false h12)
    rw [Nat.testBit_or, meetMask_spec hgt (known_inBox (htk _ h1)),
      meetMask_spec hgt (known_inBox (htk _ h2)), Bool.or_eq_true,
      meets_norm (hAk _ h1), meets_norm (hAk _ h2), ← ResidualCoordinates.hits_iff,
      ← ResidualCoordinates.hits_iff]
    exact hi
  have avoidS : ∀ (t : Code) (g : NatEdge), InBox t (ofEdge (normEdge b e g)) →
      (∀ v ∈ [p, q], v.2 ≤ t.get v.1) → g p.1 ≠ p.2 → g q.1 ≠ q.2 →
      (hitMask t [p, q]).testBit (idx t (ofEdge (normEdge b e g))) = false := by
    intro t g hgt hvt hgp hgq
    rw [hitMask_spec hgt _ hvt]
    simp only [hits, List.any_cons, List.any_nil, Bool.or_false, Bool.or_eq_false_iff,
      decide_eq_false_iff_not]
    exact ⟨fun h => hgp ((norm_eq_small g hp').mp h), fun h => hgq ((norm_eq_small g hq').mp h)⟩
  have hvb : ∀ v ∈ [p, q], v.2 ≤ b.get v.1 := by
    intro v hv; simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl <;> omega
  have hvt : ∀ v ∈ [p, q], v.2 ≤ (bumped b).get v.1 := by
    intro v hv
    have := hvb v hv
    have hle : b.get v.1 ≤ (bumped b).get v.1 := by
      match v.1 with
      | ⟨0, _⟩ => simp [bumped]
      | ⟨1, _⟩ => simp [bumped]
      | ⟨2, _⟩ => simp [bumped]
      | ⟨3, _⟩ => simp [bumped]
    omega
  -- e' is a key
  have eBit : (eMask b A [p, q]).testBit (idx b e') = true := by
    rw [eMask, testBit_diff, admE b e he eIn hAk, avoidS b e eIn hvb hep heq]; rfl
  have hk := congrArg (fun m => m.testBit (idx b e')) (beq_iff_eq.mp hkeys)
  simp only [testBit_diff, eBit, Bool.true_and, Nat.zero_testBit, Bool.not_eq_false'] at hk
  obtain ⟨g, hg, hge⟩ := keysMask_spec groups hk
  have hgOK := hgroups g hg
  simp only [groupOK, Bool.and_eq_true, beq_iff_eq] at hgOK
  obtain ⟨⟨hgIn, hgF⟩, hgM⟩ := hgOK
  have hgee : g.e = e' := idx_injective ((inBox_iff _ _).mp hgIn) eIn hge
  -- f' is a listed partner
  have fBit : (fMask b A [p, q] g.e).testBit (idx (bumped b) f') = true := by
    rw [hgee, fMask, Nat.testBit_and, testBit_diff, testBit_diff, testBit_diff,
      admE (bumped b) f hf fIn (fun a ha => known_bumped (hAk a ha)),
      avoidS (bumped b) f fIn hvt hfp hfq]
    simp only [Bool.not_false, Bool.true_and, Bool.and_eq_true, Bool.not_eq_true']
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · -- f' differs from e' in every part
      rw [hitMask_spec fIn]
      · simp only [hits, eVertices, List.any_cons, List.any_nil, Bool.or_false,
          Bool.or_eq_false_iff, decide_eq_false_iff_not]
        have key : ∀ i : Fin 4, f'.get i ≠ e'.get i := by
          intro i h
          rw [hf'def, he'def, norm_get, norm_get] at h
          have := lab_inj (hef i) (Or.inr (Or.inr rfl)) (Or.inr (Or.inl rfl)) h
          exact hef i this.symm
        exact ⟨key 0, key 1, key 2, key 3⟩
      · intro v hv
        simp only [eVertices, List.mem_cons, List.not_mem_nil, or_false] at hv
        obtain ⟨ea, eb, ec, ed⟩ := eIn
        rcases hv with rfl | rfl | rfl | rfl <;> simp [bumped] <;> omega
    · -- the second fresh label only where e is outside
      rw [hitMask_spec fIn]
      · simp only [hits, List.any_eq_false, decide_eq_true_eq]
        intro v hv hfv
        simp only [gapVertices, List.mem_append] at hv
        have gap : ∀ i : Fin 4, e'.get i < b.get i → f'.get i ≠ b.get i + 1 := by
          intro i hi
          rw [hf'def, norm_get]
          rw [he'def, norm_get] at hi
          have lab_lt_imp : ∀ (B E : ℕ), lab B E E < B → E < B := by
            intro B E h; unfold lab at h; split_ifs at h <;> omega
          have hei : e i < b.get i := lab_lt_imp _ _ hi
          exact lab_f_gap hei
        rcases hv with ((hv | hv) | hv) | hv <;> split at hv <;>
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hv <;> subst hv
        · exact gap 0 (by simpa using ‹e'.a < b.a›) (by simpa using hfv)
        · exact gap 1 (by simpa using ‹e'.b < b.b›) (by simpa using hfv)
        · exact gap 2 (by simpa using ‹e'.c < b.c›) (by simpa using hfv)
        · exact gap 3 (by simpa using ‹e'.d < b.d›) (by simpa using hfv)
      · intro v hv
        simp only [gapVertices, List.mem_append] at hv
        rcases hv with ((hv | hv) | hv) | hv <;> split at hv <;>
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hv <;> subst hv <;> simp [bumped]
    · -- every anchor missed by e' is met by f'
      rw [andAll_spec fIn]
      intro m hm'
      obtain ⟨a, haF, rfl⟩ := List.mem_map.mp hm'
      obtain ⟨haF, hna⟩ := List.mem_filter.mp haF
      simp only [Bool.not_eq_true'] at hna
      rw [meetMask_spec fIn (known_inBox (known_bumped (hAk a haF)))]
      have hh := ResidualCoordinates.two_hit_anchor h3 he hf (hAH a haF) hef
      rw [ResidualCoordinates.hits_iff, ResidualCoordinates.hits_iff, ← meets_norm (hAk a haF) e,
        ← meets_norm (hAk a haF) f] at hh
      rw [← he'def] at hh
      rw [hna] at hh
      simpa [hf'def] using hh
  have hf := congrArg (fun m => m.testBit (idx (bumped b) f')) hgF
  simp only [testBit_diff, fBit, Bool.true_and, Nat.zero_testBit, Bool.not_eq_false'] at hf
  obtain ⟨m, hm', hmf⟩ := membersMask_spec g.members hf
  have hmOK := List.all_eq_true.mp hgM m hm'
  simp only [Bool.and_eq_true] at hmOK
  obtain ⟨hmIn, hcheck⟩ := hmOK
  have hmff : m.f = f' := idx_injective ((inBox_iff _ _).mp hmIn) fIn hmf
  rw [hgee, hmff] at hcheck
  apply check_sound hcheck K hK
  intro a ha
  rcases List.mem_append.mp ha with ha | ha
  · exact hAK _ (List.mem_map.mpr ⟨a, ha, rfl⟩)
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl
    · rw [he'def, ofEdge_toEdge]; exact he'
    · rw [hf'def, ofEdge_toEdge]; exact hf'

/-- The seven frozen anchors as codes give actual edges of `H`. -/
theorem anchors_of_template {t : Fin 232} {A : List Code}
    (hA : A = (List.finRange 7).map (fun k => ofEdge (Theory.frozenTemplate t k)))
    (H : Finset NatEdge) (hF : ∀ k, Theory.frozenTemplate t k ∈ H) : ∀ a ∈ A, a.toEdge ∈ H := by
  intro a ha
  rw [hA] at ha
  obtain ⟨k, -, rfl⟩ := List.mem_map.mp ha
  rw [ofEdge_toEdge]
  exact hF k


end Ryser.Fast
end

/-! ## `Ryser.Light`: the certificate checker -/

/-!
# Light certificates

A kernel-efficient replacement for the per-row certificates of `Ryser.Fast`.

* Value masks of a trace box are read from a packed table (one GMP shift and mask) instead of
  being rebuilt by loops.
* The checker propagates the negative clauses ("no three pairwise disjoint traces occur") by
  itself, so a certificate lists only branching decisions and positive-clause hints.
* A positive hint names its clause; the kernel checks that the clause leaves at most one trace.
  If none is left the branch is closed; if one is left, the kernel locates it (a binary search
  whose result is checked) and propagates it.
-/

set_option maxRecDepth 100000
set_option autoImplicit false

namespace Ryser.Light
open Ryser Ryser.Fast FiniteBox

/-! Kernel-facing code calls `Nat.land` etc. directly; proofs rewrite them to the notation. -/
theorem land_eq (a b : ℕ) : Nat.land a b = a &&& b := rfl
theorem lor_eq (a b : ℕ) : Nat.lor a b = a ||| b := rfl
theorem xor_eq (a b : ℕ) : Nat.xor a b = a ^^^ b := rfl
theorem shiftRight_eq (a b : ℕ) : Nat.shiftRight a b = a >>> b := rfl
theorem shiftLeft_eq (a b : ℕ) : Nat.shiftLeft a b = a <<< b := rfl
theorem mul_eq' (a b : ℕ) : Nat.mul a b = a * b := rfl

/-! ## Packed tables -/

/-- Pack a list of masks, each cut to `w` bits, into one number. -/
def packL (w : ℕ) : List ℕ → ℕ
  | [] => 0
  | m :: ms => (m &&& (2 ^ w - 1)) ||| (packL w ms <<< w)

theorem testBit_packL (w : ℕ) (l : List ℕ) (k i : ℕ) (hi : i < w) :
    (packL w l).testBit (k * w + i) = (l.getD k 0).testBit i := by
  induction l generalizing k with
  | nil => simp [packL]
  | cons m ms ih =>
    cases k with
    | zero =>
      simp only [packL, Nat.testBit_or, Nat.testBit_and, Nat.testBit_two_pow_sub_one,
        Nat.testBit_shiftLeft, Nat.zero_mul, Nat.zero_add, List.getD_cons_zero]
      have h1 : ¬ w ≤ i := by omega
      simp [hi, h1]
    | succ k =>
      simp only [packL, Nat.testBit_or, Nat.testBit_and, Nat.testBit_two_pow_sub_one,
        Nat.testBit_shiftLeft, List.getD_cons_succ]
      have e1 : (k + 1) * w + i = k * w + i + w := by rw [Nat.succ_mul]; omega
      have h1 : ¬ ((k + 1) * w + i < w) := by rw [e1]; omega
      have h2 : w ≤ (k + 1) * w + i := by rw [e1]; omega
      have h3 : (k + 1) * w + i - w = k * w + i := by rw [e1]; omega
      simp [h1, h2, h3, ih]

/-- Offset of part `p` in the value table of the box `s` (values `0, …, s.get p`). -/
def off (s : Code) (p : ℕ) : ℕ :=
  cond (Nat.beq p 0) 0 (cond (Nat.beq p 1) (s.a + 1)
    (cond (Nat.beq p 2) (s.a + s.b + 2) (s.a + s.b + s.c + 3)))

/-- All value masks of the box, part by part. -/
def tblList (s : Code) : List ℕ :=
  (List.range (s.a + 1)).map (vmask s 0) ++ (List.range (s.b + 1)).map (vmask s 1) ++
    (List.range (s.c + 1)).map (vmask s 2) ++ (List.range (s.d + 1)).map (vmask s 3)

theorem getD_append_left' {l l' : List ℕ} {n : ℕ} (h : n < l.length) :
    (l ++ l').getD n 0 = l.getD n 0 := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_append_left h]

theorem getD_append_right' {l l' : List ℕ} {n : ℕ} (h : l.length ≤ n) :
    (l ++ l').getD n 0 = l'.getD (n - l.length) 0 := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_append_right h]

theorem getD_map_range {f : ℕ → ℕ} {n v : ℕ} (h : v < n) :
    ((List.range n).map f).getD v 0 = f v := by
  simp [List.getD_eq_getElem?_getD, h]

theorem tblList_getD (s : Code) (p : Fin 4) {v : ℕ} (hv : v ≤ s.get p) :
    (tblList s).getD (off s p.val + v) 0 = vmask s p v := by
  match p with
  | ⟨0, _⟩ =>
    replace hv : v ≤ s.a := hv
    simp only [tblList, off, Nat.beq_refl, Bool.cond_true, Nat.zero_add]
    rw [getD_append_left' (by simp; omega), getD_append_left' (by simp; omega),
      getD_append_left' (by simp; omega), getD_map_range (by omega)]
    rfl
  | ⟨1, _⟩ =>
    replace hv : v ≤ s.b := hv
    simp only [tblList, off, show Nat.beq 1 0 = false from rfl, Nat.beq_refl, Bool.cond_true, Bool.cond_false]
    rw [getD_append_left' (by simp; omega), getD_append_left' (by simp; omega),
      getD_append_right' (by simp), getD_map_range (by simp; omega)]
    simp
  | ⟨2, _⟩ =>
    replace hv : v ≤ s.c := hv
    simp only [tblList, off, show Nat.beq 2 0 = false from rfl, show Nat.beq 2 1 = false from rfl,
      Nat.beq_refl, Bool.cond_true, Bool.cond_false]
    rw [getD_append_left' (by simp; omega), getD_append_right' (by simp; omega)]
    simp only [List.length_append, List.length_map, List.length_range]
    rw [show s.a + s.b + 2 + v - (s.a + 1 + (s.b + 1)) = v by omega, getD_map_range (by omega)]
    rfl
  | ⟨3, _⟩ =>
    replace hv : v ≤ s.d := hv
    simp only [tblList, off, show Nat.beq 3 0 = false from rfl, show Nat.beq 3 1 = false from rfl,
      show Nat.beq 3 2 = false from rfl, Bool.cond_false]
    rw [getD_append_right' (by simp; omega)]
    simp only [List.length_append, List.length_map, List.length_range]
    rw [show s.a + s.b + s.c + 3 + v - (s.a + 1 + (s.b + 1) + (s.c + 1)) = v by omega,
      getD_map_range (by omega)]
    rfl

/-- The packed value table of a box. -/
def refTable (s : Code) : ℕ := packL (size s) (tblList s)

/-! ## Contexts -/

/-- Everything the checker needs about one box; `adm` is the admissible-trace mask. -/
structure Ctx where
  s : Code
  w : ℕ
  full : ℕ
  tbl : ℕ
  adm : ℕ

structure Ctx.Valid (C : Ctx) : Prop where
  w_eq : C.w = size C.s
  full_eq : C.full = 2 ^ C.w - 1
  tbl_eq : C.tbl = refTable C.s

/-- Bit test without typeclass detours (kernel friendly). -/
@[inline] def tb (m i : ℕ) : Bool := Nat.beq (Nat.land (Nat.shiftRight m i) 1) 1

theorem tb_eq (m i : ℕ) : tb m i = m.testBit i := by
  unfold tb
  rw [Nat.testBit, land_eq, shiftRight_eq, Nat.and_one_is_mod, Nat.one_and_eq_mod_two]
  rcases Nat.mod_two_eq_zero_or_one (m >>> i) with h | h <;> (simp [h]; try rfl)

/-- Table entry `k` (cut to the box). -/
@[inline] def Ctx.entry (C : Ctx) (k : ℕ) : ℕ := Nat.land (Nat.shiftRight C.tbl (Nat.mul k C.w)) C.full

/-- The value mask of part `p`, value `v`. -/
@[inline] def Ctx.vm (C : Ctx) (p v : ℕ) : ℕ := C.entry (off C.s p + v)

theorem Ctx.vm_spec {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) (p : Fin 4) {v : ℕ}
    (hv : v ≤ C.s.get p) : (C.vm p.val v).testBit (idx C.s y) = decide (y.get p = v) := by
  have hlt := idx_lt hy
  unfold Ctx.vm Ctx.entry
  rw [land_eq, shiftRight_eq, mul_eq', Nat.testBit_and, Nat.testBit_shiftRight, hC.full_eq,
    Nat.testBit_two_pow_sub_one, hC.tbl_eq, refTable, hC.w_eq,
    testBit_packL _ _ _ _ hlt, tblList_getD _ _ hv, vmask_spec hy p hv]
  simp [hlt]

theorem Ctx.vm0 {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) {v : ℕ} (hv : v ≤ C.s.a) :
    (C.vm 0 v).testBit (idx C.s y) = decide (y.a = v) := C.vm_spec hC hy 0 hv
theorem Ctx.vm1 {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) {v : ℕ} (hv : v ≤ C.s.b) :
    (C.vm 1 v).testBit (idx C.s y) = decide (y.b = v) := C.vm_spec hC hy 1 hv
theorem Ctx.vm2 {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) {v : ℕ} (hv : v ≤ C.s.c) :
    (C.vm 2 v).testBit (idx C.s y) = decide (y.c = v) := C.vm_spec hC hy 2 hv
theorem Ctx.vm3 {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) {v : ℕ} (hv : v ≤ C.s.d) :
    (C.vm 3 v).testBit (idx C.s y) = decide (y.d = v) := C.vm_spec hC hy 3 hv

theorem Ctx.vm_high {C : Ctx} (hC : C.Valid) (p v i : ℕ) (hi : C.w ≤ i) :
    (C.vm p v).testBit i = false := by
  unfold Ctx.vm Ctx.entry
  rw [land_eq, Nat.testBit_and, hC.full_eq, Nat.testBit_two_pow_sub_one]
  simp; omega

/-- Traces meeting `x` in some part (the fresh value counts as a vertex). -/
def Ctx.meetC (C : Ctx) (x : Code) : ℕ :=
  Nat.lor (Nat.lor (C.vm 0 x.a) (C.vm 1 x.b)) (Nat.lor (C.vm 2 x.c) (C.vm 3 x.d))

theorem Ctx.meetC_spec {C : Ctx} (hC : C.Valid) {x y : Code} (hx : InBox C.s x)
    (hy : InBox C.s y) : (C.meetC x).testBit (idx C.s y) = Fast.meets y x := by
  obtain ⟨xa, xb, xc, xd⟩ := hx
  simp only [Ctx.meetC, lor_eq, Nat.testBit_or]
  rw [C.vm0 hC hy xa, C.vm1 hC hy xb, C.vm2 hC hy xc, C.vm3 hC hy xd]
  simp [Fast.meets, Bool.or_assoc]

/-- The admissible-trace mask computed from the table. -/
def andAllC (full : ℕ) : List ℕ → ℕ
  | [] => full
  | m :: ms => Nat.land m (andAllC full ms)

def admC (C : Ctx) (F : List Code) : ℕ :=
  andAllC C.full ((disjointPairs F).map fun q => Nat.lor (C.meetC q.1) (C.meetC q.2))

theorem admC_spec {C : Ctx} (hC : C.Valid) {F : List Code} (hF : ∀ a ∈ F, known C.s a = true)
    {y : Code} (hy : InBox C.s y) :
    (admC C F).testBit (idx C.s y) = (admMask C.s F).testBit (idx C.s y) := by
  unfold admC admMask
  simp only [lor_eq]
  generalize hL : disjointPairs F = L
  have hmem : ∀ q ∈ L, q.1 ∈ F ∧ q.2 ∈ F := by
    intro q hq; rw [← hL] at hq; exact ⟨(mem_disjointPairs hq).1, (mem_disjointPairs hq).2.1⟩
  clear hL
  induction L with
  | nil =>
    simp only [List.map_nil, andAllC, andAll, full, hC.full_eq, hC.w_eq]
  | cons q L ih =>
    simp only [List.map_cons, andAllC, andAll, land_eq, Nat.testBit_and, Nat.testBit_or]
    rw [ih (fun q' hq' => hmem q' (List.mem_cons_of_mem _ hq')),
      C.meetC_spec hC (known_inBox (hF _ (hmem q (List.mem_cons_self ..)).1)) hy,
      C.meetC_spec hC (known_inBox (hF _ (hmem q (List.mem_cons_self ..)).2)) hy,
      meetMask_spec hy (known_inBox (hF _ (hmem q (List.mem_cons_self ..)).1)),
      meetMask_spec hy (known_inBox (hF _ (hmem q (List.mem_cons_self ..)).2))]

/-! ## Hint vertices -/

/-- The part of a table index vertex field `x = p + 4 v`. -/
@[inline] def partOK (s : Code) (p v : ℕ) : Bool :=
  cond (Nat.beq p 0) (Nat.blt v s.a) (cond (Nat.beq p 1) (Nat.blt v s.b)
    (cond (Nat.beq p 2) (Nat.blt v s.c) (Nat.blt v s.d)))

/-- The five vertices of a cover hint, 6 bits each (`p + 4 v`). -/
def hintList (h : ℕ) : List (Fin 4 × ℕ) :=
  [(⟨h % 4, Nat.mod_lt _ (by decide)⟩, h / 4 % 16),
   (⟨h / 64 % 4, Nat.mod_lt _ (by decide)⟩, h / 256 % 16),
   (⟨h / 4096 % 4, Nat.mod_lt _ (by decide)⟩, h / 16384 % 16),
   (⟨h / 262144 % 4, Nat.mod_lt _ (by decide)⟩, h / 1048576 % 16),
   (⟨h / 16777216 % 4, Nat.mod_lt _ (by decide)⟩, h / 67108864 % 16)]

def hit5 (C : Ctx) (h : ℕ) : ℕ :=
  Nat.lor (Nat.lor (C.vm (h % 4) (h / 4 % 16)) (C.vm (h / 64 % 4) (h / 256 % 16)))
    (Nat.lor (Nat.lor (C.vm (h / 4096 % 4) (h / 16384 % 16)) (C.vm (h / 262144 % 4) (h / 1048576 % 16)))
      (C.vm (h / 16777216 % 4) (h / 67108864 % 16)))

def vok5 (s : Code) (h : ℕ) : Bool :=
  partOK s (h % 4) (h / 4 % 16) && partOK s (h / 64 % 4) (h / 256 % 16) &&
    partOK s (h / 4096 % 4) (h / 16384 % 16) && partOK s (h / 262144 % 4) (h / 1048576 % 16) &&
      partOK s (h / 16777216 % 4) (h / 67108864 % 16)

theorem partOK_spec' (s : Code) (p : ℕ) (hp : p < 4) (v : ℕ) :
    partOK s p v = vertexOK s (⟨p, hp⟩, v) := by
  match p, hp with
  | 0, _ => simp [partOK, vertexOK]; rfl
  | 1, _ => simp [partOK, vertexOK]; rfl
  | 2, _ => simp [partOK, vertexOK]; rfl
  | 3, _ => simp [partOK, vertexOK]; rfl

theorem partOK_spec (s : Code) (p : Fin 4) (v : ℕ) : partOK s p.val v = vertexOK s (p, v) := by
  match p with
  | ⟨0, _⟩ => simp [partOK, vertexOK]; rfl
  | ⟨1, _⟩ => simp [partOK, vertexOK]; rfl
  | ⟨2, _⟩ => simp [partOK, vertexOK]; rfl
  | ⟨3, _⟩ => simp [partOK, vertexOK]; rfl

theorem vok5_spec (s : Code) (h : ℕ) : vok5 s h = (hintList h).all (vertexOK s) := by
  simp only [vok5, hintList, List.all_cons, List.all_nil, Bool.and_true]
  rw [← partOK_spec, ← partOK_spec, ← partOK_spec, ← partOK_spec, ← partOK_spec]
  simp [Bool.and_assoc]

theorem Ctx.vmF_spec {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) (q : Fin 4 × ℕ)
    (hq : vertexOK C.s q = true) :
    (C.vm q.1.val q.2).testBit (idx C.s y) = (vmask C.s q.1 q.2).testBit (idx C.s y) := by
  have hv : q.2 ≤ C.s.get q.1 := by simp [vertexOK] at hq; omega
  rw [C.vm_spec hC hy q.1 hv, vmask_spec hy q.1 hv]

theorem hit5_spec {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) {h : ℕ}
    (hv : vok5 C.s h = true) :
    (hit5 C h).testBit (idx C.s y) = (hitMask C.s (hintList h)).testBit (idx C.s y) := by
  rw [vok5_spec] at hv
  have hall := List.all_eq_true.mp hv
  have h1 := hall (⟨h % 4, Nat.mod_lt _ (by decide)⟩, h / 4 % 16) (by simp [hintList])
  have h2 := hall (⟨h / 64 % 4, Nat.mod_lt _ (by decide)⟩, h / 256 % 16) (by simp [hintList])
  have h3 := hall (⟨h / 4096 % 4, Nat.mod_lt _ (by decide)⟩, h / 16384 % 16) (by simp [hintList])
  have h4 := hall (⟨h / 262144 % 4, Nat.mod_lt _ (by decide)⟩, h / 1048576 % 16) (by simp [hintList])
  have h5 := hall (⟨h / 16777216 % 4, Nat.mod_lt _ (by decide)⟩, h / 67108864 % 16) (by simp [hintList])
  simp only [hit5, hintList, hitMask, lor_eq, Nat.testBit_or, Nat.zero_testBit, Bool.or_false]
  rw [C.vmF_spec hC hy _ h1, C.vmF_spec hC hy _ h2, C.vmF_spec hC hy _ h3, C.vmF_spec hC hy _ h4,
    C.vmF_spec hC hy _ h5]
  simp [Bool.or_assoc]

/-! ## Negative propagation -/

/-- Admissible traces disjoint (in every part, fresh value included) from trace `x`. -/
def Ctx.D (C : Ctx) (x : ℕ) : ℕ := Nat.land C.adm (Nat.xor C.full (C.meetC (decode C.s x)))

/-- Union of the stored masks that contain `x`. -/
def accU (x : ℕ) : List (ℕ × ℕ) → ℕ → ℕ
  | [], acc => acc
  | q :: rest, acc => accU x rest (cond (tb q.2 x) (Nat.lor acc q.2) acc)

theorem accU_spec (x i : ℕ) : ∀ (l : List (ℕ × ℕ)) (acc : ℕ),
    (accU x l acc).testBit i = true →
      acc.testBit i = true ∨ ∃ q ∈ l, q.2.testBit x = true ∧ q.2.testBit i = true
  | [], acc, h => Or.inl h
  | q :: rest, acc, h => by
    rcases accU_spec x i rest _ h with h' | ⟨q', hq', h1, h2⟩
    · cases hb : tb q.2 x
      · rw [hb] at h'; exact Or.inl h'
      · rw [hb] at h'
        simp only [Bool.cond_true, lor_eq, Nat.testBit_or, Bool.or_eq_true] at h'
        rcases h' with h' | h'
        · exact Or.inl h'
        · exact Or.inr ⟨q, List.mem_cons_self .., by rw [← tb_eq]; exact hb, h'⟩
    · exact Or.inr ⟨q', List.mem_cons_of_mem _ hq', h1, h2⟩

structure St where
  Fm : ℕ
  forb : ℕ
  Tl : List (ℕ × ℕ)

def addTrue (C : Ctx) (st : St) (x : ℕ) : St :=
  let dx := C.D x
  ⟨st.Fm, Nat.lor st.forb (Nat.land dx (accU x st.Tl 0)), (x, dx) :: st.Tl⟩

/-- The assumptions about a counterexample `K` for the family `F` in the box of `C`. -/
structure Env (C : Ctx) (F : List Code) (K : Finset NatEdge) : Prop where
  valid : C.Valid
  adm : C.adm = admC C F
  setting : Setting C.s F K

/-- What a state asserts: assumed-false and forbidden traces do not occur, stored traces do. -/
structure Good (C : Ctx) (K : Finset NatEdge) (st : St) : Prop where
  fm : ∀ i, st.Fm.testBit i = true → ¬ Occ C.s K i
  forb : ∀ i, st.forb.testBit i = true → ¬ Occ C.s K i
  tl : ∀ q ∈ st.Tl, Occ C.s K q.1 ∧ q.2 = C.D q.1

theorem D_bit {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K) {g h : NatEdge}
    (hb : (C.D (idx C.s (enc C.s g))).testBit (idx C.s (enc C.s h)) = true) :
    Fast.meets (enc C.s h) (enc C.s g) = false := by
  have hC := hE.valid
  unfold Ctx.D at hb
  rw [land_eq, xor_eq, Nat.testBit_and, Nat.testBit_xor, decode_idx (enc_inBox _ g),
    C.meetC_spec hC (enc_inBox _ g) (enc_inBox _ h), hC.full_eq, Nat.testBit_two_pow_sub_one,
    hC.w_eq] at hb
  have hlt := idx_lt (enc_inBox C.s h)
  simp only [hlt, decide_true, Bool.true_xor, Bool.and_eq_true, Bool.not_eq_true'] at hb
  exact hb.2

theorem meets_comm' (x y : Code) : Fast.meets x y = Fast.meets y x := by
  simp only [Fast.meets, eq_comm]

theorem addTrue_good {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K) {st : St}
    (hg : Good C K st) {x : ℕ} (hx : Occ C.s K x) : Good C K (addTrue C st x) := by
  refine ⟨hg.fm, ?_, ?_⟩
  · intro i hi hoi
    simp only [addTrue, lor_eq, land_eq, Nat.testBit_or, Nat.testBit_and, Bool.or_eq_true,
      Bool.and_eq_true] at hi
    rcases hi with hi | ⟨hdi, hacc⟩
    · exact hg.forb i hi hoi
    · rcases accU_spec x i st.Tl 0 hacc with h0 | ⟨q, hq, hqx, hqi⟩
      · simp at h0
      · obtain ⟨hoq, hqD⟩ := hg.tl q hq
        rw [hqD] at hqx hqi
        obtain ⟨g1, hg1, rfl⟩ := hx
        obtain ⟨g2, hg2, e2⟩ := hoq
        obtain ⟨g3, hg3, rfl⟩ := hoi
        rw [← e2] at hqx hqi
        have d12 := D_bit hE hqx   -- meets (enc g1) (enc g2) = false
        have d32 := D_bit hE hqi   -- meets (enc g3) (enc g2) = false
        have d31 := D_bit hE hdi   -- meets (enc g3) (enc g1) = false
        exact hE.setting.noThree g1 hg1 g2 hg2 g3 hg3 (disjoint_of_enc d12)
          (disjoint_of_enc (by rw [meets_comm']; exact d31))
          (disjoint_of_enc (by rw [meets_comm']; exact d32))
  · intro q hq
    rcases List.mem_cons.mp hq with rfl | hq
    · exact ⟨hx, rfl⟩
    · exact hg.tl q hq

/-! ## The certificate interpreter -/

/-- Exponent of a power of two below `2 ^ 14`, by binary search (an oracle: results are checked). -/
def bitPos (m : ℕ) : ℕ :=
  let a := cond (Nat.ble (2 ^ 8192) m) 8192 0
  let a := cond (Nat.ble (2 ^ (a + 4096)) m) (a + 4096) a
  let a := cond (Nat.ble (2 ^ (a + 2048)) m) (a + 2048) a
  let a := cond (Nat.ble (2 ^ (a + 1024)) m) (a + 1024) a
  let a := cond (Nat.ble (2 ^ (a + 512)) m) (a + 512) a
  let a := cond (Nat.ble (2 ^ (a + 256)) m) (a + 256) a
  let a := cond (Nat.ble (2 ^ (a + 128)) m) (a + 128) a
  let a := cond (Nat.ble (2 ^ (a + 64)) m) (a + 64) a
  let a := cond (Nat.ble (2 ^ (a + 32)) m) (a + 32) a
  let a := cond (Nat.ble (2 ^ (a + 16)) m) (a + 16) a
  let a := cond (Nat.ble (2 ^ (a + 8)) m) (a + 8) a
  let a := cond (Nat.ble (2 ^ (a + 4)) m) (a + 4) a
  let a := cond (Nat.ble (2 ^ (a + 2)) m) (a + 2) a
  cond (Nat.ble (2 ^ (a + 1)) m) (a + 1) a

/-- Read one certificate item.  Tags (two bits): `0` cover hint with its forced trace, `1` cover
hint closing the branch, `2` decision on a trace, `3` residual-clause hint. -/
def run (C : Ctx) (R : List ℕ) (w : ℕ) : ℕ → St → ℕ → Option ℕ
  | 0, _, _ => none
  | fuel + 1, st, str =>
    let tag := str % 4
    let str := str / 4
    let mask := Nat.xor C.full (Nat.lor st.Fm st.forb)
    cond (Nat.beq tag 2)
      (match run C R w fuel (addTrue C st (str % 2 ^ w)) (str / 2 ^ w) with
       | none => none
       | some str' => run C R w fuel ⟨Nat.lor st.Fm (2 ^ (str % 2 ^ w)), st.forb, st.Tl⟩ str')
      (cond (Nat.beq tag 3)
        (cond (Nat.blt (str % 16) R.length)
          (cond (Nat.beq (str / 16 % 2) 0)
            (cond (Nat.beq (Nat.land (R.getD (str % 16) 0) mask) 0) (some (str / 32)) none)
            (cond (Nat.beq (Nat.land (R.getD (str % 16) 0) mask) (2 ^ bitPos (Nat.land (R.getD (str % 16) 0) mask)))
              (run C R w fuel (addTrue C st (bitPos (Nat.land (R.getD (str % 16) 0) mask))) (str / 32)) none))
          none)
        (cond (vok5 C.s (str % 1073741824))
          (cond (Nat.beq tag 1)
            (cond (Nat.beq (Nat.land (Nat.land C.adm (Nat.xor C.full (hit5 C (str % 1073741824))))
                mask) 0)
              (some (str / 1073741824)) none)
            (cond (Nat.beq (Nat.land (Nat.land C.adm (Nat.xor C.full (hit5 C (str % 1073741824))))
                mask) (2 ^ bitPos (Nat.land (Nat.land C.adm (Nat.xor C.full (hit5 C (str % 1073741824)))) mask)))
              (run C R w fuel (addTrue C st (bitPos (Nat.land (Nat.land C.adm (Nat.xor C.full
                (hit5 C (str % 1073741824)))) mask))) (str / 1073741824))
              none))
          none))

theorem witness_bit {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K) {st : St}
    (hg : Good C K st) {W i : ℕ} (hw : W.testBit i = true) (hoi : Occ C.s K i) :
    (Nat.land W (Nat.xor C.full (Nat.lor st.Fm st.forb))).testBit i = true := by
  have hlt : i < C.w := by
    obtain ⟨g, -, rfl⟩ := hoi; rw [hE.valid.w_eq]; exact idx_lt (enc_inBox _ g)
  have hfm : st.Fm.testBit i = false := by
    cases hb : st.Fm.testBit i
    · rfl
    · exact absurd hoi (hg.fm i hb)
  have hfo : st.forb.testBit i = false := by
    cases hb : st.forb.testBit i
    · rfl
    · exact absurd hoi (hg.forb i hb)
  rw [land_eq, xor_eq, lor_eq, Nat.testBit_and, Nat.testBit_xor, Nat.testBit_or, hE.valid.full_eq,
    Nat.testBit_two_pow_sub_one, hw, hfm, hfo]
  simp [hlt]

theorem eq_zero_contra {U i : ℕ} (h : Nat.beq U 0 = true) (hb : U.testBit i = true) : False := by
  rw [Nat.beq_eq] at h; subst h; simp at hb

theorem eq_pow_occ {U x i : ℕ} (h : Nat.beq U (2 ^ x) = true) (hb : U.testBit i = true) : i = x := by
  rw [Nat.beq_eq] at h; subst h; rw [Nat.testBit_two_pow] at hb; simpa [eq_comm] using hb

theorem cover_witness {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K)
    (notCover : ¬ CoverAtMost K 5) {h : ℕ} (hv : vok5 C.s h = true) :
    ∃ i, (Nat.land C.adm (Nat.xor C.full (hit5 C h))).testBit i = true ∧ Occ C.s K i := by
  have hC := hE.valid
  have hlen : (hintList h).length ≤ 5 := by simp [hintList]
  obtain ⟨i, hi, hoi⟩ := cover_clause hE.setting notCover hlen (by rw [← vok5_spec]; exact hv)
  refine ⟨i, ?_, hoi⟩
  obtain ⟨g, -, rfl⟩ := hoi
  have hy := enc_inBox C.s g
  rw [testBit_diff, Bool.and_eq_true, Bool.not_eq_true'] at hi
  rw [land_eq, xor_eq, Nat.testBit_and, Nat.testBit_xor, hE.adm,
    admC_spec hC (fun a ha => hE.setting.known a ha) hy, hit5_spec hC hy hv, hi.1, hi.2,
    hC.full_eq, hC.w_eq, Nat.testBit_two_pow_sub_one]
  simp [idx_lt hy]

theorem run_sound {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K)
    (notCover : ¬ CoverAtMost K 5) {R : List ℕ}
    (hR : ∀ W ∈ R, ∃ i, W.testBit i = true ∧ Occ C.s K i) {w : ℕ} :
    ∀ fuel st str str', Good C K st → run C R w fuel st str = some str' → False := by
  intro fuel
  induction fuel with
  | zero => intro st str str' _ h; simp [run] at h
  | succ fuel ih =>
    intro st str str' hg h
    simp only [run] at h
    generalize hmask : Nat.xor C.full (Nat.lor st.Fm st.forb) = mask at h
    cases htag2 : Nat.beq (str % 4) 2
    · rw [htag2, Bool.cond_false] at h
      cases htag3 : Nat.beq (str % 4) 3
      · -- cover hint
        rw [htag3, Bool.cond_false] at h
        cases hv : vok5 C.s (str / 4 % 1073741824)
        · rw [hv, Bool.cond_false] at h; simp at h
        rw [hv, Bool.cond_true] at h
        obtain ⟨i, hi, hoi⟩ := cover_witness hE notCover hv
        have hU := witness_bit hE hg hi hoi
        rw [hmask] at hU
        cases htag1 : Nat.beq (str % 4) 1
        · rw [htag1, Bool.cond_false] at h
          generalize hUU : Nat.land (Nat.land C.adm (Nat.xor C.full (hit5 C (str / 4 % 1073741824)))) mask = U at h hU
          cases hb : Nat.beq U (2 ^ bitPos U)
          · rw [hb, Bool.cond_false] at h; simp at h
          · rw [hb, Bool.cond_true] at h
            have hix := eq_pow_occ hb hU
            exact ih _ _ _ (addTrue_good hE hg (hix ▸ hoi)) h
        · rw [htag1, Bool.cond_true] at h
          cases hb : Nat.beq (Nat.land (Nat.land C.adm (Nat.xor C.full (hit5 C (str / 4 % 1073741824))))
              mask) 0
          · rw [hb, Bool.cond_false] at h; simp at h
          · exact eq_zero_contra hb hU
      · -- residual hint
        rw [htag3, Bool.cond_true] at h
        cases hk : Nat.blt (str / 4 % 16) R.length
        · rw [hk, Bool.cond_false] at h; simp at h
        rw [hk, Bool.cond_true] at h
        have hkl : str / 4 % 16 < R.length := by simpa [Nat.blt_eq] using hk
        have hmem : R.getD (str / 4 % 16) 0 ∈ R := by
          rw [List.getD_eq_getElem _ _ hkl]; exact List.getElem_mem hkl
        obtain ⟨i, hi, hoi⟩ := hR _ hmem
        have hU := witness_bit hE hg hi hoi
        rw [hmask] at hU
        cases hu : Nat.beq (str / 4 / 16 % 2) 0
        · rw [hu, Bool.cond_false] at h
          generalize hUU : Nat.land (R.getD (str / 4 % 16) 0) mask = U at h hU
          cases hb : Nat.beq U (2 ^ bitPos U)
          · rw [hb, Bool.cond_false] at h; simp at h
          · rw [hb, Bool.cond_true] at h
            have hix := eq_pow_occ hb hU
            exact ih _ _ _ (addTrue_good hE hg (hix ▸ hoi)) h
        · rw [hu, Bool.cond_true] at h
          cases hb : Nat.beq (Nat.land (R.getD (str / 4 % 16) 0) mask) 0
          · rw [hb, Bool.cond_false] at h; simp at h
          · exact eq_zero_contra hb hU
    · -- decision
      rw [htag2, Bool.cond_true] at h
      generalize hx : str / 4 % 2 ^ w = x at h
      by_cases hox : Occ C.s K x
      · cases hr : run C R w fuel (addTrue C st x) (str / 4 / 2 ^ w) with
        | none => simp [hr] at h
        | some s1 => exact ih _ _ _ (addTrue_good hE hg hox) hr
      · cases hr : run C R w fuel (addTrue C st x) (str / 4 / 2 ^ w) with
        | none => simp [hr] at h
        | some s1 =>
          simp only [hr] at h
          refine ih ⟨Nat.lor st.Fm (2 ^ x), st.forb, st.Tl⟩ _ _ ⟨?_, hg.forb, hg.tl⟩ h
          intro i hi hoi
          rw [lor_eq, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
          rcases hi with hi | rfl
          · exact hg.fm i hi hoi
          · exact hox hoi

/-! ## Checking one anchored family -/

def mkCtx (s : Code) (tbl : ℕ) (F : List Code) : Ctx :=
  ⟨s, size s, 2 ^ size s - 1, tbl, admC ⟨s, size s, 2 ^ size s - 1, tbl, 0⟩ F⟩

@[simp] theorem mkCtx_s (s : Code) (tbl : ℕ) (F : List Code) : (mkCtx s tbl F).s = s := rfl

def initSt (C : Ctx) (F : List Code) : St := F.foldl (fun st a => addTrue C st (idx C.s a)) ⟨0, 0, []⟩

/-- Accepting a light certificate for the anchors `F` in the box `s` with value table `tbl`. -/
def lcheck (s : Code) (tbl : ℕ) (F : List Code) (R : List ℕ) (w fuel str : ℕ) : Bool :=
  F.all (known s) && (run (mkCtx s tbl F) R w fuel (initSt (mkCtx s tbl F) F) str).isSome

theorem initSt_good {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K) :
    Good C K (initSt C F) := by
  unfold initSt
  have key : ∀ (l : List Code) (st : St), (∀ a ∈ l, a ∈ F) → Good C K st →
      Good C K (l.foldl (fun st a => addTrue C st (idx C.s a)) st) := by
    intro l
    induction l with
    | nil => intro st _ hg; exact hg
    | cons a l ih =>
      intro st hl hg
      exact ih _ (fun b hb => hl b (List.mem_cons_of_mem _ hb))
        (addTrue_good hE hg (occ_anchor hE.setting (hl a (List.mem_cons_self ..))))
  exact key F _ (fun a ha => ha) ⟨by simp, by simp, by simp⟩

theorem lcheck_sound {s : Code} {tbl : ℕ} (htbl : tbl = refTable s) {F : List Code}
    {R : List ℕ} {w fuel str : ℕ} (h : lcheck s tbl F R w fuel str = true)
    (hR : ∀ K, Setting s F K → ¬ CoverAtMost K 5 → ∀ W ∈ R, ∃ i, W.testBit i = true ∧ Occ s K i)
    (K : Finset NatEdge) (hK : MatchingAtMost K 2) (hF : ∀ a ∈ F, a.toEdge ∈ K) :
    CoverAtMost K 5 := by
  simp only [lcheck, Bool.and_eq_true, Option.isSome_iff_exists] at h
  obtain ⟨hknown, str', hrun⟩ := h
  by_contra notCover
  have hS : Setting s F K :=
    ⟨matchingAtMost_two_noThree hK, fun a ha => List.all_eq_true.mp hknown a ha, hF⟩
  have hE : Env (mkCtx s tbl F) F K := ⟨⟨rfl, rfl, htbl⟩, rfl, hS⟩
  exact run_sound hE notCover (hR K hS notCover) _ _ _ _ (initSt_good hE) hrun

/-! ## Residual clauses

A residual clause `(S, W)` with `|S| ≤ 2` says: some trace of `W` occurs.  It is justified when
no two remaining traces (admissible, avoiding `S`, outside `W`) can be the traces of two disjoint
edges: then the edges avoiding `S` form an intersecting family, which has a three-cover, and `S`
adds at most two more vertices. -/

def hitS (C : Ctx) : List (ℕ × ℕ) → ℕ
  | [] => 0
  | q :: rest => Nat.lor (C.vm (q.1 % 4) q.2) (hitS C rest)

def finS (S : List (ℕ × ℕ)) : List (Fin 4 × ℕ) :=
  S.map fun q => (⟨q.1 % 4, Nat.mod_lt _ (by decide)⟩, q.2)

def sOK (s : Code) (S : List (ℕ × ℕ)) : Bool :=
  Nat.ble S.length 2 && S.all fun q => partOK s (q.1 % 4) q.2

theorem sOK_parts {s : Code} {S : List (ℕ × ℕ)} (h : sOK s S = true) :
    ∀ q ∈ S, vertexOK s (⟨q.1 % 4, Nat.mod_lt _ (by decide)⟩, q.2) = true := by
  simp only [sOK, Bool.and_eq_true, List.all_eq_true] at h
  intro q hq
  rw [← partOK_spec']; exact h.2 q hq

theorem sOK_vertex {s : Code} {S : List (ℕ × ℕ)} (h : sOK s S = true) :
    (finS S).all (vertexOK s) = true := by
  rw [List.all_eq_true]
  intro q hq
  obtain ⟨q', hq', rfl⟩ := List.mem_map.mp hq
  exact sOK_parts h q' hq'

theorem hitS_spec {C : Ctx} (hC : C.Valid) {y : Code} (hy : InBox C.s y) :
    ∀ (S : List (ℕ × ℕ)), (∀ q ∈ S, vertexOK C.s (⟨q.1 % 4, Nat.mod_lt _ (by decide)⟩, q.2) = true) →
      (hitS C S).testBit (idx C.s y) = (hitMask C.s (finS S)).testBit (idx C.s y)
  | [], _ => by simp [hitS, finS, hitMask]
  | q :: rest, hq => by
    simp only [hitS, finS, List.map_cons, hitMask, lor_eq, Nat.testBit_or]
    have hrest := hitS_spec hC hy rest (fun q' hq' => hq q' (List.mem_cons_of_mem _ hq'))
    simp only [finS] at hrest
    rw [hrest, C.vmF_spec hC hy (⟨q.1 % 4, Nat.mod_lt _ (by decide)⟩, q.2) (hq q (List.mem_cons_self ..))]

/-- Traces differing from `x` in every known label of `x`. -/
def avoidKnownC (C : Ctx) (x : Code) : ℕ :=
  Nat.xor C.full (Nat.lor (Nat.lor (cond (Nat.blt x.a C.s.a) (C.vm 0 x.a) 0)
      (cond (Nat.blt x.b C.s.b) (C.vm 1 x.b) 0))
    (Nat.lor (cond (Nat.blt x.c C.s.c) (C.vm 2 x.c) 0) (cond (Nat.blt x.d C.s.d) (C.vm 3 x.d) 0)))

def partnerC (C : Ctx) (F : List Code) (x : Code) : ℕ :=
  Nat.land (avoidKnownC C x) (andAllC C.full ((F.filter fun a => !Fast.meets x a).map fun a => C.meetC a))

theorem avoidKnownC_spec {C : Ctx} (hC : C.Valid) {x y : Code} (hx : InBox C.s x)
    (hy : InBox C.s y) :
    (avoidKnownC C x).testBit (idx C.s y) = true ↔ ∀ i, x.get i < C.s.get i → y.get i ≠ x.get i := by
  rw [← avoidKnown_spec hx hy]
  obtain ⟨xa, xb, xc, xd⟩ := hx
  have hlt := idx_lt hy
  have c0 : (cond (Nat.blt x.a C.s.a) (C.vm 0 x.a) 0).testBit (idx C.s y) =
      (if x.a < C.s.a then vmask C.s 0 x.a else 0).testBit (idx C.s y) := by
    by_cases h : x.a < C.s.a
    · have hb : Nat.blt x.a C.s.a = true := by simpa [Nat.blt_eq] using h
      simp only [h, ↓reduceIte, hb, Bool.cond_true]
      rw [C.vm0 hC hy xa, vmask_spec hy 0 xa]; rfl
    · have hb : Nat.blt x.a C.s.a = false := by
        cases hh : Nat.blt x.a C.s.a
        · rfl
        · simp [Nat.blt_eq] at hh; omega
      simp [h, hb]
  have c1 : (cond (Nat.blt x.b C.s.b) (C.vm 1 x.b) 0).testBit (idx C.s y) =
      (if x.b < C.s.b then vmask C.s 1 x.b else 0).testBit (idx C.s y) := by
    by_cases h : x.b < C.s.b
    · have hb : Nat.blt x.b C.s.b = true := by simpa [Nat.blt_eq] using h
      simp only [h, ↓reduceIte, hb, Bool.cond_true]
      rw [C.vm1 hC hy xb, vmask_spec hy 1 xb]; rfl
    · have hb : Nat.blt x.b C.s.b = false := by
        cases hh : Nat.blt x.b C.s.b
        · rfl
        · simp [Nat.blt_eq] at hh; omega
      simp [h, hb]
  have c2 : (cond (Nat.blt x.c C.s.c) (C.vm 2 x.c) 0).testBit (idx C.s y) =
      (if x.c < C.s.c then vmask C.s 2 x.c else 0).testBit (idx C.s y) := by
    by_cases h : x.c < C.s.c
    · have hb : Nat.blt x.c C.s.c = true := by simpa [Nat.blt_eq] using h
      simp only [h, ↓reduceIte, hb, Bool.cond_true]
      rw [C.vm2 hC hy xc, vmask_spec hy 2 xc]; rfl
    · have hb : Nat.blt x.c C.s.c = false := by
        cases hh : Nat.blt x.c C.s.c
        · rfl
        · simp [Nat.blt_eq] at hh; omega
      simp [h, hb]
  have c3 : (cond (Nat.blt x.d C.s.d) (C.vm 3 x.d) 0).testBit (idx C.s y) =
      (if x.d < C.s.d then vmask C.s 3 x.d else 0).testBit (idx C.s y) := by
    by_cases h : x.d < C.s.d
    · have hb : Nat.blt x.d C.s.d = true := by simpa [Nat.blt_eq] using h
      simp only [h, ↓reduceIte, hb, Bool.cond_true]
      rw [C.vm3 hC hy xd, vmask_spec hy 3 xd]; rfl
    · have hb : Nat.blt x.d C.s.d = false := by
        cases hh : Nat.blt x.d C.s.d
        · rfl
        · simp [Nat.blt_eq] at hh; omega
      simp [h, hb]
  simp only [avoidKnownC, avoidKnown, xor_eq, lor_eq, Nat.testBit_xor, Nat.testBit_or, testBit_diff,
    c0, c1, c2, c3, full, hC.full_eq, hC.w_eq, Nat.testBit_two_pow_sub_one, hlt, decide_true]
  cases (if x.a < C.s.a then vmask C.s 0 x.a else 0).testBit (idx C.s y) <;>
  cases (if x.b < C.s.b then vmask C.s 1 x.b else 0).testBit (idx C.s y) <;>
  cases (if x.c < C.s.c then vmask C.s 2 x.c else 0).testBit (idx C.s y) <;>
  cases (if x.d < C.s.d then vmask C.s 3 x.d else 0).testBit (idx C.s y) <;> rfl

/-- `f i` holds for every `i < n`. -/
def allBelow (f : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => f n && allBelow f n

theorem allBelow_spec {f : ℕ → Bool} : ∀ {n i : ℕ}, allBelow f n = true → i < n → f i = true
  | 0, _, _, hi => absurd hi (Nat.not_lt_zero _)
  | n + 1, i, h, hi => by
    simp only [allBelow, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact allBelow_spec h.2 hi
    · exact h.1

/-- Acceptance of a residual clause `(S, W)`. -/
def resOK (C : Ctx) (F : List Code) (S : List (ℕ × ℕ)) (W : ℕ) : Bool :=
  let Rm := Nat.land (Nat.land C.adm (Nat.xor C.full (hitS C S))) (Nat.xor C.full W)
  sOK C.s S && allBelow (fun i => !tb Rm i || Nat.beq (Nat.land (partnerC C F (decode C.s i)) Rm) 0) C.w

theorem resOK_sound {C : Ctx} {F : List Code} {K : Finset NatEdge} (hE : Env C F K)
    (notCover : ¬ CoverAtMost K 5) {S : List (ℕ × ℕ)} {W : ℕ} (hr : resOK C F S W = true) :
    ∃ i, W.testBit i = true ∧ Occ C.s K i := by
  classical
  have hC := hE.valid
  have hS := hE.setting
  simp only [resOK, Bool.and_eq_true] at hr
  obtain ⟨hsok, hall⟩ := hr
  generalize hRm : Nat.land (Nat.land C.adm (Nat.xor C.full (hitS C S))) (Nat.xor C.full W) = Rm at hall
  by_contra hno
  simp only [not_exists, not_and] at hno
  have hv := sOK_vertex hsok
  have inR : ∀ g ∈ K, (∀ q ∈ finS S, g q.1 ≠ q.2) → Rm.testBit (idx C.s (enc C.s g)) = true := by
    intro g hg hgS
    have hy := enc_inBox C.s g
    have hw : W.testBit (idx C.s (enc C.s g)) = false := by
      cases hb : W.testBit (idx C.s (enc C.s g)) with
      | false => rfl
      | true => exact absurd ⟨g, hg, rfl⟩ (hno _ hb)
    rw [← hRm, land_eq, land_eq, xor_eq, xor_eq, Nat.testBit_and, Nat.testBit_and, Nat.testBit_xor,
      Nat.testBit_xor, hE.adm, admC_spec hC (fun a ha => hS.known a ha) hy, adm_enc hS hg,
      hitS_spec hC hy S (sOK_parts hsok), avoid_enc hv hgS, hw, hC.full_eq, hC.w_eq,
      Nat.testBit_two_pow_sub_one]
    simp [idx_lt hy]
  let K' := K.filter fun g => ∀ q ∈ finS S, g q.1 ≠ q.2
  have hK' : Theory.Intersecting K' := by
    intro e he f hf
    obtain ⟨heK, heS⟩ := Finset.mem_filter.mp he
    obtain ⟨hfK, hfS⟩ := Finset.mem_filter.mp hf
    by_contra hmeet
    have hef : EdgeDisjoint e f := not_edgeMeets_iff.mp hmeet
    have rx := inR e heK heS
    have ry := inR f hfK hfS
    have hey := enc_inBox C.s e
    have hfy := enc_inBox C.s f
    have hcheck := allBelow_spec hall (by rw [hC.w_eq]; exact idx_lt hey)
    simp only [tb_eq, rx, Bool.not_true, Bool.false_or, Nat.beq_eq, decode_idx hey] at hcheck
    have hbit := congrArg (fun m => m.testBit (idx C.s (enc C.s f))) hcheck
    simp only [land_eq, Nat.testBit_and, Nat.zero_testBit, ry, Bool.and_true, partnerC,
      Bool.and_eq_false_iff] at hbit
    rcases hbit with hb | hb
    · have hnot : ¬ ∀ i, (enc C.s e).get i < C.s.get i → (enc C.s f).get i ≠ (enc C.s e).get i := by
        intro h
        rw [(avoidKnownC_spec hC hey hfy).mpr h] at hb
        exact absurd hb (by decide)
      apply hnot
      intro i hi heq
      have he' : e i = (enc C.s e).get i := (enc_get_known e hi).mp rfl
      have hf' : f i = (enc C.s e).get i := (enc_get_known f hi).mp heq
      exact hef i (he'.trans hf'.symm)
    · have key : ∀ (L : List Code), (∀ a ∈ L, a ∈ F ∧ Fast.meets (enc C.s e) a = false) →
          (andAllC C.full (L.map fun a => C.meetC a)).testBit (idx C.s (enc C.s f)) = true := by
        intro L
        induction L with
        | nil =>
          intro _
          simp [andAllC, hC.full_eq, hC.w_eq, Nat.testBit_two_pow_sub_one, idx_lt hfy]
        | cons a L ih =>
          intro hL
          obtain ⟨haF, hna⟩ := hL a (List.mem_cons_self ..)
          simp only [List.map_cons, andAllC, land_eq, Nat.testBit_and, Bool.and_eq_true]
          refine ⟨?_, ih (fun b hb => hL b (List.mem_cons_of_mem _ hb))⟩
          rw [C.meetC_spec hC (known_inBox (hS.known a haF)) hfy]
          have hh := ResidualCoordinates.two_hit_anchor hS.noThree heK hfK (hS.mem a haF) hef
          rw [ResidualCoordinates.hits_iff, ResidualCoordinates.hits_iff, ← hS.meets_enc haF,
            ← hS.meets_enc haF, hna] at hh
          simpa using hh
      rw [key _ (fun a ha => by
        obtain ⟨haF, hna⟩ := List.mem_filter.mp ha
        exact ⟨haF, by simpa using hna⟩)] at hb
      exact absurd hb (by decide)
  obtain ⟨Cv, hCv, hcov⟩ := Theory.intersecting_cover_three K' hK'
  apply notCover
  refine ⟨actualCover (finS S) ∪ Cv, (Finset.card_union_le _ _).trans ?_, ?_⟩
  · have h1 := CoverWitness.actualCover_card_le (finS S)
    have h2 : (finS S).length ≤ 2 := by
      simp only [sOK, Bool.and_eq_true] at hsok
      simpa [finS, Nat.ble_eq] using hsok.1
    omega
  · intro g hg
    by_cases hgS : ∀ q ∈ finS S, g q.1 ≠ q.2
    · obtain ⟨i, hi⟩ := hcov g (Finset.mem_filter.mpr ⟨hg, hgS⟩)
      exact ⟨i, Finset.mem_union_right _ hi⟩
    · simp only [not_forall, not_not] at hgS
      obtain ⟨q, hq, heq⟩ := hgS
      refine ⟨q.1, Finset.mem_union_left _ ?_⟩
      rw [heq]
      exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨q, hq, rfl⟩)

/-! ## Families with residual clauses -/

/-- Full check of an anchored family: anchors known, every residual clause `(S, W)` accepted,
and the certificate stream closes every branch. -/
def lcheck2 (s : Code) (tbl : ℕ) (F : List Code) (Rs : List (List (ℕ × ℕ) × ℕ)) (w fuel str : ℕ) :
    Bool :=
  F.all (known s) && Rs.all (fun r => resOK (mkCtx s tbl F) F r.1 r.2) &&
    (run (mkCtx s tbl F) (Rs.map Prod.snd) w fuel (initSt (mkCtx s tbl F) F) str).isSome

theorem lcheck2_sound {s : Code} {tbl : ℕ} (htbl : tbl = refTable s) {F : List Code}
    {Rs : List (List (ℕ × ℕ) × ℕ)} {w fuel str : ℕ} (h : lcheck2 s tbl F Rs w fuel str = true)
    (K : Finset NatEdge) (hK : MatchingAtMost K 2) (hF : ∀ a ∈ F, a.toEdge ∈ K) :
    CoverAtMost K 5 := by
  simp only [lcheck2, Bool.and_eq_true, Option.isSome_iff_exists, List.all_eq_true] at h
  obtain ⟨⟨hknown, hres⟩, str', hrun⟩ := h
  by_contra notCover
  have hS : Setting s F K := ⟨matchingAtMost_two_noThree hK, fun a ha => hknown a ha, hF⟩
  have hE : Env (mkCtx s tbl F) F K := ⟨⟨rfl, rfl, htbl⟩, rfl, hS⟩
  refine run_sound hE notCover ?_ _ _ _ _ (initSt_good hE) hrun
  intro W hW
  obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hW
  exact resOK_sound hE notCover (hres r hr)

/-! ## Representatives and isomorphic transport -/

/-- The finite five-cover statement for an anchored family. -/
def RepCover (F : List Code) : Prop :=
  ∀ K : Finset NatEdge, MatchingAtMost K 2 → (∀ x ∈ F, x.toEdge ∈ K) → CoverAtMost K 5

theorem lcheck2_cover {s : Code} {tbl : ℕ} (htbl : tbl = refTable s) {F : List Code}
    {Rs : List (List (ℕ × ℕ) × ℕ)} {w fuel str : ℕ} (h : lcheck2 s tbl F Rs w fuel str = true) :
    RepCover F :=
  fun K hK hF => lcheck2_sound htbl h K hK hF

def zeroC : Code := ⟨0, 0, 0, 0⟩

/-- Exchange parts 0 and 1 (bit 0 of `m`) and parts 2 and 3 (bit 1 of `m`). -/
def swapC (m : ℕ) (x : Code) : Code :=
  cond (Nat.beq (m % 2) 1)
    (cond (Nat.beq (m / 2 % 2) 1) ⟨x.b, x.a, x.d, x.c⟩ ⟨x.b, x.a, x.c, x.d⟩)
    (cond (Nat.beq (m / 2 % 2) 1) ⟨x.a, x.b, x.d, x.c⟩ x)

def swapF (m : ℕ) (i : Fin 4) : Fin 4 :=
  match i with
  | ⟨0, _⟩ => if m % 2 = 1 then 1 else 0
  | ⟨1, _⟩ => if m % 2 = 1 then 0 else 1
  | ⟨2, _⟩ => if m / 2 % 2 = 1 then 3 else 2
  | ⟨_ + 3, _⟩ => if m / 2 % 2 = 1 then 2 else 3

theorem swapF_inv (m : ℕ) (i : Fin 4) : swapF m (swapF m i) = i := by
  match i with
  | ⟨0, _⟩ => by_cases h : m % 2 = 1 <;> simp [swapF, h]
  | ⟨1, _⟩ => by_cases h : m % 2 = 1 <;> simp [swapF, h]
  | ⟨2, _⟩ => by_cases h : m / 2 % 2 = 1 <;> simp [swapF, h]
  | ⟨3, _⟩ => by_cases h : m / 2 % 2 = 1 <;> simp [swapF, h]

def swapP (m : ℕ) : Equiv.Perm (Fin 4) := ⟨swapF m, swapF m, swapF_inv m, swapF_inv m⟩

theorem swapC_get (m : ℕ) (x : Code) (i : Fin 4) : (swapC m x).get i = x.get (swapP m i) := by
  have h1 := Nat.mod_two_eq_zero_or_one m
  have h2 := Nat.mod_two_eq_zero_or_one (m / 2)
  simp only [swapP, Equiv.coe_fn_mk]
  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;>
  match i with
  | ⟨0, _⟩ => simp [swapC, swapF, h1, h2]
  | ⟨1, _⟩ => simp [swapC, swapF, h1, h2]
  | ⟨2, _⟩ => simp [swapC, swapF, h1, h2]
  | ⟨3, _⟩ => simp [swapC, swapF, h1, h2]

/-- Same equality relation of `x, y` and of `x', y'` in every part. -/
def eqPat2 (x y x' y' : Code) : Bool :=
  Bool.beq (Nat.beq x.a y.a) (Nat.beq x'.a y'.a) && Bool.beq (Nat.beq x.b y.b) (Nat.beq x'.b y'.b) &&
    Bool.beq (Nat.beq x.c y.c) (Nat.beq x'.c y'.c) && Bool.beq (Nat.beq x.d y.d) (Nat.beq x'.d y'.d)

theorem beq_beq_iff {m n m' n' : ℕ} (e : Bool.beq (Nat.beq m n) (Nat.beq m' n') = true) :
    m = n ↔ m' = n' := by
  have e' : Nat.beq m n = Nat.beq m' n' := by
    revert e; cases Nat.beq m n <;> cases Nat.beq m' n' <;> decide
  rw [← Nat.beq_eq, ← Nat.beq_eq, e']

theorem eqPat2_spec {x y x' y' : Code} (h : eqPat2 x y x' y' = true) (i : Fin 4) :
    x.get i = y.get i ↔ x'.get i = y'.get i := by
  simp only [eqPat2, Bool.and_eq_true] at h
  obtain ⟨⟨⟨ha, hb⟩, hc⟩, hd⟩ := h
  match i with
  | ⟨0, _⟩ => exact beq_beq_iff ha
  | ⟨1, _⟩ => exact beq_beq_iff hb
  | ⟨2, _⟩ => exact beq_beq_iff hc
  | ⟨3, _⟩ => exact beq_beq_iff hd

def headPat (x x' : Code) : List Code → List Code → Bool
  | [], [] => true
  | y :: ys, y' :: ys' => eqPat2 x y x' y' && headPat x x' ys ys'
  | _, _ => false

def patList : List Code → List Code → Bool
  | [], [] => true
  | x :: xs, x' :: xs' => headPat x x' xs xs' && patList xs xs'
  | _, _ => false

theorem headPat_spec {x x' : Code} : ∀ {ys ys' : List Code}, headPat x x' ys ys' = true →
    ys.length = ys'.length ∧ ∀ (l : ℕ) (hl : l < ys.length) (hl' : l < ys'.length),
      eqPat2 x ys[l] x' ys'[l] = true
  | [], [], _ => ⟨rfl, fun l hl => absurd hl (Nat.not_lt_zero _)⟩
  | y :: ys, y' :: ys', h => by
    simp only [headPat, Bool.and_eq_true] at h
    obtain ⟨hlen, hall⟩ := headPat_spec h.2
    refine ⟨by simp [hlen], fun l hl hl' => ?_⟩
    cases l with
    | zero => exact h.1
    | succ l => exact hall l (by simpa using hl) (by simpa using hl')
  | [], _ :: _, h => by simp [headPat] at h
  | _ :: _, [], h => by simp [headPat] at h

theorem patList_spec : ∀ {X Y : List Code}, patList X Y = true →
    X.length = Y.length ∧ ∀ (k l : ℕ) (hk : k < X.length) (hl : l < X.length) (hk' : k < Y.length)
      (hl' : l < Y.length) (i : Fin 4), X[k].get i = X[l].get i ↔ Y[k].get i = Y[l].get i
  | [], [], _ => ⟨rfl, fun k _ hk => absurd hk (Nat.not_lt_zero _)⟩
  | x :: xs, x' :: xs', h => by
    simp only [patList, Bool.and_eq_true] at h
    obtain ⟨hlen, hall⟩ := patList_spec h.2
    obtain ⟨-, hhead⟩ := headPat_spec h.1
    refine ⟨by simp [hlen], fun k l hk hl hk' hl' i => ?_⟩
    cases k with
    | zero =>
      cases l with
      | zero => simp
      | succ l => exact eqPat2_spec (hhead l (by simpa using hl) (by simpa using hl')) i
    | succ k =>
      cases l with
      | zero =>
        have := eqPat2_spec (hhead k (by simpa using hk) (by simpa using hk')) i
        simp only [List.getElem_cons_succ, List.getElem_cons_zero]
        constructor
        · intro e; exact (this.mp e.symm).symm
        · intro e; exact (this.mpr e.symm).symm
      | succ l =>
        exact hall k l (by simpa using hk) (by simpa using hl) (by simpa using hk') (by simpa using hl') i
  | [], _ :: _, h => by simp [patList] at h
  | _ :: _, [], h => by simp [patList] at h

/-- Strict upper bounds of the coordinates of a family. -/
def bound (R : List Code) (i : Fin 4) : ℕ := R.foldr (fun x m => max m (x.get i + 1)) 0

theorem lt_bound {R : List Code} {x : Code} (hx : x ∈ R) (i : Fin 4) : x.get i < bound R i := by
  induction R with
  | nil => simp at hx
  | cons y R ih =>
    simp only [bound, List.foldr_cons] at *
    rcases List.mem_cons.mp hx with rfl | hx
    · exact lt_of_lt_of_le (Nat.lt_succ_self _) (le_max_right _ _)
    · exact lt_of_lt_of_le (ih hx) (le_max_left _ _)

/-- The representative `R` is the image of `src` under the selection `sel` and part swap `sw`. -/
def viaOK (src R : List Code) (sel : List ℕ) (sw : ℕ) : Bool :=
  Nat.beq sel.length R.length && sel.all (fun j => Nat.blt j src.length) &&
    patList (sel.map fun j => swapC sw (src.getD j zeroC)) R

theorem via_cover {src R : List Code} {sel : List ℕ} {sw : ℕ} (h : viaOK src R sel sw = true)
    (hR : RepCover R) : RepCover src := by
  intro K hK hsrc
  simp only [viaOK, Bool.and_eq_true, Nat.beq_eq, List.all_eq_true] at h
  obtain ⟨⟨hlen, hsel⟩, hpat⟩ := h
  obtain ⟨hlen2, hp⟩ := patList_spec hpat
  have hsel' : ∀ k : Fin R.length, sel.getD k.val 0 < src.length := by
    intro k
    have hk : k.val < sel.length := by rw [hlen]; exact k.isLt
    rw [List.getD_eq_getElem _ _ hk]
    simpa [Nat.blt_eq] using hsel _ (List.getElem_mem hk)
  apply Theory.cover_of_list_anchor_pattern src Code.toEdge R Code.toEdge
    (fun k => ⟨sel.getD k.val 0, hsel' k⟩) (swapP sw) ?_ (bound R) ?_ hsrc hK hR
  · intro i k l
    have hk2 : k.val < sel.length := by rw [hlen]; exact k.isLt
    have hl2 : l.val < sel.length := by rw [hlen]; exact l.isLt
    have h := hp k.val l.val (by simpa using hk2) (by simpa using hl2) k.isLt l.isLt i
    simp only [List.getElem_map, swapC_get] at h
    have gk : sel.getD k.val 0 = sel[k.val] := List.getD_eq_getElem _ _ hk2
    have gl : sel.getD l.val 0 = sel[l.val] := List.getD_eq_getElem _ _ hl2
    have sk : sel[k.val] < src.length := gk ▸ hsel' k
    have sl : sel[l.val] < src.length := gl ▸ hsel' l
    rw [List.getD_eq_getElem _ _ sk, List.getD_eq_getElem _ _ sl] at h
    simp only [List.get_eq_getElem, Code.toEdge, gk, gl]
    exact h
  · intro x hx i
    exact lt_bound hx i

/-! ## Rows: every normalised pair is covered -/

section
open Ryser.Fast
theorem row_abstract (b : Code) (A : List Code) (p q : Fin 4 × ℕ)
    (hA : A.all (known b) = true) (hp : vertexOK b p = true) (hq : vertexOK b q = true)
    (hcov : ∀ e f : Code, InBox b e → InBox (bumped b) f →
      (eMask b A [p, q]).testBit (idx b e) = true →
      (fMask b A [p, q] e).testBit (idx (bumped b) f) = true → RepCover (A ++ [e, f]))
    (H : Finset NatEdge) (hm : MatchingAtMost H 2) (hAH : ∀ a ∈ A, a.toEdge ∈ H) :
    CoverAtMost H 5 := by
  classical
  have hAk : ∀ a ∈ A, known b a = true := fun a ha => List.all_eq_true.mp hA a ha
  have hp' : p.2 < b.get p.1 := by simpa [vertexOK] using hp
  have hq' : q.2 < b.get q.1 := by simpa [vertexOK] using hq
  have h3 := matchingAtMost_two_noThree hm
  by_contra hn
  obtain ⟨e, he, f, hf, hep, heq, hfp, hfq, hef⟩ := ResidualWitness.exists_pair_outside H hn p q
  apply hn
  apply cover_of_pair b (A.map Code.toEdge) ?_ H hm ?_ e f he hf hef
  rotate_left
  · intro a ha i
    obtain ⟨a', ha', rfl⟩ := List.mem_map.mp ha
    rw [toEdge_get]; exact known_get (hAk a' ha') i
  · intro a ha
    obtain ⟨a', ha', rfl⟩ := List.mem_map.mp ha
    exact hAH a' ha'
  intro K hK hAK he' hf'
  set e' := ofEdge (normEdge b e e) with he'def
  set f' := ofEdge (normEdge b e f) with hf'def
  have eIn : InBox b e' := normE_inBox
  have fIn : InBox (bumped b) f' := norm_inBumped f
  -- both normalised edges meet every disjoint anchor pair
  have admE : ∀ (t : Code) (g : NatEdge), g ∈ H → InBox t (ofEdge (normEdge b e g)) →
      (∀ a ∈ A, known t a = true) →
      (admMask t A).testBit (idx t (ofEdge (normEdge b e g))) = true := by
    intro t g hg hgt htk
    rw [admMask, andAll_spec hgt]
    intro m hm'
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hm'
    obtain ⟨h1, h2, h12⟩ := mem_disjointPairs hr
    have hi := ResidualCoordinates.one_hits_pair h3 hg (hAH _ h1) (hAH _ h2)
      (edgeDisjoint_of_meets_false h12)
    rw [Nat.testBit_or, meetMask_spec hgt (known_inBox (htk _ h1)),
      meetMask_spec hgt (known_inBox (htk _ h2)), Bool.or_eq_true,
      meets_norm (hAk _ h1), meets_norm (hAk _ h2), ← ResidualCoordinates.hits_iff,
      ← ResidualCoordinates.hits_iff]
    exact hi
  have avoidS : ∀ (t : Code) (g : NatEdge), InBox t (ofEdge (normEdge b e g)) →
      (∀ v ∈ [p, q], v.2 ≤ t.get v.1) → g p.1 ≠ p.2 → g q.1 ≠ q.2 →
      (hitMask t [p, q]).testBit (idx t (ofEdge (normEdge b e g))) = false := by
    intro t g hgt hvt hgp hgq
    rw [hitMask_spec hgt _ hvt]
    simp only [Fast.hits, List.any_cons, List.any_nil, Bool.or_false, Bool.or_eq_false_iff,
      decide_eq_false_iff_not]
    exact ⟨fun h => hgp ((norm_eq_small g hp').mp h), fun h => hgq ((norm_eq_small g hq').mp h)⟩
  have hvb : ∀ v ∈ [p, q], v.2 ≤ b.get v.1 := by
    intro v hv; simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl <;> omega
  have hvt : ∀ v ∈ [p, q], v.2 ≤ (bumped b).get v.1 := by
    intro v hv
    have := hvb v hv
    have hle : b.get v.1 ≤ (bumped b).get v.1 := by
      match v.1 with
      | ⟨0, _⟩ => simp [bumped]
      | ⟨1, _⟩ => simp [bumped]
      | ⟨2, _⟩ => simp [bumped]
      | ⟨3, _⟩ => simp [bumped]
    omega
  have eBit : (eMask b A [p, q]).testBit (idx b e') = true := by
    rw [eMask, testBit_diff, admE b e he eIn hAk, avoidS b e eIn hvb hep heq]; rfl
  -- f' is a listed partner
  have fBit : (fMask b A [p, q] e').testBit (idx (bumped b) f') = true := by
    rw [fMask, Nat.testBit_and, testBit_diff, testBit_diff, testBit_diff,
      admE (bumped b) f hf fIn (fun a ha => known_bumped (hAk a ha)),
      avoidS (bumped b) f fIn hvt hfp hfq]
    simp only [Bool.not_false, Bool.true_and, Bool.and_eq_true, Bool.not_eq_true']
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · -- f' differs from e' in every part
      rw [hitMask_spec fIn]
      · simp only [Fast.hits, eVertices, List.any_cons, List.any_nil, Bool.or_false,
          Bool.or_eq_false_iff, decide_eq_false_iff_not]
        have key : ∀ i : Fin 4, f'.get i ≠ e'.get i := by
          intro i h
          rw [hf'def, he'def, norm_get, norm_get] at h
          have := lab_inj (hef i) (Or.inr (Or.inr rfl)) (Or.inr (Or.inl rfl)) h
          exact hef i this.symm
        exact ⟨key 0, key 1, key 2, key 3⟩
      · intro v hv
        simp only [eVertices, List.mem_cons, List.not_mem_nil, or_false] at hv
        obtain ⟨ea, eb, ec, ed⟩ := eIn
        rcases hv with rfl | rfl | rfl | rfl <;> simp [bumped] <;> omega
    · -- the second fresh label only where e is outside
      rw [hitMask_spec fIn]
      · simp only [Fast.hits, List.any_eq_false, decide_eq_true_eq]
        intro v hv hfv
        simp only [gapVertices, List.mem_append] at hv
        have gap : ∀ i : Fin 4, e'.get i < b.get i → f'.get i ≠ b.get i + 1 := by
          intro i hi
          rw [hf'def, norm_get]
          rw [he'def, norm_get] at hi
          have lab_lt_imp : ∀ (B E : ℕ), lab B E E < B → E < B := by
            intro B E h; unfold lab at h; split_ifs at h <;> omega
          have hei : e i < b.get i := lab_lt_imp _ _ hi
          exact lab_f_gap hei
        rcases hv with ((hv | hv) | hv) | hv <;> split at hv <;>
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hv <;> subst hv
        · exact gap 0 (by simpa using ‹e'.a < b.a›) (by simpa using hfv)
        · exact gap 1 (by simpa using ‹e'.b < b.b›) (by simpa using hfv)
        · exact gap 2 (by simpa using ‹e'.c < b.c›) (by simpa using hfv)
        · exact gap 3 (by simpa using ‹e'.d < b.d›) (by simpa using hfv)
      · intro v hv
        simp only [gapVertices, List.mem_append] at hv
        rcases hv with ((hv | hv) | hv) | hv <;> split at hv <;>
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hv <;> subst hv <;> simp [bumped]
    · -- every anchor missed by e' is met by f'
      rw [andAll_spec fIn]
      intro m hm'
      obtain ⟨a, haF, rfl⟩ := List.mem_map.mp hm'
      obtain ⟨haF, hna⟩ := List.mem_filter.mp haF
      simp only [Bool.not_eq_true'] at hna
      rw [meetMask_spec fIn (known_inBox (known_bumped (hAk a haF)))]
      have hh := ResidualCoordinates.two_hit_anchor h3 he hf (hAH a haF) hef
      rw [ResidualCoordinates.hits_iff, ResidualCoordinates.hits_iff, ← meets_norm (hAk a haF) e,
        ← meets_norm (hAk a haF) f] at hh
      rw [← he'def] at hh
      rw [hna] at hh
      simpa [hf'def] using hh
  apply hcov e' f' eIn fIn eBit fBit K hK
  intro a ha
  rcases List.mem_append.mp ha with ha | ha
  · exact hAK _ (List.mem_map.mpr ⟨a, ha, rfl⟩)
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl
    · rw [he'def, ofEdge_toEdge]; exact he'
    · rw [hf'def, ofEdge_toEdge]; exact hf'

end

/-! ## Table-based row masks -/

/-- The `e` candidates of a row, from the table of the box `b` (context `Cb`). -/
def eMaskC (Cb : Ctx) (S : List (ℕ × ℕ)) : ℕ := Nat.land Cb.adm (Nat.xor Cb.full (hitS Cb S))

/-- Second fresh value is excluded where `e` is inside (`b` the box of `e`). -/
def gapC (C1 : Ctx) (b e : Code) : ℕ :=
  Nat.lor (Nat.lor (cond (Nat.blt e.a b.a) (C1.vm 0 (b.a + 1)) 0) (cond (Nat.blt e.b b.b) (C1.vm 1 (b.b + 1)) 0))
    (Nat.lor (cond (Nat.blt e.c b.c) (C1.vm 2 (b.c + 1)) 0) (cond (Nat.blt e.d b.d) (C1.vm 3 (b.d + 1)) 0))

/-- The `f` partners of `e`, from the table of the bumped box (context `C1`). -/
def fMaskC (C1 : Ctx) (b : Code) (A : List Code) (S : List (ℕ × ℕ)) (e : Code) : ℕ :=
  Nat.land (Nat.land (Nat.land (Nat.land C1.adm (Nat.xor C1.full (hitS C1 S)))
    (Nat.xor C1.full (C1.meetC e))) (Nat.xor C1.full (gapC C1 b e)))
    (andAllC C1.full ((A.filter fun a => !Fast.meets e a).map fun a => C1.meetC a))

/-- The two deleted vertices of a row as natural-number pairs. -/
def natS (p q : Fin 4 × ℕ) : List (ℕ × ℕ) := [(p.1.val, p.2), (q.1.val, q.2)]

theorem finS_natS (p q : Fin 4 × ℕ) : finS (natS p q) = [p, q] := by
  have ep : (⟨p.1.val % 4, Nat.mod_lt _ (by decide)⟩ : Fin 4) = p.1 := Fin.ext (Nat.mod_eq_of_lt p.1.isLt)
  have eq : (⟨q.1.val % 4, Nat.mod_lt _ (by decide)⟩ : Fin 4) = q.1 := Fin.ext (Nat.mod_eq_of_lt q.1.isLt)
  simp only [finS, natS, List.map_cons, List.map_nil, ep, eq]

theorem natS_parts {s : Code} {p q : Fin 4 × ℕ} (hp : vertexOK s p = true) (hq : vertexOK s q = true) :
    ∀ x ∈ natS p q, vertexOK s (⟨x.1 % 4, Nat.mod_lt _ (by decide)⟩, x.2) = true := by
  intro x hx
  simp only [natS, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl
  · have e : (⟨p.1.val % 4, Nat.mod_lt _ (by decide)⟩ : Fin 4) = p.1 := by
      ext; simp [Nat.mod_eq_of_lt p.1.isLt]
    simpa [e] using hp
  · have e : (⟨q.1.val % 4, Nat.mod_lt _ (by decide)⟩ : Fin 4) = q.1 := by
      ext; simp [Nat.mod_eq_of_lt q.1.isLt]
    simpa [e] using hq

theorem eMaskC_spec {Cb : Ctx} (hC : Cb.Valid) {A : List Code} (hadm : Cb.adm = admC Cb A)
    (hA : ∀ a ∈ A, known Cb.s a = true) {p q : Fin 4 × ℕ} (hp : vertexOK Cb.s p = true)
    (hq : vertexOK Cb.s q = true) {y : Code} (hy : InBox Cb.s y) :
    (eMaskC Cb (natS p q)).testBit (idx Cb.s y) = (eMask Cb.s A [p, q]).testBit (idx Cb.s y) := by
  rw [eMaskC, eMask, land_eq, xor_eq, Nat.testBit_and, Nat.testBit_xor, testBit_diff, hadm,
    admC_spec hC hA hy, hitS_spec hC hy _ (natS_parts hp hq), finS_natS, hC.full_eq, hC.w_eq,
    Nat.testBit_two_pow_sub_one]
  simp [idx_lt hy]

theorem gapC_spec {C1 : Ctx} (hC : C1.Valid) {b e : Code} (hb : C1.s = bumped b) (_he : InBox b e)
    {y : Code} (hy : InBox C1.s y) :
    (gapC C1 b e).testBit (idx C1.s y) = (hitMask C1.s (gapVertices b e)).testBit (idx C1.s y) := by
  have v0 : b.a + 1 ≤ C1.s.a := by rw [hb]; simp [bumped]
  have v1 : b.b + 1 ≤ C1.s.b := by rw [hb]; simp [bumped]
  have v2 : b.c + 1 ≤ C1.s.c := by rw [hb]; simp [bumped]
  have v3 : b.d + 1 ≤ C1.s.d := by rw [hb]; simp [bumped]
  have g0 : (cond (Nat.blt e.a b.a) (C1.vm 0 (b.a + 1)) 0).testBit (idx C1.s y) =
      decide (e.a < b.a ∧ y.a = b.a + 1) := by
    by_cases h : e.a < b.a
    · rw [show Nat.blt e.a b.a = true by simpa [Nat.blt_eq] using h, Bool.cond_true, C1.vm0 hC hy v0]
      simp [h]
    · rw [show Nat.blt e.a b.a = false by (cases hh : Nat.blt e.a b.a <;> simp_all [Nat.blt_eq]); omega]
      simp [h]
  have g1 : (cond (Nat.blt e.b b.b) (C1.vm 1 (b.b + 1)) 0).testBit (idx C1.s y) =
      decide (e.b < b.b ∧ y.b = b.b + 1) := by
    by_cases h : e.b < b.b
    · rw [show Nat.blt e.b b.b = true by simpa [Nat.blt_eq] using h, Bool.cond_true, C1.vm1 hC hy v1]
      simp [h]
    · rw [show Nat.blt e.b b.b = false by (cases hh : Nat.blt e.b b.b <;> simp_all [Nat.blt_eq]); omega]
      simp [h]
  have g2 : (cond (Nat.blt e.c b.c) (C1.vm 2 (b.c + 1)) 0).testBit (idx C1.s y) =
      decide (e.c < b.c ∧ y.c = b.c + 1) := by
    by_cases h : e.c < b.c
    · rw [show Nat.blt e.c b.c = true by simpa [Nat.blt_eq] using h, Bool.cond_true, C1.vm2 hC hy v2]
      simp [h]
    · rw [show Nat.blt e.c b.c = false by (cases hh : Nat.blt e.c b.c <;> simp_all [Nat.blt_eq]); omega]
      simp [h]
  have g3 : (cond (Nat.blt e.d b.d) (C1.vm 3 (b.d + 1)) 0).testBit (idx C1.s y) =
      decide (e.d < b.d ∧ y.d = b.d + 1) := by
    by_cases h : e.d < b.d
    · rw [show Nat.blt e.d b.d = true by simpa [Nat.blt_eq] using h, Bool.cond_true, C1.vm3 hC hy v3]
      simp [h]
    · rw [show Nat.blt e.d b.d = false by (cases hh : Nat.blt e.d b.d <;> simp_all [Nat.blt_eq]); omega]
      simp [h]
  have hv : ∀ q ∈ gapVertices b e, q.2 ≤ C1.s.get q.1 := by
    intro q hq
    simp only [gapVertices, List.mem_append] at hq
    rcases hq with ((hq | hq) | hq) | hq <;> split at hq <;>
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq <;> subst hq <;> simp_all
  rw [hitMask_spec hy _ hv]
  simp only [gapC, lor_eq, Nat.testBit_or, g0, g1, g2, g3]
  simp only [Fast.hits, gapVertices, List.any_append]
  by_cases h0 : e.a < b.a <;> by_cases h1 : e.b < b.b <;> by_cases h2 : e.c < b.c <;>
    by_cases h3 : e.d < b.d <;>
    (apply Bool.eq_iff_iff.mpr; simp [h0, h1, h2, h3, Code.get, or_assoc])

theorem fMaskC_spec {C1 : Ctx} (hC : C1.Valid) {b : Code} (hb : C1.s = bumped b) {A : List Code}
    (hadm : C1.adm = admC C1 A) (hA : ∀ a ∈ A, known C1.s a = true) {p q : Fin 4 × ℕ}
    (hp : vertexOK C1.s p = true) (hq : vertexOK C1.s q = true) {e : Code} (he : InBox b e)
    {y : Code} (hy : InBox C1.s y) :
    (fMaskC C1 b A (natS p q) e).testBit (idx C1.s y) =
      (fMask b A [p, q] e).testBit (idx C1.s y) := by
  have he1 : InBox C1.s e := by
    obtain ⟨h1, h2, h3, h4⟩ := he
    rw [hb]; exact ⟨by simp [bumped]; omega, by simp [bumped]; omega, by simp [bumped]; omega,
      by simp [bumped]; omega⟩
  have hev : ∀ q ∈ eVertices e, q.2 ≤ C1.s.get q.1 := by
    intro q hq
    obtain ⟨h1, h2, h3, h4⟩ := he1
    simp only [eVertices, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl <;> simpa
  have hmeet : (C1.meetC e).testBit (idx C1.s y) = (hitMask C1.s (eVertices e)).testBit (idx C1.s y) := by
    rw [C1.meetC_spec hC he1 hy, hitMask_spec hy _ hev]
    apply Bool.eq_iff_iff.mpr
    simp [Fast.meets, Fast.hits, eVertices, Code.get, or_assoc]
  have hand : (andAllC C1.full ((A.filter fun a => !Fast.meets e a).map fun a => C1.meetC a)).testBit
      (idx C1.s y) = (andAll C1.s ((A.filter fun a => !Fast.meets e a).map fun a => meetMask C1.s a)).testBit
      (idx C1.s y) := by
    have key : ∀ (L : List Code), (∀ a ∈ L, known C1.s a = true) →
        (andAllC C1.full (L.map fun a => C1.meetC a)).testBit (idx C1.s y) =
          (andAll C1.s (L.map fun a => meetMask C1.s a)).testBit (idx C1.s y) := by
      intro L
      induction L with
      | nil => intro _; simp [andAllC, andAll, full, hC.full_eq, hC.w_eq]
      | cons a L ih =>
        intro hL
        simp only [List.map_cons, andAllC, andAll, land_eq, Nat.testBit_and]
        rw [ih (fun b hb => hL b (List.mem_cons_of_mem _ hb)),
          C1.meetC_spec hC (known_inBox (hL a (List.mem_cons_self ..))) hy,
          meetMask_spec hy (known_inBox (hL a (List.mem_cons_self ..)))]
    exact key _ (fun a ha => hA a (List.mem_filter.mp ha).1)
  rw [fMaskC, fMask, ← hb]
  rw [land_eq, land_eq, land_eq, land_eq, xor_eq, xor_eq, xor_eq, Nat.testBit_and, Nat.testBit_and,
    Nat.testBit_and, Nat.testBit_and, Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_and,
    testBit_diff, testBit_diff, testBit_diff, hadm, admC_spec hC hA hy, hitS_spec hC hy _ (natS_parts hp hq),
    finS_natS, hmeet, gapC_spec hC hb he hy, hand, hC.full_eq, hC.w_eq, Nat.testBit_two_pow_sub_one]
  simp [idx_lt hy, Bool.and_assoc]

/-! ## Group and row checks -/

def orIdx : List ℕ → ℕ
  | [] => 0
  | i :: is => Nat.lor (2 ^ i) (orIdx is)

theorem orIdx_spec : ∀ {l : List ℕ} {i : ℕ}, (orIdx l).testBit i = true → i ∈ l
  | [], _, h => by simp [orIdx] at h
  | k :: l, i, h => by
    simp only [orIdx, lor_eq, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at h
    rcases h with rfl | h
    · exact List.mem_cons_self ..
    · exact List.mem_cons_of_mem _ (orIdx_spec h)

/-- Every `e` candidate of the row has a group. -/
def keysL (Cb : Ctx) (S : List (ℕ × ℕ)) (ies : List ℕ) : Bool :=
  Nat.beq (Nat.land (eMaskC Cb S) (Nat.xor Cb.full (orIdx ies))) 0

theorem mask_cover {M full L i : ℕ} (h : Nat.beq (Nat.land M (Nat.xor full L)) 0 = true)
    (hM : M.testBit i = true) (hfull : full.testBit i = true) : L.testBit i = true := by
  rw [Nat.beq_eq] at h
  have := congrArg (fun m => m.testBit i) h
  simp only [land_eq, xor_eq, Nat.testBit_and, Nat.testBit_xor, hM, hfull, Nat.zero_testBit,
    Bool.true_and, Bool.true_xor, Bool.not_eq_false'] at this
  exact this

theorem known_vertexOK_bumped {b : Code} {p : Fin 4 × ℕ} (h : vertexOK b p = true) :
    vertexOK (bumped b) p = true := by
  simp only [vertexOK, decide_eq_true_eq] at *
  match p with
  | (⟨0, _⟩, v) => simp [bumped] at *; omega
  | (⟨1, _⟩, v) => simp [bumped] at *; omega
  | (⟨2, _⟩, v) => simp [bumped] at *; omega
  | (⟨3, _⟩, v) => simp [bumped] at *; omega

theorem all_nil {α : Type} (P : α → Bool) : ∀ g ∈ ([] : List α), P g = true := by simp

theorem all_append {α : Type} {P : α → Bool} {l₁ l₂ : List α} (h₁ : l₁.all P = true)
    (h₂ : ∀ g ∈ l₂, P g = true) : ∀ g ∈ l₁ ++ l₂, P g = true := by
  intro g hg
  rcases List.mem_append.mp hg with hg | hg
  · exact List.all_eq_true.mp h₁ g hg
  · exact h₂ g hg

/-- The row statement from the frozen-template form. -/
theorem frozen_of_rep {t : Fin 232} {A : List Code}
    (hA : A = (List.finRange 7).map (fun k => ofEdge (Theory.frozenTemplate t k))) (h : RepCover A)
    (H : Finset NatEdge) (hm : MatchingAtMost H 2) (hF : ∀ k, Theory.frozenTemplate t k ∈ H) :
    CoverAtMost H 5 :=
  h H hm (anchors_of_template hA H hF)

/-! ## Value tables computed by doubling -/

theorem rep_add (blk stride m : ℕ) : ∀ n, rep blk stride (m + n) =
    rep blk stride m ||| (rep blk stride n <<< (m * stride))
  | 0 => by simp [rep]
  | n + 1 => by
    rw [show m + (n + 1) = (m + n) + 1 by omega, rep, rep, rep_add blk stride m n]
    apply Nat.eq_of_testBit_eq
    intro i
    simp only [Nat.testBit_or, Nat.testBit_shiftLeft]
    have e : (m + n) * stride = m * stride + n * stride := by rw [Nat.add_mul]
    rw [e]
    by_cases h1 : m * stride ≤ i
    · by_cases h2 : m * stride + n * stride ≤ i
      · have h3 : n * stride ≤ i - m * stride := by omega
        have h4 : i - (m * stride + n * stride) = i - m * stride - n * stride := by omega
        simp [h1, h2, h3, h4, Bool.or_assoc]
      · have h3 : ¬ n * stride ≤ i - m * stride := by omega
        simp [h1, h2, h3]
    · have h2 : ¬ m * stride + n * stride ≤ i := by omega
      simp [h1, h2]

/-- `rep` by binary doubling (the fuel bounds the number of halvings). -/
def repD (blk stride : ℕ) : ℕ → ℕ → ℕ
  | 0, m => rep blk stride m
  | fuel + 1, m =>
    cond (Nat.beq m 0) 0
      (cond (Nat.beq (m % 2) 1)
        (Nat.lor (Nat.lor (repD blk stride fuel (m / 2))
          (Nat.shiftLeft (repD blk stride fuel (m / 2)) (m / 2 * stride)))
          (Nat.shiftLeft blk ((m - 1) * stride)))
        (Nat.lor (repD blk stride fuel (m / 2))
          (Nat.shiftLeft (repD blk stride fuel (m / 2)) (m / 2 * stride))))

theorem repD_eq (blk stride : ℕ) : ∀ fuel m, repD blk stride fuel m = rep blk stride m
  | 0, m => rfl
  | fuel + 1, m => by
    unfold repD
    rw [repD_eq blk stride fuel (m / 2), lor_eq, lor_eq, shiftLeft_eq, shiftLeft_eq]
    by_cases hm : m = 0
    · subst hm; rfl
    · have hb : Nat.beq m 0 = false := by
        rw [Bool.eq_false_iff]; intro h; exact hm (Nat.eq_of_beq_eq_true h)
      rw [hb, Bool.cond_false]
      have hdouble : rep blk stride (m / 2) ||| (rep blk stride (m / 2) <<< (m / 2 * stride)) =
          rep blk stride (m / 2 + m / 2) := (rep_add blk stride (m / 2) (m / 2)).symm
      rcases Nat.mod_two_eq_zero_or_one m with h2 | h2
      · rw [show Nat.beq (m % 2) 1 = false by rw [h2]; rfl, Bool.cond_false, hdouble]
        congr 1; omega
      · rw [show Nat.beq (m % 2) 1 = true by rw [h2]; rfl, Bool.cond_true, hdouble,
          show m - 1 = m / 2 + m / 2 by omega]
        have e : m = (m / 2 + m / 2) + 1 := by omega
        conv => rhs; rw [e, rep]

/-- The value table built from one doubled base mask per part. -/
def fastTable (s : Code) : ℕ :=
  let n0 := s.a + 1; let n1 := s.b + 1; let n2 := s.c + 1; let n3 := s.d + 1
  let I0 := n1 * (n2 * n3); let I1 := n2 * n3; let I2 := n3
  let B0 := repD (2 ^ I0 - 1) (n0 * I0) 20 1
  let B1 := repD (2 ^ I1 - 1) (n1 * I1) 20 n0
  let B2 := repD (2 ^ I2 - 1) (n2 * I2) 20 (n0 * n1)
  let B3 := repD (2 ^ 1 - 1) (n3 * 1) 20 (n0 * n1 * n2)
  packL (size s) ((List.range n0).map (fun v => Nat.shiftLeft B0 (v * I0)) ++
    (List.range n1).map (fun v => Nat.shiftLeft B1 (v * I1)) ++
    (List.range n2).map (fun v => Nat.shiftLeft B2 (v * I2)) ++
    (List.range n3).map (fun v => Nat.shiftLeft B3 (v * 1)))

theorem fastTable_eq (s : Code) : fastTable s = refTable s := by
  unfold fastTable refTable tblList
  simp only [repD_eq, shiftLeft_eq]
  rfl

/-! ## Compact representative certificates -/

/-- `k` codes packed in 16-bit groups (4 bits per part). -/
def famN : ℕ → ℕ → List Code
  | 0, _ => []
  | k + 1, n => ⟨n % 16, n / 16 % 16, n / 256 % 16, n / 4096 % 16⟩ :: famN k (n / 65536)

/-- The sentinel box of a family: one more than the largest value in every part. -/
def boxOf (F : List Code) : Code :=
  F.foldr (fun x s => ⟨max s.a (x.a + 1), max s.b (x.b + 1), max s.c (x.c + 1), max s.d (x.d + 1)⟩)
    ⟨0, 0, 0, 0⟩

end Ryser.Light

/-!
# Packed isomorphism checks

The transports of `Ryser.Light` compare the equality patterns of two nine-code families pair by
pair.  Here a family is packed into one natural number (four bits per part, sixteen bits per
code), and the whole pattern is compared with a few dozen GMP operations: for every distance `d`
the packed family is XOR-ed with itself shifted by `d` codes, and a nibble of the result is zero
exactly when the two codes at distance `d` agree in that part.
-/


namespace Ryser.Light
open Ryser Ryser.Fast FiniteBox

/-! ## Definitions used by the kernel -/

/-- A code packed in sixteen bits (values below sixteen). -/
def pk (x : Code) : ℕ :=
  Nat.lor x.a (Nat.shiftLeft (Nat.lor x.b (Nat.shiftLeft (Nat.lor x.c (Nat.shiftLeft x.d 4)) 4)) 4)

/-- A family packed sixteen bits per code. -/
def packF : List Code → ℕ
  | [] => 0
  | x :: xs => Nat.lor (pk x) (Nat.shiftLeft (packF xs) 16)

/-- Representative `j` of a packed list of representatives (144 bits each). -/
def repAt (RN j : ℕ) : ℕ := Nat.shiftRight RN (144 * j) % 2 ^ 144

/-- Code `s mod 16 mod 9` of the packed family `P`. -/
@[inline] def fld (P s : ℕ) : ℕ := Nat.land (Nat.shiftRight P (16 * (Nat.land s 15 % 9))) 65535

/-- The packed family `P` reordered by the selection `sel` (nine indices, four bits each). -/
def selX (P sel : ℕ) : ℕ :=
  Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor
    (fld P sel)
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 4)) 16))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 8)) 32))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 12)) 48))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 16)) 64))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 20)) 80))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 24)) 96))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 28)) 112))
    (Nat.shiftLeft (fld P (Nat.shiftRight sel 32)) 128)

/-- Nibble masks of the nine codes: part 0, part 2, parts 0 and 1, parts 2 and 3. -/
def nM0 : ℕ := 0xf000f000f000f000f000f000f000f000f
def nM2 : ℕ := 0xf000f000f000f000f000f000f000f000f00
def nM01 : ℕ := 0xff00ff00ff00ff00ff00ff00ff00ff00ff
def nM23 : ℕ := 0xff00ff00ff00ff00ff00ff00ff00ff00ff00

/-- Exchange parts 0 and 1 of every code. -/
def sw01 (X : ℕ) : ℕ :=
  Nat.lor (Nat.lor (Nat.shiftLeft (Nat.land X nM0) 4) (Nat.land (Nat.shiftRight X 4) nM0)) (Nat.land X nM23)

/-- Exchange parts 2 and 3 of every code. -/
def sw23 (X : ℕ) : ℕ :=
  Nat.lor (Nat.lor (Nat.shiftLeft (Nat.land X nM2) 4) (Nat.land (Nat.shiftRight X 4) nM2)) (Nat.land X nM01)

/-- The part exchange `swapC sw` applied to every code. -/
def swapAll (sw X : ℕ) : ℕ :=
  cond (Nat.beq (sw / 2 % 2) 1) (sw23 (cond (Nat.beq (sw % 2) 1) (sw01 X) X))
    (cond (Nat.beq (sw % 2) 1) (sw01 X) X)

/-- The codes at distance `s / 16` compared nibble by nibble. -/
@[inline] def dif (N s : ℕ) : ℕ := Nat.xor N (Nat.shiftRight N s)

/-- All distances `1, ..., 8`, in blocks of 144 bits. -/
def blk (N : ℕ) : ℕ :=
  Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor
    (dif N 16)
    (Nat.shiftLeft (dif N 32) 144))
    (Nat.shiftLeft (dif N 48) 288))
    (Nat.shiftLeft (dif N 64) 432))
    (Nat.shiftLeft (dif N 80) 576))
    (Nat.shiftLeft (dif N 96) 720))
    (Nat.shiftLeft (dif N 112) 864))
    (Nat.shiftLeft (dif N 128) 1008)

/-- Bit `p` becomes the OR of bits `p, ..., p + 3`. -/
def zm (G : ℕ) : ℕ :=
  Nat.lor (Nat.lor G (Nat.shiftRight G 1)) (Nat.shiftRight (Nat.lor G (Nat.shiftRight G 1)) 2)

/-- Bit `144 d + 4 m` for the codes `k < l` with `l - k = d + 1` (nibble `m = 4 k + i`). -/
def sigM : ℕ := 0x1111000000000000000000000000000011111111000000000000000000000000111111111111000000000000000000001111111111111111000000000000000011111111111111111111000000000000111111111111111111111111000000001111111111111111111111111111000011111111111111111111111111111111

/-- The equality pattern of a packed family: a set bit means "different". -/
def sigE (N : ℕ) : ℕ := Nat.land (zm (blk N)) sigM

/-- The representative `n` has the pattern of the family `P` reordered by `sel` and swapped by
`sw`. -/
def viaN (P n sel sw : ℕ) : Bool := Nat.beq (sigE (swapAll sw (selX P sel))) (sigE n)

/-- `viaN` for representative `j`, with `j` first evaluated to a numeral, so that the kernel
shares the pattern of a representative between the members of a batch. -/
@[inline] def viaJ (P RN j sel sw : ℕ) : Bool :=
  Nat.casesOn (motive := fun _ => Bool) j (viaN P (repAt RN 0) sel sw)
    (fun j' => viaN P (repAt RN (Nat.succ j')) sel sw)

/-- The partners of `e` listed explicitly: each item gives the index `i` of `f` (`wf` bits), a
representative index (`wj` bits) and a selection index (`wk` bits). -/
def memLoop2 (C1 : Ctx) (PA RN cnt selT wf wj wk : ℕ) : ℕ → ℕ → ℕ → Bool
  | 0, _, m => Nat.beq m 0
  | n + 1, str, m =>
    cond (Nat.beq (Nat.land m (2 ^ (str % 2 ^ wf))) (2 ^ (str % 2 ^ wf)))
      (cond (Nat.blt (str / 2 ^ wf % 2 ^ wj) cnt)
        (cond (viaJ (Nat.lor PA (Nat.shiftLeft (pk (decode C1.s (str % 2 ^ wf))) 128))
            RN (str / 2 ^ wf % 2 ^ wj)
            (Nat.shiftRight selT (str / 2 ^ wf / 2 ^ wj % 2 ^ wk * 38) % 68719476736)
            (Nat.shiftRight selT (str / 2 ^ wf / 2 ^ wj % 2 ^ wk * 38) / 68719476736 % 4))
          (memLoop2 C1 PA RN cnt selT wf wj wk n (str / 2 ^ wf / 2 ^ wj / 2 ^ wk)
            (Nat.xor m (2 ^ (str % 2 ^ wf))))
          false)
        false)
      false

/-- One group: every partner of `e` is accepted. -/
def grpOK2 (C1 : Ctx) (b : Code) (A : List Code) (S : List (ℕ × ℕ)) (RN cnt selT wf wj wk : ℕ)
    (e : Code) (n str : ℕ) : Bool :=
  memLoop2 C1 (packF (A ++ [e])) RN cnt selT wf wj wk n str (fMaskC C1 b A S e)

/-! ## Bits of packed numbers -/

theorem tb_false {N k b : ℕ} (h : N < 2 ^ k) (hb : k ≤ b) : N.testBit b = false :=
  Nat.testBit_eq_false_of_lt (lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num) hb))

/-- Chunks of width `w`: `F 0 ||| F 1 <<< w ||| ... ||| F n <<< (w * n)`. -/
def orW (w : ℕ) (F : ℕ → ℕ) : ℕ → ℕ
  | 0 => F 0
  | n + 1 => orW w F n ||| (F (n + 1) <<< (w * (n + 1)))

theorem orW_lt {w : ℕ} {F : ℕ → ℕ} (hF : ∀ j, F j < 2 ^ w) : ∀ n, orW w F n < 2 ^ (w * (n + 1))
  | 0 => by simpa [orW] using hF 0
  | n + 1 => by
    simp only [orW]
    apply Nat.or_lt_two_pow
    · exact lt_of_lt_of_le (orW_lt hF n) (Nat.pow_le_pow_right (by norm_num) (by nlinarith))
    · rw [Nat.shiftLeft_eq]
      calc F (n + 1) * 2 ^ (w * (n + 1)) < 2 ^ w * 2 ^ (w * (n + 1)) :=
            Nat.mul_lt_mul_of_pos_right (hF _) (Nat.two_pow_pos _)
        _ = 2 ^ (w * (n + 1 + 1)) := by rw [← Nat.pow_add]; congr 1; ring

theorem orW_bit {w : ℕ} {F : ℕ → ℕ} (hF : ∀ j, F j < 2 ^ w) :
    ∀ n k r, r < w → k ≤ n → (orW w F n).testBit (w * k + r) = (F k).testBit r
  | 0, k, r, hr, hk => by
    have : k = 0 := by omega
    subst this; simp [orW]
  | n + 1, k, r, hr, hk => by
    simp only [orW, Nat.testBit_or, Nat.testBit_shiftLeft]
    rcases Nat.lt_or_ge k (n + 1) with hk' | hk'
    · rw [orW_bit hF n k r hr (by omega)]
      have : ¬ (w * (n + 1) ≤ w * k + r) := by
        have : w * k + w ≤ w * (n + 1) := by nlinarith
        omega
      simp [this]
    · have hk1 : k = n + 1 := by omega
      subst hk1
      rw [tb_false (orW_lt hF n) (by omega)]
      simp

/-! ## Packed codes -/

/-- A code whose values fit in four bits. -/
def Small (x : Code) : Prop := x.a < 16 ∧ x.b < 16 ∧ x.c < 16 ∧ x.d < 16

theorem Small.get {x : Code} (h : Small x) (i : Fin 4) : x.get i < 16 := by
  obtain ⟨ha, hb, hc, hd⟩ := h
  match i with
  | ⟨0, _⟩ => exact ha
  | ⟨1, _⟩ => exact hb
  | ⟨2, _⟩ => exact hc
  | ⟨3, _⟩ => exact hd

theorem lt16_bit {v t : ℕ} (hv : v < 16) (ht : 4 ≤ t) : v.testBit t = false :=
  tb_false (k := 4) (by simpa using hv) ht

theorem or_shift_bit {v N s b : ℕ} (hv : v < 2 ^ s) :
    (v ||| (N <<< s)).testBit b = if b < s then v.testBit b else N.testBit (b - s) := by
  rw [Nat.testBit_or, Nat.testBit_shiftLeft]
  split_ifs with h
  · have : ¬ (s ≤ b) := by omega
    simp [this]
  · rw [tb_false hv (by omega)]; simp [show s ≤ b by omega]

theorem or_shift_lt {v N s k : ℕ} (hv : v < 2 ^ s) (hN : N < 2 ^ k) : v ||| (N <<< s) < 2 ^ (s + k) := by
  apply Nat.or_lt_two_pow
  · exact lt_of_lt_of_le hv (Nat.pow_le_pow_right (by norm_num) (by omega))
  · rw [Nat.shiftLeft_eq, Nat.pow_add, Nat.mul_comm (2 ^ s)]
    exact Nat.mul_lt_mul_of_pos_right hN (Nat.two_pow_pos _)

theorem nib_lo {v N t : ℕ} (hv : v < 16) (ht : t < 4) : (v ||| (N <<< 4)).testBit t = v.testBit t := by
  rw [or_shift_bit (by simpa using hv)]; simp [ht]

theorem nib_hi {v N p : ℕ} (hv : v < 16) (hp : 4 ≤ p) : (v ||| (N <<< 4)).testBit p = N.testBit (p - 4) := by
  rw [or_shift_bit (by simpa using hv)]; rw [ite_eq_right (by omega)]

theorem pk_lt {x : Code} (h : Small x) : pk x < 2 ^ 16 := by
  obtain ⟨ha, hb, hc, hd⟩ := h
  simp only [pk, lor_eq, shiftLeft_eq]
  have h4 : ∀ v, v < 16 → v < 2 ^ 4 := fun v hv => by simpa using hv
  exact or_shift_lt (k := 12) (h4 _ ha) (or_shift_lt (k := 8) (h4 _ hb) (or_shift_lt (k := 4) (h4 _ hc) (h4 _ hd)))

theorem pk_bit {x : Code} (h : Small x) (i : Fin 4) {t : ℕ} (ht : t < 4) :
    (pk x).testBit (4 * i.val + t) = (x.get i).testBit t := by
  obtain ⟨ha, hb, hc, hd⟩ := h
  obtain ⟨i, hi⟩ := i
  interval_cases i
  · show (pk x).testBit (4 * 0 + t) = x.a.testBit t
    simp only [pk, lor_eq, shiftLeft_eq]
    rw [nib_lo ha (by omega)]; congr 1; omega
  · show (pk x).testBit (4 * 1 + t) = x.b.testBit t
    simp only [pk, lor_eq, shiftLeft_eq]
    rw [nib_hi ha (by omega), nib_lo hb (by omega)]; congr 1; omega
  · show (pk x).testBit (4 * 2 + t) = x.c.testBit t
    simp only [pk, lor_eq, shiftLeft_eq]
    rw [nib_hi ha (by omega), nib_hi hb (by omega), nib_lo hc (by omega)]; congr 1; omega
  · show (pk x).testBit (4 * 3 + t) = x.d.testBit t
    simp only [pk, lor_eq, shiftLeft_eq]
    rw [nib_hi ha (by omega), nib_hi hb (by omega), nib_hi hc (by omega)]; congr 1; omega

theorem packF_lt : ∀ {L : List Code}, (∀ x ∈ L, Small x) → packF L < 2 ^ (16 * L.length)
  | [], _ => by simp [packF]
  | x :: xs, h => by
    simp only [packF, lor_eq, shiftLeft_eq, List.length_cons]
    apply Nat.or_lt_two_pow
    · exact lt_of_lt_of_le (pk_lt (h x (List.mem_cons_self ..)))
        (Nat.pow_le_pow_right (by norm_num) (by omega))
    · rw [Nat.shiftLeft_eq]
      calc packF xs * 2 ^ 16 < 2 ^ (16 * xs.length) * 2 ^ 16 :=
            Nat.mul_lt_mul_of_pos_right (packF_lt fun y hy => h y (List.mem_cons_of_mem _ hy))
              (Nat.two_pow_pos _)
        _ = 2 ^ (16 * (xs.length + 1)) := by rw [← Nat.pow_add]; congr 1

theorem packF_bit : ∀ {L : List Code}, (∀ x ∈ L, Small x) → ∀ {k : ℕ} (hk : k < L.length)
    (i : Fin 4) {t : ℕ}, t < 4 → (packF L).testBit (16 * k + 4 * i.val + t) = (L[k].get i).testBit t
  | [], _, k, hk, _, _, _ => absurd hk (Nat.not_lt_zero _)
  | x :: xs, h, k, hk, i, t, ht => by
    simp only [packF, lor_eq, shiftLeft_eq, Nat.testBit_or, Nat.testBit_shiftLeft]
    cases k with
    | zero =>
      have hi := i.isLt
      have : ¬ (16 ≤ 16 * 0 + 4 * i.val + t) := by omega
      simp only [this, decide_false, Bool.false_and, Bool.or_false, List.getElem_cons_zero]
      simpa using pk_bit (h x (List.mem_cons_self ..)) i ht
    | succ k =>
      have hi := i.isLt
      rw [tb_false (pk_lt (h x (List.mem_cons_self ..))) (by omega)]
      have e1 : 16 ≤ 16 * (k + 1) + 4 * i.val + t := by omega
      have e2 : 16 * (k + 1) + 4 * i.val + t - 16 = 16 * k + 4 * i.val + t := by omega
      simp only [e1, decide_true, Bool.true_and, Bool.false_or, e2, List.getElem_cons_succ]
      exact packF_bit (fun y hy => h y (List.mem_cons_of_mem _ hy)) (by simpa using hk) i ht

theorem packF_snoc (L : List Code) (x : Code) :
    packF (L ++ [x]) = packF L ||| (pk x <<< (16 * L.length)) := by
  induction L with
  | nil => simp [packF]
  | cons y L ih =>
    simp only [List.cons_append, packF, lor_eq, shiftLeft_eq, ih, List.length_cons]
    apply Nat.eq_of_testBit_eq; intro b
    simp only [Nat.testBit_or, Nat.testBit_shiftLeft]
    by_cases h1 : 16 ≤ b
    · by_cases h2 : 16 * L.length ≤ b - 16
      · have h3 : 16 * (L.length + 1) ≤ b := by omega
        have h4 : b - 16 - 16 * L.length = b - 16 * (L.length + 1) := by omega
        simp [h1, h2, h3, h4, Bool.or_assoc]
      · have h3 : ¬ (16 * (L.length + 1) ≤ b) := by omega
        simp [h1, h2, h3]
    · have h3 : ¬ (16 * (L.length + 1) ≤ b) := by omega
      simp [h1, h3]

/-! ## Reordering, part exchange and patterns -/

theorem fld_lt (P s : ℕ) : fld P s < 2 ^ 16 := by
  simp only [fld, land_eq]
  exact lt_of_le_of_lt Nat.and_le_right (by norm_num)

theorem fld_bit (P s : ℕ) {r : ℕ} (hr : r < 16) :
    (fld P s).testBit r = P.testBit (16 * ((s &&& 15) % 9) + r) := by
  simp only [fld, land_eq, shiftRight_eq, Nat.testBit_and, Nat.testBit_shiftRight]
  rw [show (65535 : ℕ) = 2 ^ 16 - 1 by norm_num, Nat.testBit_two_pow_sub_one]
  simp [hr]

theorem selX_eq (P sel : ℕ) : selX P sel = orW 16 (fun j => fld P (sel >>> (4 * j))) 8 := rfl

theorem selX_lt (P sel : ℕ) : selX P sel < 2 ^ 144 := by
  rw [selX_eq]; exact orW_lt (fun j => fld_lt _ _) 8

theorem selX_bit (P sel : ℕ) {k r : ℕ} (hk : k < 9) (hr : r < 16) :
    (selX P sel).testBit (16 * k + r) = P.testBit (16 * (((sel >>> (4 * k)) &&& 15) % 9) + r) := by
  rw [selX_eq, orW_bit (fun j => fld_lt _ _) 8 k r hr (by omega), fld_bit _ _ hr]

theorem nM0_bit : ∀ b, b < 144 → nM0.testBit b = decide (b % 16 < 4) := by decide +kernel
theorem nM2_bit : ∀ b, b < 144 → nM2.testBit b = decide (8 ≤ b % 16 ∧ b % 16 < 12) := by decide +kernel
theorem nM01_bit : ∀ b, b < 144 → nM01.testBit b = decide (b % 16 < 8) := by decide +kernel
theorem nM23_bit : ∀ b, b < 144 → nM23.testBit b = decide (8 ≤ b % 16) := by decide +kernel

theorem sw01_lt (X : ℕ) : sw01 X < 2 ^ 144 := by
  simp only [sw01, lor_eq, land_eq, shiftLeft_eq, shiftRight_eq]
  have h1 : (X &&& nM0) <<< 4 < 2 ^ 144 := by
    rw [Nat.shiftLeft_eq]
    calc (X &&& nM0) * 2 ^ 4 ≤ nM0 * 2 ^ 4 := Nat.mul_le_mul_right _ Nat.and_le_right
      _ < 2 ^ 144 := by decide +kernel
  have h2 : (X >>> 4) &&& nM0 < 2 ^ 144 := lt_of_le_of_lt Nat.and_le_right (by decide +kernel)
  have h3 : X &&& nM23 < 2 ^ 144 := lt_of_le_of_lt Nat.and_le_right (by decide +kernel)
  exact Nat.or_lt_two_pow (Nat.or_lt_two_pow h1 h2) h3

theorem sw23_lt (X : ℕ) : sw23 X < 2 ^ 144 := by
  simp only [sw23, lor_eq, land_eq, shiftLeft_eq, shiftRight_eq]
  have h1 : (X &&& nM2) <<< 4 < 2 ^ 144 := by
    rw [Nat.shiftLeft_eq]
    calc (X &&& nM2) * 2 ^ 4 ≤ nM2 * 2 ^ 4 := Nat.mul_le_mul_right _ Nat.and_le_right
      _ < 2 ^ 144 := by decide +kernel
  have h2 : (X >>> 4) &&& nM2 < 2 ^ 144 := lt_of_le_of_lt Nat.and_le_right (by decide +kernel)
  have h3 : X &&& nM01 < 2 ^ 144 := lt_of_le_of_lt Nat.and_le_right (by decide +kernel)
  exact Nat.or_lt_two_pow (Nat.or_lt_two_pow h1 h2) h3

theorem sw01_gen (X p : ℕ) : (sw01 X).testBit p =
    (((decide (4 ≤ p) && (X.testBit (p - 4) && nM0.testBit (p - 4))) || (X.testBit (4 + p) && nM0.testBit p)) ||
      (X.testBit p && nM23.testBit p)) := by
  simp only [sw01, lor_eq, land_eq, shiftLeft_eq, shiftRight_eq, Nat.testBit_or, Nat.testBit_and,
    Nat.testBit_shiftLeft, Nat.testBit_shiftRight]

theorem sw23_gen (X p : ℕ) : (sw23 X).testBit p =
    (((decide (4 ≤ p) && (X.testBit (p - 4) && nM2.testBit (p - 4))) || (X.testBit (4 + p) && nM2.testBit p)) ||
      (X.testBit p && nM01.testBit p)) := by
  simp only [sw23, lor_eq, land_eq, shiftLeft_eq, shiftRight_eq, Nat.testBit_or, Nat.testBit_and,
    Nat.testBit_shiftLeft, Nat.testBit_shiftRight]

theorem sw01_table : ∀ k, k < 9 → ∀ i, i < 4 → ∀ t, t < 4 → ∀ a b c : Bool,
    (((decide (4 ≤ 16 * k + 4 * i + t) && (a && nM0.testBit (16 * k + 4 * i + t - 4))) ||
      (b && nM0.testBit (16 * k + 4 * i + t))) || (c && nM23.testBit (16 * k + 4 * i + t))) =
      (if i = 0 then b else if i = 1 then a else c) := by decide +kernel

theorem sw23_table : ∀ k, k < 9 → ∀ i, i < 4 → ∀ t, t < 4 → ∀ a b c : Bool,
    (((decide (4 ≤ 16 * k + 4 * i + t) && (a && nM2.testBit (16 * k + 4 * i + t - 4))) ||
      (b && nM2.testBit (16 * k + 4 * i + t))) || (c && nM01.testBit (16 * k + 4 * i + t))) =
      (if i = 2 then b else if i = 3 then a else c) := by decide +kernel

/-- Bit `16 k + 4 i + t` of `sw01 X` and of `sw23 X`, as a function of the bits of `X`. -/
theorem sw01_bit (X : ℕ) {k i t : ℕ} (hk : k < 9) (hi : i < 4) (ht : t < 4) :
    (sw01 X).testBit (16 * k + 4 * i + t) =
      X.testBit (16 * k + 4 * (if i = 0 then 1 else if i = 1 then 0 else i) + t) := by
  rw [sw01_gen, sw01_table k hk i hi t ht]
  interval_cases i
  · simp only [ite_true]; congr 1; omega
  · simp only [one_ne_zero, ite_false, ite_true]; congr 1; omega
  · simp
  · simp

theorem sw23_bit (X : ℕ) {k i t : ℕ} (hk : k < 9) (hi : i < 4) (ht : t < 4) :
    (sw23 X).testBit (16 * k + 4 * i + t) =
      X.testBit (16 * k + 4 * (if i = 2 then 3 else if i = 3 then 2 else i) + t) := by
  rw [sw23_gen, sw23_table k hk i hi t ht]
  interval_cases i
  · simp
  · simp
  · simp only [ite_true]; congr 1; omega
  · simp only [show (3 : ℕ) ≠ 2 by decide, ite_false, ite_true]; congr 1; omega

theorem swapAll_lt (sw : ℕ) {X : ℕ} (hX : X < 2 ^ 144) : swapAll sw X < 2 ^ 144 := by
  unfold swapAll
  cases Nat.beq (sw / 2 % 2) 1 <;> cases Nat.beq (sw % 2) 1 <;>
    simp only [Bool.cond_true, Bool.cond_false] <;> first | exact hX | exact sw01_lt _ | exact sw23_lt _

theorem beq01 : Nat.beq 0 1 = false := rfl
theorem beq11 : Nat.beq 1 1 = true := rfl

theorem swapAll_bit (sw X : ℕ) {k t : ℕ} (hk : k < 9) (ht : t < 4) (i : Fin 4) :
    (swapAll sw X).testBit (16 * k + 4 * i.val + t) = X.testBit (16 * k + 4 * (swapF sw i).val + t) := by
  obtain ⟨i, hi⟩ := i
  have h1 := Nat.mod_two_eq_zero_or_one sw
  have h2 := Nat.mod_two_eq_zero_or_one (sw / 2)
  unfold swapAll
  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;>
    simp only [h1, h2, beq01, beq11, Bool.cond_true, Bool.cond_false]
  · -- no exchange
    interval_cases i <;> simp [swapF, h1, h2]
  · rw [sw23_bit X hk hi ht]
    interval_cases i <;> simp [swapF, h1, h2]
  · rw [sw01_bit X hk hi ht]
    interval_cases i <;> simp [swapF, h1, h2]
  · have hi' : (if i = 2 then 3 else if i = 3 then 2 else i) < 4 := by split_ifs <;> omega
    rw [sw23_bit _ hk hi ht, sw01_bit X hk hi' ht]
    interval_cases i <;> simp [swapF, h1, h2]

theorem zm_bit (G p : ℕ) :
    (zm G).testBit p = ((G.testBit (p + 0) || G.testBit (p + 1)) || (G.testBit (p + 2) || G.testBit (p + 3))) := by
  simp only [zm, lor_eq, shiftRight_eq, Nat.testBit_or, Nat.testBit_shiftRight]
  rw [Nat.add_zero, Nat.add_comm 1 p, Nat.add_comm 2 p, show 1 + (p + 2) = p + 3 by omega]

theorem dif_lt {N : ℕ} (hN : N < 2 ^ 144) (s : ℕ) : dif N s < 2 ^ 144 := by
  simp only [dif, xor_eq, shiftRight_eq]
  exact Nat.xor_lt_two_pow hN (lt_of_le_of_lt (Nat.shiftRight_le _ _) hN)

theorem blk_eq (N : ℕ) : blk N = orW 144 (fun d => dif N (16 * (d + 1))) 7 := rfl

theorem blk_bit {N : ℕ} (hN : N < 2 ^ 144) {d r : ℕ} (hd : d < 8) (hr : r < 144) :
    (blk N).testBit (144 * d + r) = (N.testBit r ^^ N.testBit (16 * (d + 1) + r)) := by
  rw [blk_eq, orW_bit (fun j => dif_lt hN _) 7 d r hr (by omega)]
  simp only [dif, xor_eq, shiftRight_eq, Nat.testBit_xor, Nat.testBit_shiftRight]

theorem sigM_bit : ∀ d, d < 8 → ∀ m, m < 32 → m < 4 * (8 - d) →
    sigM.testBit (144 * d + 4 * m) = true := by decide +kernel

theorem xor_false_iff (a b : Bool) : (a ^^ b) = false ↔ a = b := by
  cases a <;> cases b <;> decide

theorem four_xor {f g : ℕ → Bool} :
    ((f 0 ^^ g 0 || f 1 ^^ g 1) || (f 2 ^^ g 2 || f 3 ^^ g 3)) = false ↔ ∀ t, t < 4 → f t = g t := by
  simp only [Bool.or_eq_false_iff, xor_false_iff]
  constructor
  · rintro ⟨⟨h0, h1⟩, h2, h3⟩ t ht
    interval_cases t <;> assumption
  · intro h
    exact ⟨⟨h 0 (by omega), h 1 (by omega)⟩, h 2 (by omega), h 3 (by omega)⟩

theorem sigE_iff {N : ℕ} (hN : N < 2 ^ 144) {d m : ℕ} (hd : d < 8) (hm : m < 4 * (8 - d)) :
    (sigE N).testBit (144 * d + 4 * m) = false ↔
      ∀ t, t < 4 → N.testBit (4 * m + t) = N.testBit (16 * (d + 1) + (4 * m + t)) := by
  have hb : ∀ t, t < 4 → (blk N).testBit (144 * d + 4 * m + t) =
      (N.testBit (4 * m + t) ^^ N.testBit (16 * (d + 1) + (4 * m + t))) := fun t ht => by
    rw [show 144 * d + 4 * m + t = 144 * d + (4 * m + t) by omega]
    exact blk_bit hN hd (by omega)
  simp only [sigE, land_eq, Nat.testBit_and, sigM_bit d hd m (by omega) hm, Bool.and_true, zm_bit]
  rw [hb 0 (by omega), hb 1 (by omega), hb 2 (by omega), hb 3 (by omega)]
  exact four_xor (f := fun t => N.testBit (4 * m + t)) (g := fun t => N.testBit (16 * (d + 1) + (4 * m + t)))

/-! ## Representatives -/

theorem famN_length : ∀ K n, (famN K n).length = K
  | 0, _ => rfl
  | K + 1, n => by simp [famN, famN_length K]

theorem div_mod16_bit (n a : ℕ) {t : ℕ} (ht : t < 4) : (n / 2 ^ a % 2 ^ 4).testBit t = n.testBit (a + t) := by
  rw [Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
  simp [ht, Nat.add_comm]

theorem famN_bit : ∀ (K n k : ℕ) (hk : k < (famN K n).length) (i : Fin 4) {t : ℕ}, t < 4 →
    (((famN K n)[k]).get i).testBit t = n.testBit (16 * k + 4 * i.val + t)
  | 0, n, k, hk, _, _, _ => absurd hk (by simp [famN])
  | K + 1, n, k, hk, i, t, ht => by
    cases k with
    | zero =>
      obtain ⟨i, hi⟩ := i
      interval_cases i
      · show (n % 2 ^ 4).testBit t = _
        rw [show n % 2 ^ 4 = n / 2 ^ 0 % 2 ^ 4 by simp, div_mod16_bit n 0 ht]
        all_goals congr 1
      · show (n / 2 ^ 4 % 2 ^ 4).testBit t = _
        rw [div_mod16_bit n 4 ht]
        all_goals congr 1
      · show (n / 2 ^ 8 % 2 ^ 4).testBit t = _
        rw [div_mod16_bit n 8 ht]
        all_goals congr 1
      · show (n / 2 ^ 12 % 2 ^ 4).testBit t = _
        rw [div_mod16_bit n 12 ht]
        all_goals congr 1
    | succ k =>
      have hk' : k < (famN K (n / 65536)).length := by simp [famN_length] at hk ⊢; omega
      show (((famN K (n / 2 ^ 16))[k]).get i).testBit t = _
      rw [famN_bit K (n / 2 ^ 16) k hk' i ht, Nat.testBit_div_two_pow]
      congr 1; omega

theorem famN_small : ∀ K n, ∀ x ∈ famN K n, Small x
  | 0, _, x, hx => by simp [famN] at hx
  | K + 1, n, x, hx => by
    simp only [famN, List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact ⟨Nat.mod_lt _ (by norm_num), Nat.mod_lt _ (by norm_num), Nat.mod_lt _ (by norm_num),
        Nat.mod_lt _ (by norm_num)⟩
    · exact famN_small K _ x hx

theorem bits4_eq {v w : ℕ} (hv : v < 16) (hw : w < 16) :
    (∀ t, t < 4 → v.testBit t = w.testBit t) ↔ v = w := by
  constructor
  · intro h
    apply Nat.eq_of_testBit_eq; intro t
    by_cases ht : t < 4
    · exact h t ht
    · rw [lt16_bit hv (by omega), lt16_bit hw (by omega)]
  · rintro rfl t _; rfl

/-! ## The packed transport -/

theorem viaN_cover {src : List Code} (hlen : src.length = 9) (hsm : ∀ x ∈ src, Small x)
    {n sel sw : ℕ} (hn : n < 2 ^ 144) (h : viaN (packF src) n sel sw = true)
    (hR : RepCover (famN 9 n)) : RepCover src := by
  intro K hK hsrc
  have hRlen : (famN 9 n).length = 9 := famN_length 9 n
  have hs : ∀ k, ((sel >>> (4 * k)) &&& 15) % 9 < src.length := fun k => by
    rw [hlen]; exact Nat.mod_lt _ (by norm_num)
  have hsig : sigE (swapAll sw (selX (packF src) sel)) = sigE n := by
    simpa [viaN] using h
  have hX : swapAll sw (selX (packF src) sel) < 2 ^ 144 := swapAll_lt sw (selX_lt _ _)
  have hXbit : ∀ k (hk : k < 9) (i : Fin 4) t, t < 4 →
      (swapAll sw (selX (packF src) sel)).testBit (16 * k + 4 * i.val + t) =
        ((src[((sel >>> (4 * k)) &&& 15) % 9]'(hs k)).get (swapF sw i)).testBit t := by
    intro k hk i t ht
    have hsw := (swapF sw i).isLt
    rw [swapAll_bit sw _ hk ht i,
      show 16 * k + 4 * (swapF sw i).val + t = 16 * k + (4 * (swapF sw i).val + t) by omega,
      selX_bit _ _ hk (by omega),
      show 16 * (((sel >>> (4 * k)) &&& 15) % 9) + (4 * (swapF sw i).val + t) =
        16 * (((sel >>> (4 * k)) &&& 15) % 9) + 4 * (swapF sw i).val + t by omega]
    exact packF_bit hsm (hs k) (swapF sw i) ht
  have hnbit : ∀ k (hk : k < 9) (i : Fin 4) t, t < 4 →
      n.testBit (16 * k + 4 * i.val + t) = (((famN 9 n)[k]'(by rw [hRlen]; exact hk)).get i).testBit t :=
    fun k hk i t ht => (famN_bit 9 n k _ i ht).symm
  -- pairs `k < l`
  have key : ∀ k l (hk : k < 9) (hl : l < 9), k < l → ∀ i : Fin 4,
      ((src[((sel >>> (4 * k)) &&& 15) % 9]'(hs k)).get (swapF sw i) =
          (src[((sel >>> (4 * l)) &&& 15) % 9]'(hs l)).get (swapF sw i) ↔
        ((famN 9 n)[k]'(by rw [hRlen]; exact hk)).get i = ((famN 9 n)[l]'(by rw [hRlen]; exact hl)).get i) := by
    intro k l hk hl hkl i
    have hi := i.isLt
    have hd : l - k - 1 < 8 := by omega
    have hm : 4 * k + i.val < 4 * (8 - (l - k - 1)) := by omega
    have e1 := sigE_iff hX hd hm
    have e2 := sigE_iff hn hd hm
    rw [hsig] at e1
    have pos1 : ∀ t, 4 * (4 * k + i.val) + t = 16 * k + 4 * i.val + t := fun t => by omega
    have pos2 : ∀ t, 16 * (l - k - 1 + 1) + (16 * k + 4 * i.val + t) = 16 * l + 4 * i.val + t :=
      fun t => by omega
    simp only [pos1] at e1 e2
    simp only [pos2] at e1 e2
    have c1 : (∀ t, t < 4 → (swapAll sw (selX (packF src) sel)).testBit (16 * k + 4 * i.val + t) =
        (swapAll sw (selX (packF src) sel)).testBit (16 * l + 4 * i.val + t)) ↔
        (src[((sel >>> (4 * k)) &&& 15) % 9]'(hs k)).get (swapF sw i) =
          (src[((sel >>> (4 * l)) &&& 15) % 9]'(hs l)).get (swapF sw i) := by
      rw [← bits4_eq ((hsm _ (List.getElem_mem _)).get _) ((hsm _ (List.getElem_mem _)).get _)]
      constructor
      · intro h t ht; rw [← hXbit k hk i t ht, ← hXbit l hl i t ht]; exact h t ht
      · intro h t ht; rw [hXbit k hk i t ht, hXbit l hl i t ht]; exact h t ht
    have c2 : (∀ t, t < 4 → n.testBit (16 * k + 4 * i.val + t) = n.testBit (16 * l + 4 * i.val + t)) ↔
        ((famN 9 n)[k]'(by rw [hRlen]; exact hk)).get i = ((famN 9 n)[l]'(by rw [hRlen]; exact hl)).get i := by
      rw [← bits4_eq ((famN_small 9 n _ (List.getElem_mem _)).get _)
        ((famN_small 9 n _ (List.getElem_mem _)).get _)]
      constructor
      · intro h t ht; rw [← hnbit k hk i t ht, ← hnbit l hl i t ht]; exact h t ht
      · intro h t ht; rw [hnbit k hk i t ht, hnbit l hl i t ht]; exact h t ht
    rw [← c1, ← c2, ← e1, ← e2]
  apply Theory.cover_of_list_anchor_pattern src Code.toEdge (famN 9 n) Code.toEdge
    (fun k => ⟨((sel >>> (4 * k.val)) &&& 15) % 9, hs k.val⟩) (swapP sw) ?_ (bound (famN 9 n)) ?_ hsrc hK hR
  · intro i k l
    have hk : k.val < 9 := lt_of_lt_of_eq k.isLt hRlen
    have hl : l.val < 9 := lt_of_lt_of_eq l.isLt hRlen
    simp only [Code.toEdge, List.get_eq_getElem, swapP, Equiv.coe_fn_mk]
    rcases Nat.lt_trichotomy k.val l.val with hkl | hkl | hkl
    · exact key k.val l.val hk hl hkl i
    · have : k = l := Fin.ext hkl
      subst this; simp
    · rw [eq_comm, @eq_comm _ (((famN 9 n)[k.val]).get i)]
      exact key l.val k.val hl hk hkl i
  · intro x hx i
    exact lt_bound hx i

/-! ## Groups and rows -/

theorem viaJ_eq (P RN j sel sw : ℕ) : viaJ P RN j sel sw = viaN P (repAt RN j) sel sw := by
  cases j <;> rfl

theorem memLoop2_spec {C1 : Ctx} {PA RN cnt selT wf wj wk : ℕ} :
    ∀ (n str m : ℕ), memLoop2 C1 PA RN cnt selT wf wj wk n str m = true →
      ∀ i, m.testBit i = true → ∃ j, j < cnt ∧ ∃ sel sw,
        viaN (Nat.lor PA (Nat.shiftLeft (pk (decode C1.s i)) 128)) (repAt RN j) sel sw = true
  | 0, _, m, h, i, hi => by
    simp only [memLoop2, Nat.beq_eq] at h; subst h; simp at hi
  | n + 1, str, m, h, i, hi => by
    simp only [memLoop2] at h
    generalize hx : str % 2 ^ wf = x at h
    generalize hj : str / 2 ^ wf % 2 ^ wj = j at h
    cases hb : Nat.beq (Nat.land m (2 ^ x)) (2 ^ x)
    · rw [hb, Bool.cond_false] at h; exact absurd h (by decide)
    · rw [hb, Bool.cond_true] at h
      cases hlt : Nat.blt j cnt
      · rw [hlt, Bool.cond_false] at h; exact absurd h (by decide)
      · rw [hlt, Bool.cond_true] at h
        cases hv : viaJ (Nat.lor PA (Nat.shiftLeft (pk (decode C1.s x)) 128)) RN j
            (Nat.shiftRight selT (str / 2 ^ wf / 2 ^ wj % 2 ^ wk * 38) % 68719476736)
            (Nat.shiftRight selT (str / 2 ^ wf / 2 ^ wj % 2 ^ wk * 38) / 68719476736 % 4)
        · rw [hv, Bool.cond_false] at h; exact absurd h (by decide)
        · rw [hv, Bool.cond_true] at h
          by_cases hix : i = x
          · subst hix
            exact ⟨j, by simpa [Nat.blt_eq] using hlt, _, _, by rw [← viaJ_eq]; exact hv⟩
          · refine memLoop2_spec n _ _ h i ?_
            rw [xor_eq, Nat.testBit_xor, Nat.testBit_two_pow, hi]
            simp [Ne.symm hix]

/-- All representatives of a packed list are covered. -/
def RepsOK (RN cnt : ℕ) : Prop := ∀ j, j < cnt → RepCover (famN 9 (repAt RN j))

theorem repsOK_zero (RN : ℕ) : RepsOK RN 0 := fun _ hj => absurd hj (Nat.not_lt_zero _)

theorem repsOK_succ {RN cnt : ℕ} (h : RepsOK RN cnt) (hj : RepCover (famN 9 (repAt RN cnt))) :
    RepsOK RN (cnt + 1) := by
  intro j hj'
  rcases Nat.lt_succ_iff_lt_or_eq.mp hj' with h' | h'
  · exact h j h'
  · subst h'; exact hj

theorem repAt_lt (RN j : ℕ) : repAt RN j < 2 ^ 144 := Nat.mod_lt _ (Nat.two_pow_pos _)

theorem small_of_le {x : Code} {b : Code} (hb : b.a < 16 ∧ b.b < 16 ∧ b.c < 16 ∧ b.d < 16)
    (hx : InBox b x) : Small x := by
  obtain ⟨h1, h2, h3, h4⟩ := hb
  obtain ⟨x1, x2, x3, x4⟩ := hx
  exact ⟨by omega, by omega, by omega, by omega⟩

theorem row_light2 (b : Code) (A : List Code) (p q : Fin 4 × ℕ) (tb0 tb1 : ℕ)
    (htb0 : tb0 = refTable b) (htb1 : tb1 = refTable (bumped b)) (RN cnt : ℕ) (hreps : RepsOK RN cnt)
    (selT wf wj wk : ℕ) (groups : List (ℕ × ℕ × ℕ))
    (hA : A.all (known b) = true) (hp : vertexOK b p = true) (hq : vertexOK b q = true)
    (hsz : (Nat.blt b.a 15 && Nat.blt b.b 15 && Nat.blt b.c 15 && Nat.blt b.d 15 &&
      Nat.beq A.length 7) = true)
    (hkeys : keysL (mkCtx b tb0 A) (natS p q) (groups.map Prod.fst) = true)
    (hg : ∀ g ∈ groups, grpOK2 (mkCtx (bumped b) tb1 A) b A (natS p q) RN cnt selT wf wj wk
      (decode b g.1) g.2.1 g.2.2 = true)
    (H : Finset NatEdge) (hm : MatchingAtMost H 2) (hAH : ∀ a ∈ A, a.toEdge ∈ H) :
    CoverAtMost H 5 := by
  have hAk : ∀ a ∈ A, known b a = true := fun a ha => List.all_eq_true.mp hA a ha
  simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at hsz
  obtain ⟨⟨⟨⟨hba, hbb⟩, hbc⟩, hbd⟩, hlenA⟩ := hsz
  apply row_abstract b A p q hA hp hq ?_ H hm hAH
  intro e f eIn fIn eBit fBit
  have hCb : (mkCtx b tb0 A).Valid := ⟨rfl, rfl, htb0⟩
  have hC1 : (mkCtx (bumped b) tb1 A).Valid := ⟨rfl, rfl, htb1⟩
  have eBitC : (eMaskC (mkCtx b tb0 A) (natS p q)).testBit (idx b e) = true := by
    have e0 := eMaskC_spec hCb rfl hAk hp hq eIn
    simp only [mkCtx_s] at e0
    rw [e0]; exact eBit
  have hfull0 : (mkCtx b tb0 A).full.testBit (idx b e) = true := by
    rw [hCb.full_eq, hCb.w_eq, Nat.testBit_two_pow_sub_one, mkCtx_s]
    exact decide_eq_true (idx_lt eIn)
  have hlisted := orIdx_spec (mask_cover hkeys eBitC hfull0)
  obtain ⟨g, hgm, hge⟩ := List.mem_map.mp hlisted
  have hgOK := hg g hgm
  rw [hge, decode_idx eIn] at hgOK
  simp only [grpOK2] at hgOK
  have hAk1 : ∀ a ∈ A, known (bumped b) a = true := fun a ha => known_bumped (hAk a ha)
  have fBitC : (fMaskC (mkCtx (bumped b) tb1 A) b A (natS p q) e).testBit (idx (bumped b) f) = true := by
    have e1 := fMaskC_spec hC1 rfl rfl hAk1 (known_vertexOK_bumped hp) (known_vertexOK_bumped hq) eIn fIn
    simp only [mkCtx_s] at e1
    rw [e1]; exact fBit
  obtain ⟨j, hj, sel, sw, hv⟩ := memLoop2_spec _ _ _ hgOK _ fBitC
  have hdec : decode (mkCtx (bumped b) tb1 A).s (idx (bumped b) f) = f := decode_idx fIn
  rw [hdec] at hv
  have hP : Nat.lor (packF (A ++ [e])) (Nat.shiftLeft (pk f) 128) = packF (A ++ [e, f]) := by
    have := packF_snoc (A ++ [e]) f
    rw [List.append_assoc, List.singleton_append, List.length_append, hlenA] at this
    rw [this]; rfl
  rw [hP] at hv
  have hb16 : (bumped b).a < 16 ∧ (bumped b).b < 16 ∧ (bumped b).c < 16 ∧ (bumped b).d < 16 := by
    simp only [bumped]; omega
  have hsm : ∀ x ∈ A ++ [e, f], Small x := by
    intro x hx
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with hx | rfl | rfl
    · exact small_of_le hb16 (known_inBox (hAk1 x hx))
    · obtain ⟨e1, e2, e3, e4⟩ := eIn
      exact ⟨by omega, by omega, by omega, by omega⟩
    · exact small_of_le hb16 fIn
  exact viaN_cover (by simp [hlenA]) hsm (repAt_lt RN j) hv (hreps j hj)

/-! ## All frozen rows -/

/-- The frozen rows below `n` are covered. -/
def RowsBelow (n : ℕ) : Prop :=
  ∀ t : Fin 232, t.val < n → ∀ H : Finset NatEdge, MatchingAtMost H 2 →
    (∀ k, Theory.frozenTemplate t k ∈ H) → CoverAtMost H 5

theorem rowsBelow_zero : RowsBelow 0 := fun _ ht => absurd ht (Nat.not_lt_zero _)

theorem rowsBelow_succ {n : ℕ} (h : RowsBelow n)
    (hn : ∀ hlt : n < 232, ∀ H : Finset NatEdge, MatchingAtMost H 2 →
      (∀ k, Theory.frozenTemplate ⟨n, hlt⟩ k ∈ H) → CoverAtMost H 5) : RowsBelow (n + 1) := by
  intro t ht H hm hF
  rcases Nat.lt_succ_iff_lt_or_eq.mp ht with h' | h'
  · exact h t h' H hm hF
  · obtain ⟨t, htl⟩ := t
    simp only at h'
    subst h'
    exact hn htl H hm hF

end Ryser.Light

/-!
# Residual clauses checked on their set bits only

`resOK` scans every trace of the box; `resOK2` visits only the set bits of the residual mask
(lowest bit first, located by `bitPos` and checked), which is much cheaper for the kernel.
-/


namespace Ryser.Light
open Ryser Ryser.Fast FiniteBox

/-- The partner condition of `resOK` at every set bit of `m`. -/
def resLoop (C : Ctx) (F : List Code) (Rm : ℕ) : ℕ → ℕ → Bool
  | 0, m => Nat.beq m 0
  | n + 1, m =>
    cond (Nat.beq m 0) true
      (cond (Nat.beq (Nat.land m (2 ^ bitPos (Nat.land m (Nat.xor m (m - 1)))))
          (2 ^ bitPos (Nat.land m (Nat.xor m (m - 1)))))
        (cond (Nat.beq (Nat.land (partnerC C F (decode C.s (bitPos (Nat.land m (Nat.xor m (m - 1)))))) Rm) 0)
          (resLoop C F Rm n (Nat.xor m (2 ^ bitPos (Nat.land m (Nat.xor m (m - 1))))))
          false)
        false)

theorem resLoop_spec {C : Ctx} {F : List Code} {Rm : ℕ} :
    ∀ (n m : ℕ), resLoop C F Rm n m = true → ∀ i, m.testBit i = true →
      Nat.beq (Nat.land (partnerC C F (decode C.s i)) Rm) 0 = true
  | 0, m, h, i, hi => by
    simp only [resLoop, Nat.beq_eq] at h; subst h; simp at hi
  | n + 1, m, h, i, hi => by
    simp only [resLoop] at h
    cases hm : Nat.beq m 0
    · rw [hm, Bool.cond_false] at h
      generalize hx : bitPos (Nat.land m (Nat.xor m (m - 1))) = x at h
      cases hb : Nat.beq (Nat.land m (2 ^ x)) (2 ^ x)
      · rw [hb, Bool.cond_false] at h; exact absurd h (by decide)
      · rw [hb, Bool.cond_true] at h
        cases hp : Nat.beq (Nat.land (partnerC C F (decode C.s x)) Rm) 0
        · rw [hp, Bool.cond_false] at h; exact absurd h (by decide)
        · rw [hp, Bool.cond_true] at h
          by_cases hix : i = x
          · subst hix; exact hp
          · refine resLoop_spec n _ h i ?_
            rw [xor_eq, Nat.testBit_xor, Nat.testBit_two_pow, hi]
            simp [Ne.symm hix]
    · rw [Nat.beq_eq] at hm; subst hm; simp at hi

/-- `resOK`, visiting only the set bits of the residual mask. -/
def resOK2 (C : Ctx) (F : List Code) (S : List (ℕ × ℕ)) (W : ℕ) : Bool :=
  sOK C.s S && resLoop C F (Nat.land (Nat.land C.adm (Nat.xor C.full (hitS C S))) (Nat.xor C.full W)) C.w
    (Nat.land (Nat.land C.adm (Nat.xor C.full (hitS C S))) (Nat.xor C.full W))

theorem allBelow_of {f : ℕ → Bool} : ∀ {n : ℕ}, (∀ i, i < n → f i = true) → allBelow f n = true
  | 0, _ => rfl
  | n + 1, h => by
    simp only [allBelow, Bool.and_eq_true]
    exact ⟨h n (Nat.lt_succ_self n), allBelow_of fun i hi => h i (Nat.lt_succ_of_lt hi)⟩

theorem resOK_of_resOK2 {C : Ctx} {F : List Code} {S : List (ℕ × ℕ)} {W : ℕ}
    (h : resOK2 C F S W = true) : resOK C F S W = true := by
  simp only [resOK2, Bool.and_eq_true] at h
  obtain ⟨hs, hl⟩ := h
  simp only [resOK, hs, Bool.true_and]
  apply allBelow_of
  intro i _
  cases ht : tb (Nat.land (Nat.land C.adm (Nat.xor C.full (hitS C S))) (Nat.xor C.full W)) i
  · rfl
  · rw [tb_eq] at ht
    simp only [Bool.not_true, Bool.false_or]
    exact resLoop_spec _ _ hl i ht

/-- `lcheck2` with `resOK2`. -/
def lcheck3 (s : Code) (tbl : ℕ) (F : List Code) (Rs : List (List (ℕ × ℕ) × ℕ)) (w fuel str : ℕ) :
    Bool :=
  F.all (known s) && Rs.all (fun r => resOK2 (mkCtx s tbl F) F r.1 r.2) &&
    (run (mkCtx s tbl F) (Rs.map Prod.snd) w fuel (initSt (mkCtx s tbl F) F) str).isSome

theorem lcheck2_of_lcheck3 {s : Code} {tbl : ℕ} {F : List Code} {Rs : List (List (ℕ × ℕ) × ℕ)}
    {w fuel str : ℕ} (h : lcheck3 s tbl F Rs w fuel str = true) : lcheck2 s tbl F Rs w fuel str = true := by
  simp only [lcheck3, lcheck2, Bool.and_eq_true, List.all_eq_true] at h ⊢
  exact ⟨⟨h.1.1, fun r hr => resOK_of_resOK2 (h.1.2 r hr)⟩, h.2⟩

/-- A representative family `famN 9 n` with its light certificate. -/
def repC3 (n : ℕ) (Rs : List (List (ℕ × ℕ) × ℕ)) (w str : ℕ) : Bool :=
  lcheck3 (boxOf (famN 9 n)) (fastTable (boxOf (famN 9 n))) (famN 9 n) Rs w 100000 str

theorem repC3_cover {n : ℕ} {Rs : List (List (ℕ × ℕ) × ℕ)} {w str : ℕ} (h : repC3 n Rs w str = true) :
    RepCover (famN 9 n) :=
  lcheck2_cover (fastTable_eq _) (lcheck2_of_lcheck3 h)

/-- A row family `A` (seven anchors) with its light certificate. -/
def rowC3 (A : List Code) (Rs : List (List (ℕ × ℕ) × ℕ)) (w str : ℕ) : Bool :=
  lcheck3 (boxOf A) (fastTable (boxOf A)) A Rs w 100000 str

theorem rowC3_cover {A : List Code} {Rs : List (List (ℕ × ℕ) × ℕ)} {w str : ℕ} (h : rowC3 A Rs w str = true) :
    RepCover A :=
  lcheck2_cover (fastTable_eq _) (lcheck2_of_lcheck3 h)

end Ryser.Light

